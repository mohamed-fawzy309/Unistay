@model BulkPenaltyViewModel
@{
    ViewData["Title"] = "جزاء جماعي";
}

<h2 class="page-title mb-4"><i class="bi bi-exclamation-triangle"></i> جزاء جماعي</h2>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">@TempData["Success"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">@TempData["Error"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
}

<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

<form asp-action="BulkPenalty" method="post" class="filter-bar p-4">
    <div class="row g-3">
        <div class="col-md-6">
            <label class="form-label">اختيار الطلاب <span class="text-danger">*</span></label>
            <input type="text" id="studentSearch" class="form-control mb-2" placeholder="ابحث بالاسم أو الرقم القومي..." autocomplete="off" />
            <div id="studentResults" class="mb-2 small" style="max-height:150px;overflow-y:auto"></div>
            <div id="selectedStudents" class="d-flex flex-wrap gap-1 mb-2"></div>
            <span asp-validation-for="StudentIDs" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="DormitoryCityID" class="form-label">المدينة الجامعية <span class="text-danger">*</span></label>
            <select asp-for="DormitoryCityID" class="form-select" asp-items="ViewBag.Cities">
                <option value="">-- اختر المدينة --</option>
            </select>
            <span asp-validation-for="DormitoryCityID" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="ViolationType" class="form-label">نوع المخالفة <span class="text-danger">*</span></label>
            <select asp-for="ViolationType" class="form-select" id="violationType">
                <option value="">-- اختر النوع --</option>
            </select>
            <span asp-validation-for="ViolationType" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label class="form-label">درجة الخطورة <span class="text-danger">*</span></label>
            <div class="d-flex gap-3 mt-2">
                <div class="form-check">
                    <input class="form-check-input" type="radio" asp-for="Severity" value="Low" id="sevLow">
                    <label class="form-check-label text-info" for="sevLow">منخفضة</label>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="radio" asp-for="Severity" value="Medium" id="sevMedium" checked>
                    <label class="form-check-label text-warning" for="sevMedium">متوسطة</label>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="radio" asp-for="Severity" value="High" id="sevHigh">
                    <label class="form-check-label text-danger" for="sevHigh">عالية</label>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="radio" asp-for="Severity" value="Critical" id="sevCritical">
                    <label class="form-check-label text-dark" for="sevCritical">حرجة</label>
                </div>
            </div>
            <span asp-validation-for="Severity" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="FineAmount" class="form-label">قيمة الغرامة (اختياري)</label>
            <div class="input-group">
                <input asp-for="FineAmount" class="form-control" type="number" step="0.01" min="0" />
                <span class="input-group-text">جنيه</span>
            </div>
            <span asp-validation-for="FineAmount" class="text-danger"></span>
        </div>
        <div class="col-12">
            <label asp-for="Description" class="form-label">وصف المخالفة</label>
            <textarea asp-for="Description" class="form-control" rows="3"></textarea>
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>
    </div>

    <div class="mt-4">
        <button type="submit" class="btn btn-primary btn-lg">
            <i class="bi bi-save"></i> تسجيل المخالفات
        </button>
        <a asp-controller="Violation" asp-action="Report" class="btn btn-secondary">تقرير المخالفات</a>
    </div>
</form>

@section Scripts {
    <script>
        var selected = {};

        function addStudent(id, name) {
            if (selected[id]) return;
            selected[id] = name;
            renderSelected();
            updateHidden();
        }

        function removeStudent(id) {
            delete selected[id];
            renderSelected();
            updateHidden();
        }

        function renderSelected() {
            var container = document.getElementById('selectedStudents');
            container.innerHTML = '';
            Object.keys(selected).forEach(function (id) {
                var span = document.createElement('span');
                span.className = 'badge bg-danger fs-6 p-2 d-inline-flex align-items-center gap-1';
                span.textContent = selected[id];
                var btn = document.createElement('button');
                btn.type = 'button';
                btn.className = 'btn-close btn-close-white';
                btn.style.fontSize = '10px';
                btn.onclick = function () { removeStudent(id); };
                span.appendChild(btn);
                container.appendChild(span);
            });
        }

        function updateHidden() {
            var existing = document.querySelectorAll('input[name="StudentIDs"]');
            existing.forEach(function (e) { e.remove(); });
            var form = document.querySelector('form');
            Object.keys(selected).forEach(function (id) {
                var input = document.createElement('input');
                input.type = 'hidden';
                input.name = 'StudentIDs';
                input.value = id;
                form.appendChild(input);
            });
        }

        document.addEventListener('DOMContentLoaded', function () {
            var searchTimeout;
            var searchInput = document.getElementById('studentSearch');
            var resultsDiv = document.getElementById('studentResults');

            fetch('@Url.Action("GetViolationTypes", "Discipline")')
                .then(function (r) { return r.json(); })
                .then(function (data) {
                    var sel = document.getElementById('violationType');
                    data.forEach(function (t) {
                        var opt = document.createElement('option');
                        opt.value = t.value;
                        opt.textContent = t.text;
                        sel.appendChild(opt);
                    });
                });

            searchInput.addEventListener('input', function () {
                clearTimeout(searchTimeout);
                var val = this.value.trim();
                if (val.length < 2) { resultsDiv.innerHTML = ''; return; }
                searchTimeout = setTimeout(async function () {
                    try {
                        var res = await fetch('@Url.Action("GetStudents", "Discipline")?term=' + encodeURIComponent(val));
                        var data = await res.json();
                        if (data.length > 0) {
                            resultsDiv.innerHTML = data.map(function (s) {
                                var already = selected[s.id] ? ' (مضاف)' : '';
                                var btn = selected[s.id]
                                    ? '<span class="text-muted">مضاف ✓</span>'
                                    : '<button type="button" class="btn btn-sm btn-outline-danger" onclick="addStudent(' + s.id + ',\'' + s.fullName.replace(/'/g, "\\'") + ' - ' + s.nationalID + '\')">إضافة</button>';
                                return '<div class="d-flex justify-content-between align-items-center p-1 border-bottom">' +
                                    '<span>' + s.fullName + ' - ' + s.nationalID + already + '</span>' + btn +
                                    '</div>';
                            }).join('');
                        } else {
                            resultsDiv.innerHTML = '<span class="text-muted">لا توجد نتائج</span>';
                        }
                    } catch { resultsDiv.innerHTML = '<span class="text-danger">خطأ في البحث</span>'; }
                }, 300);
            });
        });
    </script>
}
