@model ManualAllocationViewModel
@{
    ViewData["Title"] = "تسكين يدوي";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-person-plus-fill"></i> تسكين يدوي</h2>
        <a asp-action="Index" class="btn btn-secondary"><i class="bi bi-arrow-right"></i> العودة</a>
    </div>

    <div class="card">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">بيانات التسكين</h5>
        </div>
        <div class="card-body">
            <form asp-action="ManualAllocation" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

               <div class="col-md-6">

    <label class="form-label">بحث الطالب</label>

    <input type="text"
           id="studentSearch"
           class="form-control mb-2"
           placeholder="بحث بالاسم أو الرقم القومي..." />

    <select asp-for="StudentID"
            id="studentSelect"
            class="form-select"
            required>

        <option value="">-- اختر الطالب --</option>

        @foreach (var s in (IEnumerable<UniStay.ViewModels.Allocation.StudentLookupViewModel>)ViewBag.Students)
        {
            <option value="@s.ID">
                @s.FullName - @s.NationalID
            </option>
        }

    </select>
                    <input type="hidden" asp-for="ApplicationID" id="applicationIdField" />
                    <div id="appWarning" class="text-danger small mt-1" style="display:none;"></div>

    <span asp-validation-for="StudentID" class="text-danger"></span>

</div>

                <div class="row mb-3">
                    <div class="col-md-3">
                        <label class="form-label">المدينة</label>
                        <select id="citySelect" class="form-select" onchange="loadBuildings(this.value)">
                            <option value="">-- اختر المدينة --</option>
                            @foreach (var c in (IEnumerable<UniStay.ViewModels.Allocation.CityLookupViewModel>)ViewBag.Cities)
                            {
                                <option value="@c.ID">@c.Name</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">المبنى</label>
                        <select id="buildingSelect" class="form-select" onchange="loadRooms(this.value)" disabled>
                            <option value="">-- اختر المدينة أولاً --</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">الغرفة</label>
                        <select asp-for="CityRoomID" id="roomSelect" class="form-select" disabled>
                            <option value="">-- اختر المبنى أولاً --</option>
                        </select>
                        <span asp-validation-for="CityRoomID" class="text-danger"></span>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">رقم السرير</label>
                        <input asp-for="BedNumber" class="form-control" type="number" min="1" max="8" />
                        <span asp-validation-for="BedNumber" class="text-danger"></span>
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-3">
                        <label class="form-label">العام الدراسي</label>
                        <input asp-for="AcademicYear" class="form-control" placeholder="مثال: 2025-2026" />
                        <span asp-validation-for="AcademicYear" class="text-danger"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label">ملاحظات</label>
                    <textarea asp-for="Notes" class="form-control" rows="2"></textarea>
                </div>

                <button type="submit" class="btn btn-primary"><i class="bi bi-check-circle"></i> تسكين</button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function loadBuildings(cityId) {
            const buildingSelect = document.getElementById('buildingSelect');
            const roomSelect = document.getElementById('roomSelect');

            buildingSelect.innerHTML = '<option value="">-- اختر المبنى --</option>';
            roomSelect.innerHTML = '<option value="">-- اختر المبنى أولاً --</option>';
            roomSelect.disabled = true;
            buildingSelect.disabled = true;

            if (!cityId) return;

            fetch('@Url.Action("GetBuildingsByCity", "Allocation")?cityId=' + cityId)
                .then(res => res.json())
                .then(data => {
                    data.forEach(function (b) {
                        const opt = document.createElement('option');
                        opt.value = b.id;
                        opt.textContent = b.buildingName;
                        buildingSelect.appendChild(opt);
                    });
                    buildingSelect.disabled = false;
                })
                .catch(err => console.error('خطأ في تحميل المباني:', err));
        }

        function loadRooms(buildingId) {
            const roomSelect = document.getElementById('roomSelect');
            roomSelect.innerHTML = '<option value="">-- اختر الغرفة --</option>';
            roomSelect.disabled = true;

            if (!buildingId) return;

            fetch('@Url.Action("GetRoomsByBuilding", "Allocation")?buildingId=' + buildingId)
                .then(res => res.json())
                .then(data => {
                    data.forEach(function (r) {
                        const opt = document.createElement('option');
                        opt.value = r.id;
                        opt.textContent = 'غرفة ' + r.roomNumber + ' - دور ' + r.floorNumber + ' (' + r.available + ' سرير متاح)';
                        if (r.available <= 0) opt.disabled = true;
                        roomSelect.appendChild(opt);
                    });
                    roomSelect.disabled = false;
                })
                .catch(err => console.error('خطأ في تحميل الغرف:', err));
        }
        document.getElementById('studentSelect').addEventListener('change', function () {
            const studentId = this.value;
            const warning = document.getElementById('appWarning');
            const appField = document.getElementById('applicationIdField');
            const yearField = document.querySelector('[name="AcademicYear"]');

            appField.value = '';
            warning.style.display = 'none';

            if (!studentId) return;

            fetch('@Url.Action("GetApplicationByStudent", "Allocation")?studentId=' + studentId)
                .then(res => res.json())
                .then(data => {
                    if (data.found) {
                        appField.value = data.applicationId;
                        if (yearField && !yearField.value) yearField.value = data.academicYear;
                    } else {
                        warning.textContent = data.message;
                        warning.style.display = 'block';
                    }
                });
        });
    </script>
    <script>
        document.getElementById('studentSearch').addEventListener('keyup', function () {
            let filter = this.value.toLowerCase();
            let select = document.getElementById('studentSelect');
            let options = select.options;
            for (let i = 0; i < options.length; i++) {
                let txt = options[i].text.toLowerCase();
                options[i].style.display = txt.includes(filter) ? '' : 'none';
            }
        });
    </script>
}