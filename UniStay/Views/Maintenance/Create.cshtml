@model UniStay.ViewModels.Maintenance.CreateMaintenanceViewModel
@{
    ViewData["Title"] = "طلب صيانة جديد";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="page-title"><i class="bi bi-plus-circle"></i> طلب صيانة جديد</h2>
    <a asp-action="Index" class="btn btn-secondary"><i class="bi bi-arrow-right"></i> العودة</a>
</div>

<div class="filter-bar p-4">
    <form asp-action="Create" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="row mb-3">
            <div class="col-md-6">
                <label class="form-label">الطالب <span class="text-danger">*</span></label>
                <input type="text" id="studentSearch" class="form-control mb-2" placeholder="بحث بالاسم أو الرقم القومي...">
                <select asp-for="StudentID" class="form-select" id="studentSelect" required>
                    <option value="">-- اختر الطالب --</option>
                    @foreach (var s in (IEnumerable<UniStay.ViewModels.Maintenance.StudentLookupItem>)ViewBag.Students)
                    {
                        <option value="@s.ID">@s.FullName - @s.NationalID</option>
                    }
                </select>
                <span asp-validation-for="StudentID" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label class="form-label">المدينة الجامعية <span class="text-danger">*</span></label>
                <select asp-for="DormitoryCityID" class="form-select" id="citySelect" required>
                    <option value="">-- اختر المدينة --</option>
                    @foreach (var c in (IEnumerable<UniStay.ViewModels.Maintenance.CityLookupItem>)ViewBag.Cities)
                    {
                        <option value="@c.ID">@c.Name</option>
                    }
                </select>
                <span asp-validation-for="DormitoryCityID" class="text-danger"></span>
            </div>
        </div>

        <div class="row mb-3">
            <div class="col-md-6">
                <label class="form-label">الغرفة <span class="text-danger">*</span></label>
                <select asp-for="CityRoomID" class="form-select" id="roomSelect" required>
                    <option value="">-- اختر المدينة أولاً --</option>
                </select>
                <span asp-validation-for="CityRoomID" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label class="form-label">التصنيف</label>
                <select asp-for="Category" class="form-select">
                    <option value="">-- اختر التصنيف --</option>
                    <option value="كهرباء">كهرباء</option>
                    <option value="سباكة">سباكة</option>
                    <option value="أثاث">أثاث</option>
                    <option value="تكييف">تكييف</option>
                    <option value="أبواب ونوافذ">أبواب ونوافذ</option>
                    <option value="دهانات">دهانات</option>
                    <option value="نظافة">نظافة</option>
                    <option value="أخرى">أخرى</option>
                </select>
            </div>
        </div>

        <div class="row mb-3">
            <div class="col-md-6">
                <label class="form-label">الأولوية <span class="text-danger">*</span></label>
                <div class="d-flex gap-3">
                    <div class="form-check">
                        <input asp-for="Priority" type="radio" value="Low" class="form-check-input" id="priorityLow">
                        <label class="form-check-label" for="priorityLow">منخفضة</label>
                    </div>
                    <div class="form-check">
                        <input asp-for="Priority" type="radio" value="Medium" class="form-check-input" id="priorityMedium" checked>
                        <label class="form-check-label" for="priorityMedium">متوسطة</label>
                    </div>
                    <div class="form-check">
                        <input asp-for="Priority" type="radio" value="High" class="form-check-input" id="priorityHigh">
                        <label class="form-check-label" for="priorityHigh">عالية</label>
                    </div>
                </div>
                <span asp-validation-for="Priority" class="text-danger"></span>
            </div>
        </div>

        <div class="mb-3">
            <label class="form-label">وصف المشكلة <span class="text-danger">*</span></label>
            <textarea asp-for="Description" class="form-control" rows="4" required></textarea>
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary"><i class="bi bi-send"></i> إرسال الطلب</button>
    </form>
</div>

@section Scripts {
    <script>
        const getRoomsUrl    = '@Url.Action("GetRoomsByCity", "Maintenance")';
        const getStudentsUrl = '@Url.Action("GetStudents", "Maintenance")';

        // ── تحميل الغرف عند اختيار المدينة ─────────────────────
        document.getElementById('citySelect').addEventListener('change', function () {
            loadRooms(this.value);
        });

        function loadRooms(cityId) {
            const sel = document.getElementById('roomSelect');
            if (!cityId) {
                sel.innerHTML = '<option value="">-- اختر المدينة أولاً --</option>';
                return;
            }

            sel.innerHTML = '<option value="">جاري التحميل...</option>';

            fetch(getRoomsUrl + '?cityId=' + cityId)
                .then(r => r.json())
                .then(data => {
                    sel.innerHTML = '<option value="">-- اختر الغرفة --</option>';
                    data.forEach(r => {
                        const opt = document.createElement('option');
                        opt.value = r.id;
                        opt.textContent = r.buildingName + ' - دور ' + r.floorNumber +
                                          ' - غرفة ' + r.roomNumber +
                                          ' (' + (r.bedsCount - r.currentOccupancy) + ' متاح)';
                        sel.appendChild(opt);
                    });
                })
                .catch(() => {
                    sel.innerHTML = '<option value="">-- حدث خطأ في التحميل --</option>';
                });
        }

        // ── بحث الطلاب ──────────────────────────────────────────
        let searchTimer = null;
        document.getElementById('studentSearch').addEventListener('input', function () {
            const term = this.value.trim();
            clearTimeout(searchTimer);

            if (term.length < 2) return;

            searchTimer = setTimeout(() => {
                fetch(getStudentsUrl + '?term=' + encodeURIComponent(term))
                    .then(r => r.json())
                    .then(data => {
                        const sel = document.getElementById('studentSelect');
                        sel.innerHTML = '<option value="">-- اختر الطالب --</option>';
                        data.forEach(s => {
                            const opt = document.createElement('option');
                            opt.value = s.id;
                            opt.textContent = s.fullName + ' - ' + s.nationalID;
                            sel.appendChild(opt);
                        });
                    })
                    .catch(() => {});
            }, 300);
        });
    </script>
}
