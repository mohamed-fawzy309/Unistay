@model UniStay.ViewModels.Permissions.UserDetailsViewModel
@{
    ViewData["Title"] = "تفاصيل المستخدم";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid py-3">
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="Users">المستخدمين</a></li>
            <li class="breadcrumb-item active">@Model.Name</li>
        </ol>
    </nav>

    <div class="card shadow-sm border-0">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
            <h5 class="mb-0"><i class="bi bi-person-badge me-2"></i>تفاصيل المستخدم</h5>
            <div>
                <a asp-action="Edit" asp-route-id="@Model.UserID" class="btn btn-sm btn-light me-2">
                    <i class="bi bi-pencil me-1"></i>تعديل
                </a>
                <a asp-action="Users" class="btn btn-sm btn-light">
                    <i class="bi bi-arrow-right me-1"></i>عودة
                </a>
            </div>
        </div>
        <div class="card-body">
            <div class="row g-4">
                <div class="col-md-6">
                    <table class="table table-bordered mb-0">
                        <tr><th class="bg-light" style="width:160px">الاسم</th><td>@Model.Name</td></tr>
                        <tr><th class="bg-light">البريد الإلكتروني</th><td>@(Model.Email ?? "—")</td></tr>
                        <tr><th class="bg-light">رقم الهاتف</th><td>@(Model.Phone ?? "—")</td></tr>
                        <tr><th class="bg-light">الرقم القومي</th><td><code>@(Model.NationalID ?? "—")</code></td></tr>
                        <tr><th class="bg-light">الحالة</th><td>
                            @if (Model.IsActive)
                            {
                                <span class="badge bg-success">نشط</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">موقوف</span>
                            }
                            @if (Model.MustChangePassword)
                            {
                                <span class="badge bg-warning text-dark ms-1">يجب تغيير كلمة المرور</span>
                            }
                        </td></tr>
                    </table>
                </div>
                <div class="col-md-6">
                    <table class="table table-bordered mb-0">
                        <tr><th class="bg-light" style="width:160px">الدور الوظيفي</th><td>@(Model.RoleName ?? "—")</td></tr>
                        <tr><th class="bg-light">المدينة</th><td>@(Model.CityName ?? "—")</td></tr>
                        <tr><th class="bg-light">الدور في المدينة</th><td>@(Model.RoleInCity ?? "—")</td></tr>
                        <tr><th class="bg-light">صلاحيات مباشرة</th><td>@Model.DirectPermissionsCount</td></tr>
                        <tr><th class="bg-light">إجمالي الصلاحيات الفعلية</th><td>@Model.EffectivePermissionsCount</td></tr>
                        <tr><th class="bg-light">آخر دخول</th><td class="small">@(Model.LastLoginAt?.ToString("dd/MM/yyyy HH:mm") ?? "لم يسجل دخولاً")</td></tr>
                        <tr><th class="bg-light">تاريخ الإنشاء</th><td class="small">@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td></tr>
                    </table>
                </div>
            </div>

            @if (Model.IsSuperAdmin)
            {
                <div class="alert alert-warning mt-3 mb-0">
                    <i class="bi bi-shield-fill-exclamation me-2"></i>
                    هذا المستخدم يملك صلاحيات <strong>SuperAdmin</strong> — يمكنه الوصول إلى كل شيء في النظام.
                </div>
            }
        </div>
    </div>
</div>