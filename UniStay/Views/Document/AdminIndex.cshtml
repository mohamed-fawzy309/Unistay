@model UniStay.ViewModels.Document.DocumentAdminIndexViewModel
@{
    ViewData["Title"] = "إدارة المستندات";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="page-title"><i class="bi bi-file-earmark"></i> المستندات</h2>
    <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#uploadModal">
        <i class="bi bi-cloud-upload"></i> رفع مستند
    </button>
</div>

<form method="get" class="filter-bar row g-2 mb-3">
    <div class="col-md-3">
        <select name="filterStatus" class="form-select" onchange="this.form.submit()">
            <option value="">كل المستندات</option>
            <option value="Verified" selected="@(Model.FilterStatus == "Verified")">موثق</option>
            <option value="Pending" selected="@(Model.FilterStatus == "Pending")">قيد المراجعة</option>
        </select>
    </div>
    <div class="col-md-2">
        <a asp-action="AdminIndex" class="btn btn-secondary w-100">إعادة تعيين</a>
    </div>
</form>

<div class="table-responsive bg-white rounded shadow-sm animate-fade-in">
    <table class="table table-hover mb-0">
        <thead class="table-dark">
            <tr>
                <th>#</th>
                <th>نوع المستند</th>
                <th>الطالب</th>
                <th>الرقم القومي</th>
                <th>اسم الملف</th>
                <th>تاريخ الرفع</th>
                <th>الحالة</th>
                <th>موثق بواسطة</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var d in Model.Documents)
            {
                <tr>
                    <td>@d.ID</td>
                    <td>@d.DocumentType</td>
                    <td>@d.StudentName</td>
                    <td>@d.NationalID</td>
                    <td>@d.FileName</td>
                    <td>@(d.UploadedAt?.ToString("yyyy-MM-dd HH:mm") ?? "-")</td>
                    <td>
                        @if (d.IsVerified == true)
                        {
                            <span class="badge-success">موثق</span>
                        }
                        else
                        {
                            <span class="badge-warning">قيد المراجعة</span>
                        }
                    </td>
                    <td>@(d.VerifiedByName ?? "-")</td>
                    <td class="text-nowrap">
                        <a asp-action="Download" asp-route-id="@d.ID" class="btn btn-outline-info btn-sm" title="تحميل">
                            <i class="bi bi-download"></i>
                        </a>
                        @if (d.IsVerified != true)
                        {
                            <button class="btn btn-outline-success btn-sm btn-verify" data-id="@d.ID" title="توثيق">
                                <i class="bi bi-check-circle"></i>
                            </button>
                        }
                    </td>
                </tr>
            }
            @if (!Model.Documents.Any())
            {
                <tr><td colspan="9" class="text-center text-muted py-4">لا توجد مستندات</td></tr>
            }
        </tbody>
    </table>
</div>

@if (Model.TotalPages > 1)
{
    <nav class="mt-3">
        <ul class="pagination pagination-modern justify-content-center">
            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(i == Model.Page ? "active" : "")">
                    <a class="page-link" href="@Url.Action("AdminIndex", new { page = i, filterStatus = Model.FilterStatus })">@i</a>
                </li>
            }
        </ul>
    </nav>
}

<!-- Upload Modal -->
<div class="modal fade" id="uploadModal" tabindex="-1">
    <div class="modal-dialog">
        <form asp-action="Upload" method="post" enctype="multipart/form-data" class="modal-content">
            <div class="modal-header"><h5 class="modal-title">رفع مستند</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
            <div class="modal-body">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <div class="mb-3">
                    <label class="form-label">الطالب <span class="text-danger">*</span></label>
                    <select name="StudentID" class="form-select" required>
                        <option value="">-- اختر الطالب --</option>
                        @foreach (var s in ViewBag.Students)
                        {
                            <option value="@s.ID">@s.FullName - @s.NationalID</option>
                        }
                    </select>
                    <span class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label class="form-label">نوع المستند <span class="text-danger">*</span></label>
                    <select name="DocumentType" class="form-select" required>
                        <option value="">-- اختر النوع --</option>
                        <option value="NationalID">بطاقة الرقم القومي</option>
                        <option value="BirthCertificate">شهادة ميلاد</option>
                        <option value="AcademicRecord">الموقف التجنيدي</option>
                        <option value="GradeReport">بيان درجات</option>
                        <option value="MedicalReport">تقرير طبي</option>
                        <option value="Other">أخرى</option>
                    </select>
                    <span class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label class="form-label">الملف <span class="text-danger">*</span></label>
                    <input name="File" type="file" class="form-control" required>
                    <span class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label class="form-label">رقم الطلب (اختياري)</label>
                    <input name="ApplicationID" type="number" class="form-control" placeholder="معرف الطلب">
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إلغاء</button>
                <button type="submit" class="btn btn-primary">رفع</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        $(function () {
            $('.btn-verify').click(function () {
                var id = $(this).data('id');
                var btn = $(this);
                $.post('@Url.Action("Verify", "Document")/' + id, function (res) {
                    if (res.success) {
                        location.reload();
                    } else {
                        alert(res.message);
                    }
                });
            });
        });
    </script>
}
