@model UniStay.ViewModels.Reports.StudentListsReportViewModel
@{
    ViewData["Title"] = "قوائم الطلاب";
    var dir = Model.Filter.SortDir == "asc" ? "desc" : "asc";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="page-title">قوائم الطلاب</h2>
    <div class="btn-group">
        <a href="@Url.Action("StudentListsExportExcel", new { search = Model.Filter.Search, cityId = Model.Filter.CityID, buildingId = Model.Filter.BuildingID, gender = Model.Filter.Gender, faculty = Model.Filter.Faculty, status = Model.Filter.Status })" class="btn btn-success"><i class="bi bi-file-earmark-excel"></i> Excel</a>
        <a href="@Url.Action("StudentListsExportPdf", new { search = Model.Filter.Search, cityId = Model.Filter.CityID, buildingId = Model.Filter.BuildingID, gender = Model.Filter.Gender, faculty = Model.Filter.Faculty, status = Model.Filter.Status })" class="btn btn-danger"><i class="bi bi-file-earmark-pdf"></i> PDF</a>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="stat-card bg-white">
            <div class="d-flex align-items-center gap-3">
                <div class="icon bg-primary bg-opacity-10 text-primary"><i class="bi bi-people"></i></div>
                <div>
                    <div class="value">@Model.TotalCount</div>
                    <div class="label">إجمالي الطلاب</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="stat-card bg-white">
            <div class="d-flex align-items-center gap-3">
                <div class="icon bg-success bg-opacity-10 text-success"><i class="bi bi-house-check"></i></div>
                <div>
                    <div class="value">@Model.Students.Count(s => s.Status == "Allocated")</div>
                    <div class="label">مقيمون</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="stat-card bg-white">
            <div class="d-flex align-items-center gap-3">
                <div class="icon bg-warning bg-opacity-10 text-warning"><i class="bi bi-house-x"></i></div>
                <div>
                    <div class="value">@Model.Students.Count(s => s.Status != "Allocated")</div>
                    <div class="label">غير مقيمين</div>
                </div>
            </div>
        </div>
    </div>
</div>

<form method="get" class="filter-bar row g-2 mb-3">
    <div class="col-md-3">
        <label class="form-label small">بحث</label>
        <input type="text" name="search" class="form-control" placeholder="اسم الطالب أو الرقم القومي..." value="@Model.Filter.Search">
    </div>
    <div class="col-md-2">
        <label class="form-label small">المدينة</label>
        <select name="cityId" class="form-select" onchange="this.form.submit()">
            <option value="">الكل</option>
            @foreach (var c in Model.Cities)
            {
                <option value="@c.ID" selected="@(Model.Filter.CityID == c.ID)">@c.Name</option>
            }
        </select>
    </div>
    <div class="col-md-2">
        <label class="form-label small">المبنى</label>
        <select name="buildingId" class="form-select" onchange="this.form.submit()">
            <option value="">الكل</option>
        </select>
    </div>
    <div class="col-md-1">
        <label class="form-label small">النوع</label>
        <select name="gender" class="form-select" onchange="this.form.submit()">
            <option value="">الكل</option>
            <option value="Male" selected="@(Model.Filter.Gender == "Male")">ذكر</option>
            <option value="Female" selected="@(Model.Filter.Gender == "Female")">أنثى</option>
        </select>
    </div>
    <div class="col-md-2">
        <label class="form-label small">الكلية</label>
        <input type="text" name="faculty" class="form-control" placeholder="الكلية..." value="@Model.Filter.Faculty">
    </div>
    <div class="col-md-2">
        <label class="form-label small">الحالة</label>
        <select name="status" class="form-select" onchange="this.form.submit()">
            <option value="">الكل</option>
            <option value="Allocated" selected="@(Model.Filter.Status == "Allocated")">مقيم</option>
            <option value="Pending" selected="@(Model.Filter.Status == "Pending")">قيد الانتظار</option>
            <option value="Rejected" selected="@(Model.Filter.Status == "Rejected")">مرفوض</option>
        </select>
    </div>
</form>

<div class="table-responsive bg-white rounded shadow-sm animate-fade-in">
    <table class="table table-hover mb-0">
        <thead class="table-dark">
            <tr>
                <th><a href="@Url.Action("StudentLists", new { sortBy = "FullName", sortDir = dir, search = Model.Filter.Search, cityId = Model.Filter.CityID, buildingId = Model.Filter.BuildingID, gender = Model.Filter.Gender, faculty = Model.Filter.Faculty, status = Model.Filter.Status })" class="text-white text-decoration-none">الاسم @(Model.Filter.SortBy == "FullName" ? (Model.Filter.SortDir == "asc" ? "▲" : "▼") : "")</a></th>
                <th><a href="@Url.Action("StudentLists", new { sortBy = "NationalID", sortDir = dir, search = Model.Filter.Search, cityId = Model.Filter.CityID, buildingId = Model.Filter.BuildingID, gender = Model.Filter.Gender, faculty = Model.Filter.Faculty, status = Model.Filter.Status })" class="text-white text-decoration-none">الرقم القومي @(Model.Filter.SortBy == "NationalID" ? (Model.Filter.SortDir == "asc" ? "▲" : "▼") : "")</a></th>
                <th>كود الطالب</th>
                <th><a href="@Url.Action("StudentLists", new { sortBy = "Gender", sortDir = dir, search = Model.Filter.Search, cityId = Model.Filter.CityID, buildingId = Model.Filter.BuildingID, gender = Model.Filter.Gender, faculty = Model.Filter.Faculty, status = Model.Filter.Status })" class="text-white text-decoration-none">النوع @(Model.Filter.SortBy == "Gender" ? (Model.Filter.SortDir == "asc" ? "▲" : "▼") : "")</a></th>
                <th><a href="@Url.Action("StudentLists", new { sortBy = "Faculty", sortDir = dir, search = Model.Filter.Search, cityId = Model.Filter.CityID, buildingId = Model.Filter.BuildingID, gender = Model.Filter.Gender, faculty = Model.Filter.Faculty, status = Model.Filter.Status })" class="text-white text-decoration-none">الكلية @(Model.Filter.SortBy == "Faculty" ? (Model.Filter.SortDir == "asc" ? "▲" : "▼") : "")</a></th>
                <th>القسم</th>
                <th>النسبة</th>
                <th>الهاتف</th>
                <th>البريد</th>
                <th>المدينة</th>
                <th>المحافظة</th>
                <th><a href="@Url.Action("StudentLists", new { sortBy = "Status", sortDir = dir, search = Model.Filter.Search, cityId = Model.Filter.CityID, buildingId = Model.Filter.BuildingID, gender = Model.Filter.Gender, faculty = Model.Filter.Faculty, status = Model.Filter.Status })" class="text-white text-decoration-none">الحالة @(Model.Filter.SortBy == "Status" ? (Model.Filter.SortDir == "asc" ? "▲" : "▼") : "")</a></th>
                <th>المدينة المخصصة</th>
                <th>المبنى</th>
                <th>الغرفة</th>
                <th>صورة</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var s in Model.Students)
            {
                <tr>
                    <td class="fw-semibold">@s.FullName</td>
                    <td>@s.NationalID</td>
                    <td>@(s.StudentCode ?? "—")</td>
                    <td>@(s.Gender == "Male" ? "ذكر" : "أنثى")</td>
                    <td>@(s.Faculty ?? "—")</td>
                    <td>@(s.Department ?? "—")</td>
                    <td>@(s.GradePercentage?.ToString("N2") ?? "—")</td>
                    <td>@(s.Phone ?? "—")</td>
                    <td>@(s.Email ?? "—")</td>
                    <td>@(s.City ?? "—")</td>
                    <td>@(s.Governorate ?? "—")</td>
                    <td>
                        <span class="badge bg-@(s.Status switch { "Allocated" => "success", "Pending" => "secondary", "Rejected" => "danger", _ => "light" })">
                            @(s.Status switch { "Allocated" => "مقيم", "Pending" => "قيد الانتظار", "Rejected" => "مرفوض", _ => s.Status ?? "—" })
                        </span>
                    </td>
                    <td>@(s.AllocatedCity ?? "—")</td>
                    <td>@(s.BuildingName ?? "—")</td>
                    <td>@(s.RoomNumber ?? "—")</td>
                    <td>
                        @if (s.HasPhoto == true)
                        {
                            <span class="text-success"><i class="bi bi-check-circle"></i></span>
                        }
                        else
                        {
                            <span class="text-muted">—</span>
                        }
                    </td>
                </tr>
            }
            @if (!Model.Students.Any())
            {
                <tr><td colspan="16" class="text-center text-muted py-4">لا يوجد طلاب</td></tr>
            }
        </tbody>
    </table>
</div>

@if (Model.TotalPages > 1)
{
    <nav class="mt-3">
        <ul class="pagination pagination-modern justify-content-center">
            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(i == Model.Page ? "active" : "")">
                    <a class="page-link" href="@Url.Action("StudentLists", new { page = i, sortBy = Model.Filter.SortBy, sortDir = Model.Filter.SortDir, search = Model.Filter.Search, cityId = Model.Filter.CityID, buildingId = Model.Filter.BuildingID, gender = Model.Filter.Gender, faculty = Model.Filter.Faculty, status = Model.Filter.Status })">@i</a>
                </li>
            }
        </ul>
    </nav>
}
