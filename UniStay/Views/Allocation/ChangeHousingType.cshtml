@model ChangeHousingTypeViewModel
@{
    ViewData["Title"] = "تغيير نوع السكن لطالب";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-arrow-left-right"></i> تغيير نوع السكن لطالب</h2>
        <a asp-action="Index" class="btn btn-secondary"><i class="bi bi-arrow-right"></i> العودة</a>
    </div>

    <div class="row">
        <div class="col-md-6">
            <div class="card mb-4">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">اختيار الطالب</h5>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <label class="form-label">بحث الطالب</label>
                        <input type="text" id="studentSearch" class="form-control mb-2" placeholder="بحث بالاسم أو الرقم القومي..." />
                        <select id="studentSelect" class="form-select" onchange="loadStudentAllocation(this.value)">
                            <option value="">-- اختر الطالب --</option>
                            @foreach (var s in ViewBag.Students)
                            {
                                <option value="@s.ID">@s.FullName - @s.NationalID</option>
                            }
                        </select>
                    </div>
                    <div id="studentInfo" class="alert alert-info d-none">
                        <i class="bi bi-info-circle"></i> يتم تحميل بيانات الطالب...
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0">تغيير نوع السكن</h5>
                </div>
                <div class="card-body" id="changeFormContainer">
                    @if (Model.StudentID > 0)
                    {
                        <form id="changeForm" method="post" asp-action="ChangeHousingType">
                            @Html.AntiForgeryToken()
                            <input type="hidden" asp-for="StudentID" />
                            <input type="hidden" asp-for="ApplicationID" />

                            <div class="mb-3">
                                <label class="form-label fw-bold">اسم الطالب</label>
                                <p class="form-control-plaintext">@Model.StudentName</p>
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-bold">الرقم القومي</label>
                                <p class="form-control-plaintext">@Model.NationalID</p>
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-bold">الكلية</label>
                                <p class="form-control-plaintext">@(Model.Faculty ?? "---")</p>
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-bold">المدينة / المبنى / الغرفة</label>
                                <p class="form-control-plaintext">@Model.CityName / @Model.BuildingName / غرفة @Model.RoomNumber</p>
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-bold">نوع السكن الحالي</label>
                                <p class="form-control-plaintext text-primary fw-bold">@(string.IsNullOrEmpty(Model.CurrentHousingType) ? "---" : Model.CurrentHousingType)</p>
                            </div>
                            <div class="mb-3">
                                <label class="form-label" asp-for="NewHousingType">نوع السكن الجديد <span class="text-danger">*</span></label>
                                <select asp-for="NewHousingType" class="form-select" required>
                                    <option value="">-- اختر --</option>
                                    @foreach (var ht in Model.HousingTypeOptions)
                                    {
                                        <option value="@ht.Value" selected="@(ht.Value == Model.NewHousingType)">@ht.Label</option>
                                    }
                                </select>
                                <span asp-validation-for="NewHousingType" class="text-danger"></span>
                            </div>
                            <div class="mb-3">
                                <label class="form-label" asp-for="Reason">سبب التغيير</label>
                                <textarea asp-for="Reason" class="form-control" rows="2" placeholder="اختياري"></textarea>
                            </div>
                            <button type="submit" class="btn btn-success"><i class="bi bi-check-circle"></i> حفظ التغيير</button>
                        </form>
                    }
                    else
                    {
                        <div class="text-center text-muted py-5">
                            <i class="bi bi-person-plus fs-1"></i>
                            <p class="mt-2">يرجى اختيار طالب من القائمة</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('studentSearch')?.addEventListener('keyup', function () {
            var filter = this.value.toLowerCase();
            var select = document.getElementById('studentSelect');
            for (var i = 0; i < select.options.length; i++) {
                select.options[i].style.display = select.options[i].text.toLowerCase().includes(filter) ? '' : 'none';
            }
        });

        function loadStudentAllocation(studentId) {
            if (!studentId) {
                document.getElementById('changeFormContainer').innerHTML = `
                    <div class="text-center text-muted py-5">
                        <i class="bi bi-person-plus fs-1"></i>
                        <p class="mt-2">يرجى اختيار طالب من القائمة</p>
                    </div>`;
                return;
            }

            var info = document.getElementById('studentInfo');
            info.classList.remove('d-none');
            info.innerHTML = '<i class="bi bi-info-circle"></i> يتم تحميل بيانات الطالب...';

            fetch('@Url.Action("GetStudentAllocation", "Allocation")?studentId=' + studentId)
                .then(function (res) { if (!res.ok) throw new Error(); return res.json(); })
                .then(function (data) {
                    info.classList.add('d-none');
                    if (!data.found) {
                        document.getElementById('changeFormContainer').innerHTML = `
                            <div class="alert alert-warning">
                                <i class="bi bi-exclamation-triangle"></i> ${data.message}
                            </div>`;
                        return;
                    }

                    var container = document.getElementById('changeFormContainer');
                    var housingTypes = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                        ((List<HousingTypeOption>)ViewBag.HousingTypes).Select(h => new { h.Value, h.Label })));

                    var currentType = data.currentHousingType || '';
                    var options = housingTypes.map(function (h) {
                        var selected = h.value === currentType ? 'selected' : '';
                        return '<option value="' + h.value + '" ' + selected + '>' + h.label + '</option>';
                    }).join('');

                    container.innerHTML = `
                        <form id="changeForm" method="post" action="@Url.Action("ChangeHousingType", "Allocation")">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="StudentID" value="` + data.studentID + `" />
                            <input type="hidden" name="ApplicationID" value="` + data.applicationID + `" />

                            <div class="mb-3">
                                <label class="form-label fw-bold">اسم الطالب</label>
                                <p class="form-control-plaintext">` + data.studentName + `</p>
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-bold">الرقم القومي</label>
                                <p class="form-control-plaintext">` + data.nationalID + `</p>
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-bold">الكلية</label>
                                <p class="form-control-plaintext">` + (data.faculty || '---') + `</p>
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-bold">المدينة / المبنى / الغرفة</label>
                                <p class="form-control-plaintext">` + (data.cityName || '') + ' / ' + (data.buildingName || '') + ' / غرفة ' + (data.roomNumber || '') + `</p>
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-bold">نوع السكن الحالي</label>
                                <p class="form-control-plaintext text-primary fw-bold">` + (data.currentHousingType || '---') + `</p>
                            </div>
                            <div class="mb-3">
                                <label class="form-label" for="NewHousingType">نوع السكن الجديد <span class="text-danger">*</span></label>
                                <select id="NewHousingType" name="NewHousingType" class="form-select" required>
                                    <option value="">-- اختر --</option>
                                    ` + options + `
                                </select>
                            </div>
                            <div class="mb-3">
                                <label class="form-label" for="Reason">سبب التغيير</label>
                                <textarea id="Reason" name="Reason" class="form-control" rows="2" placeholder="اختياري"></textarea>
                            </div>
                            <button type="submit" class="btn btn-success"><i class="bi bi-check-circle"></i> حفظ التغيير</button>
                        </form>
                    `;

                    document.getElementById('changeForm').addEventListener('submit', function (e) {
                        e.preventDefault();
                        var form = this;
                        fetch(form.action, {
                            method: 'POST',
                            body: new URLSearchParams(new FormData(form))
                        })
                        .then(function (res) { if (!res.ok) throw new Error(); return res.json(); })
                        .then(function (result) {
                            if (result.success) {
                                showToast('success', result.message);
                                form.reset();
                            } else {
                                showToast('error', result.message);
                            }
                        })
                        .catch(function () {
                            showToast('error', 'حدث خطأ أثناء حفظ البيانات');
                        });
                    });
                })
                .catch(function () {
                    info.classList.add('d-none');
                    document.getElementById('changeFormContainer').innerHTML = `
                        <div class="alert alert-danger">
                            <i class="bi bi-exclamation-triangle"></i> حدث خطأ أثناء تحميل بيانات الطالب
                        </div>`;
                });
        }

        function showToast(type, message) {
            var container = document.getElementById('toastContainer') || (function () {
                var c = document.createElement('div');
                c.id = 'toastContainer';
                c.style.cssText = 'position:fixed;top:20px;left:50%;transform:translateX(-50%);z-index:9999';
                document.body.appendChild(c);
                return c;
            })();

            var bg = type === 'success' ? 'bg-success' : 'bg-danger';
            var html = '<div class="toast align-items-center text-white ' + bg + ' border-0 show" role="alert">' +
                '<div class="d-flex"><div class="toast-body">' + message + '</div>' +
                '<button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button></div></div>';
            var el = document.createElement('div');
            el.innerHTML = html;
            container.appendChild(el);
            setTimeout(function () { el.remove(); }, 4000);
        }
    </script>
}
