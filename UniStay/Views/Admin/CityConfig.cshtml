@model UniStay.Models.CityConfiguration
@{
    ViewData["Title"] = "إعدادات المدينة";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>إعدادات: @ViewBag.CityName</h2>
    <a asp-action="Cities" class="btn btn-secondary">رجوع</a>
</div>

<form asp-action="CityConfig" method="post" class="card shadow-sm">
    <input type="hidden" asp-for="ID" />
    <input type="hidden" asp-for="DormitoryCityID" />

    <div class="card-header bg-primary text-white"><h5 class="mb-0">الرسوم</h5></div>
    <div class="card-body">
        <div class="row">
            <div class="col-md-4 mb-3">
                <label class="form-label">رسوم السكن العادي</label>
                <input asp-for="StandardFee" class="form-control" type="number" step="0.01">
            </div>
            <div class="col-md-4 mb-3">
                <label class="form-label">رسوم السكن ممتاز</label>
                <input asp-for="PremiumFee" class="form-control" type="number" step="0.01">
            </div>
            <div class="col-md-4 mb-3">
                <label class="form-label">رسوم VIP</label>
                <input asp-for="VIPFee" class="form-control" type="number" step="0.01">
            </div>
            <div class="col-md-4 mb-3">
                <label class="form-label">رسوم الطلاب الوافدين</label>
                <input asp-for="ForeignStudentFee" class="form-control" type="number" step="0.01">
            </div>
            <div class="col-md-4 mb-3">
                <label class="form-label">تأمين</label>
                <input asp-for="SecurityDeposit" class="form-control" type="number" step="0.01">
            </div>
            <div class="col-md-4 mb-3">
                <label class="form-label">رسوم الوجبة</label>
                <input asp-for="MealFee" class="form-control" type="number" step="0.01">
            </div>
            <div class="col-md-4 mb-3">
                <label class="form-label">رسوم وجبة رمضان</label>
                <input asp-for="RamadanMealFee" class="form-control" type="number" step="0.01">
            </div>
            <div class="col-md-4 mb-3">
                <label class="form-label">رسوم وجبة مسيحي</label>
                <input asp-for="ChristianMealFee" class="form-control" type="number" step="0.01">
            </div>
        </div>
    </div>

    <div class="card-header bg-success text-white mt-3"><h5 class="mb-0">شروط القبول</h5></div>
    <div class="card-body">
        <div class="row">
            <div class="col-md-4 mb-3">
                <label class="form-label">أقل مسافة (كم)</label>
                <input asp-for="MinDistanceKm" class="form-control" type="number" step="0.01">
            </div>
            <div class="col-md-4 mb-3">
                <label class="form-label">أقل نسبة تقدير</label>
                <input asp-for="MinGradePercentage" class="form-control" type="number" step="0.01">
            </div>
            <div class="col-md-4 mb-3">
                <label class="form-label">أقصى عمر</label>
                <input asp-for="MaxAge" class="form-control" type="number">
            </div>
            <div class="col-md-6 mb-3">
                <label class="form-label">عدد الأسرة الأقصى في الغرفة</label>
                <input asp-for="MaxBedsPerRoom" class="form-control" type="number">
            </div>
            
            <div class="col-md-6 mb-3 d-flex align-items-end">
    <div class="form-check">
   @if (Model.AutoCoordinationEnabled == true)
{
    <input type="checkbox"
           name="AutoCoordinationEnabled"
           class="form-check-input"
           value="true"
           checked />
}
else
{
    <input type="checkbox"
           name="AutoCoordinationEnabled"
           class="form-check-input"
           value="true" />
}

<input type="hidden" name="AutoCoordinationEnabled" value="false" />
        
        <label class="form-check-label">
            تفعيل التنسيق الآلي
        </label>
    </div>
</div>

<div class="col-md-6 mb-3 d-flex align-items-end">
    <div class="form-check">
  @if (Model.AllowStudentBedSelection == true)
{
    <input type="checkbox"
           name="AllowStudentBedSelection"
           class="form-check-input"
           value="true"
           checked />
}
else
{
    <input type="checkbox"
           name="AllowStudentBedSelection"
           class="form-check-input"
           value="true" />
}

<input type="hidden" name="AllowStudentBedSelection" value="false" />
             
        <label class="form-check-label">
            السماح للطالب باختيار السرير
        </label>
    </div>
</div>
            </div>
        </div>
    

    <div class="card-header bg-info text-white mt-3"><h5 class="mb-0">الكليات المسموحة / المستثناة</h5></div>
    <div class="card-body">
        <div class="row mb-3">
            <div class="col-md-12">
                <div class="d-flex gap-2 align-items-center">
                    <select id="facultySelect" class="form-select" style="max-width:400px">
                        <option value="">-- اختر كلية --</option>
                        @foreach (var f in (List<string>)ViewBag.Faculties)
                        {
                            <option value="@f">@f</option>
                        }
                    </select>
                    <button type="button" class="btn btn-success" onclick="addFaculty('allowed')">← إضافة للمسموحة</button>
                    <button type="button" class="btn btn-danger" onclick="addFaculty('excluded')">إضافة للمستثناة →</button>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label">الكليات المسموحة فقط</label>
                <div id="allowedContainer" class="border rounded p-2" style="min-height:150px;max-height:300px;overflow-y:auto">
                    @foreach (var f in (List<string>)ViewBag.AllowedFaculties)
                    {
                        <span class="badge bg-success fs-6 m-1 p-2 d-inline-flex align-items-center gap-1">
                            @f
                            <button type="button" class="btn-close btn-close-white" style="font-size:10px" onclick="removeFaculty(this,'allowed')"></button>
                        </span>
                    }
                </div>
                <input type="hidden" asp-for="AllowedFacultiesOnly" id="AllowedFacultiesOnly" />
            </div>
            <div class="col-md-6 mb-3">
                <label class="form-label">الكليات المستثناة</label>
                <div id="excludedContainer" class="border rounded p-2" style="min-height:150px;max-height:300px;overflow-y:auto">
                    @foreach (var f in (List<string>)ViewBag.ExcludedFaculties)
                    {
                        <span class="badge bg-danger fs-6 m-1 p-2 d-inline-flex align-items-center gap-1">
                            @f
                            <button type="button" class="btn-close btn-close-white" style="font-size:10px" onclick="removeFaculty(this,'excluded')"></button>
                        </span>
                    }
                </div>
                <input type="hidden" asp-for="ExcludedFaculties" id="ExcludedFaculties" />
            </div>
        </div>
    </div>

    <div class="card-footer">
        <button type="submit" class="btn btn-primary btn-lg" onclick="syncFaculties()">حفظ الإعدادات</button>
        <a asp-action="Cities" class="btn btn-secondary">إلغاء</a>
    </div>
</form>

@section Scripts {
    <script>
        function addFaculty(type) {
            var select = document.getElementById('facultySelect');
            var name = select.value;
            if (!name) return;

            var container = document.getElementById(type + 'Container');
            var existing = container.querySelectorAll('.badge');
            for (var i = 0; i < existing.length; i++) {
                if (existing[i].textContent.trim() === name) return;
            }

            var otherType = type === 'allowed' ? 'excluded' : 'allowed';
            var otherContainer = document.getElementById(otherType + 'Container');
            var otherBadges = otherContainer.querySelectorAll('.badge');
            for (var i = 0; i < otherBadges.length; i++) {
                if (otherBadges[i].textContent.trim() === name) {
                    otherBadges[i].remove();
                    break;
                }
            }

            var badgeClass = type === 'allowed' ? 'bg-success' : 'bg-danger';
            var span = document.createElement('span');
            span.className = 'badge ' + badgeClass + ' fs-6 m-1 p-2 d-inline-flex align-items-center gap-1';
            span.textContent = name;

            var btn = document.createElement('button');
            btn.type = 'button';
            btn.className = 'btn-close btn-close-white';
            btn.style.fontSize = '10px';
            btn.onclick = function() { removeFaculty(btn, type); };
            span.appendChild(btn);

            container.appendChild(span);
            select.value = '';
        }

        function removeFaculty(btn, type) {
            btn.parentElement.remove();
        }

        function syncFaculties() {
            var allowed = [];
            document.querySelectorAll('#allowedContainer .badge').forEach(function(el) {
                allowed.push(el.textContent.trim());
            });
            document.getElementById('AllowedFacultiesOnly').value = JSON.stringify(allowed);

            var excluded = [];
            document.querySelectorAll('#excludedContainer .badge').forEach(function(el) {
                excluded.push(el.textContent.trim());
            });
            document.getElementById('ExcludedFaculties').value = JSON.stringify(excluded);
        }
    </script>
}
