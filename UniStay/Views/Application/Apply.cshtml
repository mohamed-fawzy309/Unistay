            { name: "الطب البيطري", hint: "شهادة الثانوية العامة شعبة علمي علوم" },
            { name: "التمريض", hint: "شهادة الثانوية العامة" },
            { name: "العلوم", hint: "شهادة الثانوية العامة" },
            { name: "الزراعة", hint: "شهادة الثانوية العامة" },
            { name: "التجارة", hint: "شهادة الثانوية العامة" },
            { name: "الآداب", hint: "شهادة الثانوية العامة" },
            { name: "التربية", hint: "شهادة الثانوية العامة" },
            { name: "الحقوق", hint: "شهادة الثانوية العامة" },
            { name: "الإعلام", hint: "شهادة الثانوية العامة" },
            { name: "الاقتصاد والعلوم السياسية", hint: "شهادة الثانوية العامة" },
            { name: "دار العلوم", hint: "شهادة الثانوية العامة" },
            { name: "السياحة والفنادق", hint: "شهادة الثانوية العامة" },
            { name: "التربية الرياضية", hint: "شهادة الثانوية العامة" },
            { name: "التربية النوعية", hint: "شهادة الثانوية العامة" },
            { name: "التربية الفنية", hint: "شهادة الثانوية العامة" },
            { name: "التربية الموسيقية", hint: "شهادة الثانوية العامة" },
            { name: "الألسن", hint: "شهادة الثانوية العامة" },
            { name: "الآثار", hint: "شهادة الثانوية العامة" },
            { name: "الفنون الجميلة", hint: "شهادة الثانوية العامة" },
            { name: "الفنون التطبيقية", hint: "شهادة الثانوية العامة" },
            { name: "العلوم الصحية التطبيقية", hint: "شهادة الثانوية العامة" },
            { name: "حاسبات ومعلومات", hint: "شهادة الثانوية العامة" },
            { name: "الذكاء الاصطناعي", hint: "شهادة الثانوية العامة" },
            { name: "الثروة السمكية", hint: "شهادة الثانوية العامة" },
            { name: "النانو تكنولوجي", hint: "شهادة الثانوية العامة" },
            { name: "الطاقة والطاقة المتجددة", hint: "شهادة الثانوية العامة" },
            { name: "الدراسات العليا", hint: "مؤهل عالي" },
            { name: "معهد فني صحي", hint: "شهادة الثانوية العامة" },
            { name: "معهد فني تجاري", hint: "شهادة الثانوية العامة" },
            { name: "معهد فني زراعي", hint: "شهادة الثانوية العامة" },
            { name: "معهد فني صناعي", hint: "شهادة الثانوية العامة" }
        ];
        const facSelect = document.getElementById('facultySelect');
        const facHint   = document.getElementById('facultyHint');
        faculties.forEach(f => {
            const o = document.createElement('option');
            o.value = f.name; o.textContent = f.name;
            facSelect.appendChild(o);
        });
        facSelect.addEventListener('change', function() {
            const f = faculties.find(x => x.name === this.value);
            facHint.textContent = f ? f.hint : '';
        });

        // ── Single visibility controller — reads both toggles and applies all rules
        function applyVisibility() {
            const isReturning = document.getElementById('tabReturning').checked;
            const isForeign   = document.getElementById('tabForeign').checked;

            // Student-type sections (not affected by nationality)
            document.getElementById('new-student-fields').style.display      = isReturning ? 'none'  : 'block';
            document.getElementById('returning-student-fields').style.display = isReturning ? 'block' : 'none';

            // Nationality sections (not affected by student type)
            document.getElementById('egyptian-fields').style.display = isForeign ? 'none' : 'block';
            document.getElementById('foreign-fields').style.display  = isForeign ? 'block' : 'none';
        }

        // ── Student type toggle (New / Returning)
        function toggleStudentType(isReturning) {
            document.getElementById('tabNewLabel').classList.toggle('active', !isReturning);
            document.getElementById('tabReturningLabel').classList.toggle('active', isReturning);
            document.getElementById('tabNew').checked = !isReturning;
            document.getElementById('tabReturning').checked = isReturning;
            document.getElementById('studentCodeDiv').style.display = isReturning ? 'block' : 'none';
            applyVisibility();
        }

        // ── Nationality toggle tab (مصري / وافد)
        function toggleNationalityTab(isForeign) {
            document.getElementById('tabEgyptianLabel').classList.toggle('active', !isForeign);
            document.getElementById('tabForeignLabel').classList.toggle('active', isForeign);
            document.getElementById('tabEgyptian').checked = !isForeign;
            document.getElementById('tabForeign').checked = isForeign;
            document.getElementById('nationalitySelect').value = isForeign ? '' : 'مصري';
            applyVisibility();
        }

        // ── Country "Other" free-text
        function toggleCountryOther(val) {
            document.getElementById('country-other-wrapper').style.display = val === 'OTHER' ? 'block' : 'none';
        }

        // ── Father deceased → show alternative guardian
        function toggleMotherFields() {
            const c = document.getElementById('isFatherDeceased').checked;
            document.getElementById('motherFields').style.display = c ? 'block' : 'none';
        }

        // ── Medical condition description
        function toggleMedicalDesc() {
            document.getElementById('medicalDescDiv').style.display =
                document.getElementById('medicalCheck').checked ? 'block' : 'none';
        }

        // ── Photo preview
        function previewPhoto(e) {
            const file = e.target.files[0];
            const preview = document.getElementById('photoPreview');
            const img     = document.getElementById('photoPreviewImg');
            if (file) {
                const reader = new FileReader();
                reader.onload = function(ev) { img.src = ev.target.result; preview.style.display = 'block'; };
                reader.readAsDataURL(file);
            } else {
                preview.style.display = 'none'; img.src = '';
            }
        }

        // ── Password strength meter
        function updateStrength(val) {
            const bars  = ['sb1','sb2','sb3','sb4'].map(id => document.getElementById(id));
            const label = document.getElementById('strengthLabel');
            const rules = {
                len:   val.length >= 8,
                upper: /[A-Z]/.test(val),
                num:   /[0-9]/.test(val),
                spec:  /[^A-Za-z0-9]/.test(val)
            };
            updateRule('r-len',   rules.len);
            updateRule('r-upper', rules.upper);
            updateRule('r-num',   rules.num);
            updateRule('r-spec',  rules.spec);

            const score  = Object.values(rules).filter(Boolean).length;
            const colors = ['', '#ef4444', '#f97316', '#eab308', '#10b981'];
            const labels = ['', 'ضعيفة', 'متوسطة', 'جيدة', 'قوية'];
            bars.forEach((b, i) => { b.style.background = i < score ? colors[score] : 'var(--border)'; });
            label.textContent = val.length ? labels[score] : '';
            label.style.color = colors[score] || 'var(--muted)';
        }

        function updateRule(id, passed) {
            const el = document.getElementById(id);
            el.style.color = passed ? '#10b981' : 'var(--muted)';
            el.querySelector('span').textContent = passed ? '✓' : '○';
        }

        // ── Submit loading state
        document.getElementById('applicationForm').addEventListener('submit', function() {
            const btn = document.getElementById('submitBtn');
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span> جاري الإرسال…';
        });
    </script>
</body>
</html>
