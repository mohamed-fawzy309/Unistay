@model ScanBookingResultViewModel
@{
    ViewData["Title"] = "نتيجة المسح";
    var mealTypes = ViewBag.MealTypes as List<string> ?? new();
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="page-title"><i class="bi bi-calendar-check"></i> نتيجة المسح</h2>
    <a asp-action="Index" class="btn btn-secondary"><i class="bi bi-arrow-right"></i> مسح جديد</a>
</div>

<div class="row">
    <div class="col-md-5">
        <div class="card">
            <div class="card-header bg-primary text-white"><h5 class="mb-0">معلومات الطالب</h5></div>
            <div class="card-body">
                <h5>@Model.StudentName</h5>
                <p class="text-muted mb-1">@Model.NationalID</p>
                <p class="text-muted">@Model.CityName</p>

                <div class="mt-3 p-3 rounded @(Model.IsEligible ? "bg-success-subtle" : "bg-danger-subtle")">
                    <h5 class="@(Model.IsEligible ? "text-success" : "text-danger")">@Model.EligibilityMessage</h5>
                    @if (!string.IsNullOrEmpty(Model.RestrictionReason))
                    {
                        <p class="text-muted mb-0">السبب: @Model.RestrictionReason</p>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-7">
        <div class="card">
            <div class="card-header bg-success text-white"><h5 class="mb-0">حجز وجبة جديدة</h5></div>
            <div class="card-body">
                <form asp-action="Book" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="StudentID" value="@Model.StudentID" />
                    <input type="hidden" name="ScanMethod" value="Barcode" />

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">نوع الوجبة</label>
                            <select name="MealType" class="form-select" required>
                                <option value="">-- اختر --</option>
                                @foreach (var mt in mealTypes)
                                {
                                    <option value="@mt">@mt</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">تاريخ الوجبة</label>
                            <input type="date" name="MealDate" class="form-control" value="@DateTime.Today.ToString("yyyy-MM-dd")" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">المدينة</label>
                            <select name="DormitoryCityID" class="form-select" id="citySelect" required>
                                <option value="">-- اختر --</option>
                            </select>
                        </div>
                        <div class="col-md-12 mt-3">
                            <button type="submit" class="btn btn-success btn-lg w-100" @(!Model.IsEligible ? "disabled" : "")>
                                <i class="bi bi-check-circle"></i> تأكيد الحجز
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        fetch('@Url.Action("GetStudentCity")?studentId=@Model.StudentID')
            .then(r => r.json())
            .then(data => {
                if (data.success) {
                    var sel = document.getElementById('citySelect');
                    var opt = document.createElement('option');
                    opt.value = data.cityId;
                    opt.text = 'المدينة المخصصة';
                    opt.selected = true;
                    sel.add(opt);
                }
            });
    </script>
}
