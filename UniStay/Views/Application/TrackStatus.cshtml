@{
    Layout = "_LoginLayout";
    ViewData["Title"] = "استعلام عن الطلب";
}
<div class="container mt-5" style="max-width:500px">
    <div class="card shadow">
        <div class="card-header bg-primary text-white">
            <h5><i class="bi bi-search"></i> استعلام عن حالة الطلب</h5>
        </div>
        <div class="card-body">
            <form method="post">
                <div class="mb-3">
                    <label class="form-label">الرقم القومي</label>
                    <input name="nationalId" class="form-control" maxlength="14">
                </div>
                <div class="text-center mb-3">أو</div>
                <div class="mb-3">
                    <label class="form-label">رقم الطلب</label>
                    <input name="appId" class="form-control" type="number">
                </div>
                <button class="btn btn-primary w-100">استعلام</button>
            </form>
            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger mt-3">@ViewBag.Error</div>
            }
        </div>
    </div>
</div>