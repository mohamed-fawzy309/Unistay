@model List<UniStay.Models.DormitoryCity>
@{
    ViewData["Title"] = "UniStay - المدن الجامعية";
    Layout = null;
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>UniStay — المدن الجامعية</title>
    <link href="~/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@300;400;500;700;800;900&display=swap" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet" />
    <style>
        :root {
            --red: #e63946;
            --red-dark: #b52530;
            --red-dim: rgba(230,57,70,.15);
            --black: #080b10;
            --black-2: #0f1319;
            --black-3: #161c26;
            --black-4: #1e2736;
            --border: #1e2736;
            --text: #e8eaf0;
            --muted: #6b7a99;
        }

        *, *::before, *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            font-family: 'Tajawal',sans-serif;
            background: var(--black);
            color: var(--text);
            overflow-x: hidden;
        }

        ::-webkit-scrollbar {
            width: 5px;
        }

        ::-webkit-scrollbar-track {
            background: var(--black);
        }

        ::-webkit-scrollbar-thumb {
            background: var(--red-dark);
            border-radius: 3px;
        }

        .navbar {
            background: rgba(8,11,16,.85);
            backdrop-filter: blur(16px);
            border-bottom: 1px solid rgba(230,57,70,.12);
            padding: .9rem 0;
            position: fixed;
            top: 0;
            width: 100%;
            z-index: 1000;
            transition: all .3s;
        }

            .navbar.scrolled {
                background: rgba(8,11,16,.97);
                box-shadow: 0 4px 30px rgba(0,0,0,.5);
            }

        .navbar-brand {
            font-size: 1.5rem;
            font-weight: 900;
            background: linear-gradient(135deg,#ff6b7a,var(--red));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .nav-link {
            color: var(--muted) !important;
            font-weight: 500;
            font-size: .9rem;
            transition: color .2s;
            padding: .4rem .9rem !important;
        }

            .nav-link:hover {
                color: #fff !important;
            }

        .btn-nav-login {
            background: transparent;
            border: 1px solid var(--red);
            color: var(--red) !important;
            border-radius: 8px;
            padding: .35rem 1.1rem !important;
            font-size: .88rem;
            font-weight: 600;
            transition: all .25s;
        }

            .btn-nav-login:hover {
                background: var(--red);
                color: #fff !important;
            }

        .btn-nav-reg {
            background: var(--red);
            border: 1px solid var(--red);
            color: #fff !important;
            border-radius: 8px;
            padding: .35rem 1.1rem !important;
            font-size: .88rem;
            font-weight: 600;
            transition: all .25s;
            margin-right: .4rem;
        }

            .btn-nav-reg:hover {
                background: var(--red-dark);
                border-color: var(--red-dark);
            }

        .page-hero {
            padding: 9rem 0 4rem;
            position: relative;
            overflow: hidden;
            background: linear-gradient(180deg,var(--black) 0%,var(--black-2) 100%);
        }

            .page-hero::before {
                content: '';
                position: absolute;
                inset: 0;
                background-image: linear-gradient(rgba(230,57,70,.04) 1px,transparent 1px),linear-gradient(90deg,rgba(230,57,70,.04) 1px,transparent 1px);
                background-size: 55px 55px;
            }

        .orb {
            position: absolute;
            border-radius: 50%;
            filter: blur(90px);
            pointer-events: none;
        }

        .o1 {
            width: 500px;
            height: 500px;
            background: rgba(230,57,70,.07);
            top: -150px;
            left: -100px;
        }

        .o2 {
            width: 350px;
            height: 350px;
            background: rgba(10,20,50,.4);
            bottom: -50px;
            right: -80px;
        }

        .page-hero-inner {
            position: relative;
            z-index: 2;
            text-align: center;
        }

        .section-tag {
            display: inline-block;
            background: var(--red-dim);
            border: 1px solid rgba(230,57,70,.2);
            color: var(--red);
            border-radius: 50px;
            padding: .3rem .9rem;
            font-size: .78rem;
            font-weight: 600;
            letter-spacing: .1em;
            text-transform: uppercase;
            margin-bottom: 1rem;
        }

        .page-title {
            font-size: clamp(2rem,5vw,3.2rem);
            font-weight: 900;
            margin-bottom: .8rem;
        }

            .page-title .red {
                background: linear-gradient(135deg,#ff6b7a,var(--red));
                -webkit-background-clip: text;
                -webkit-text-fill-color: transparent;
            }

        .page-sub {
            color: var(--muted);
            font-size: 1rem;
            max-width: 500px;
            margin: 0 auto;
            line-height: 1.8;
        }

        @@keyframes fadeUp {
            from {
                opacity: 0;
                transform: translateY(24px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .fade-up {
            animation: fadeUp .7s both;
        }

        .fade-up-2 {
            animation: fadeUp .7s .15s both;
        }

        .fade-up-3 {
            animation: fadeUp .7s .3s both;
        }

        .content-section {
            padding: 5rem 0;
        }

        /* FILTER ROW */
        .filter-row {
            display: flex;
            align-items: center;
            gap: .75rem;
            margin-bottom: 2.5rem;
            flex-wrap: wrap;
        }

        .filter-chip {
            display: inline-flex;
            align-items: center;
            gap: .4rem;
            background: transparent;
            border: 1px solid var(--border);
            color: var(--muted);
            border-radius: 8px;
            padding: .35rem .9rem;
            font-family: 'Tajawal',sans-serif;
            font-size: .82rem;
            font-weight: 600;
            cursor: pointer;
            text-decoration: none;
            transition: all .25s;
        }

            .filter-chip:hover, .filter-chip.active {
                background: var(--red-dim);
                border-color: rgba(230,57,70,.3);
                color: var(--red);
            }

        /* CITY CARD */
        .city-card {
            background: var(--black-3);
            border: 1px solid var(--border);
            border-radius: 20px;
            padding: 2rem;
            height: 100%;
            text-align: center;
            position: relative;
            overflow: hidden;
            transition: transform .3s,border-color .3s,box-shadow .3s;
        }

            .city-card::before {
                content: '';
                position: absolute;
                top: -40px;
                right: -40px;
                width: 120px;
                height: 120px;
                border-radius: 50%;
                background: rgba(230,57,70,.04);
                filter: blur(30px);
                pointer-events: none;
            }

            .city-card:hover {
                transform: translateY(-8px);
                border-color: rgba(230,57,70,.35);
                box-shadow: 0 24px 60px rgba(0,0,0,.45);
            }

        .city-icon {
            width: 60px;
            height: 60px;
            border-radius: 15px;
            background: var(--red-dim);
            border: 1px solid rgba(230,57,70,.2);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.5rem;
            color: var(--red);
            margin: 0 auto 1.25rem;
        }

        .city-name {
            font-size: 1.05rem;
            font-weight: 800;
            margin-bottom: .6rem;
        }

        .city-type {
            display: inline-block;
            background: rgba(255,255,255,.05);
            border: 1px solid var(--border);
            color: var(--muted);
            border-radius: 50px;
            padding: .2rem .75rem;
            font-size: .75rem;
            font-weight: 500;
        }

        .city-location {
            color: var(--muted);
            font-size: .8rem;
            margin-top: .6rem;
        }

        .city-stats {
            display: flex;
            justify-content: center;
            gap: 1.5rem;
            margin: 1.25rem 0;
            padding: 1rem 0;
            border-top: 1px solid var(--border);
            border-bottom: 1px solid var(--border);
        }

        .city-stat-num {
            font-size: 1.2rem;
            font-weight: 800;
            background: linear-gradient(135deg,#ff6b7a,var(--red));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            display: block;
        }

        .city-stat-lbl {
            color: var(--muted);
            font-size: .72rem;
        }

        .btn-city-details {
            display: inline-flex;
            align-items: center;
            gap: .4rem;
            background: transparent;
            border: 1px solid rgba(230,57,70,.3);
            color: var(--red);
            border-radius: 10px;
            padding: .5rem 1.2rem;
            font-family: 'Tajawal',sans-serif;
            font-size: .85rem;
            font-weight: 700;
            text-decoration: none;
            margin-top: .25rem;
            transition: all .25s;
        }

            .btn-city-details:hover {
                background: var(--red);
                color: #fff;
                border-color: var(--red);
            }

        /* EMPTY */
        .empty-state {
            text-align: center;
            padding: 5rem 2rem;
            background: var(--black-2);
            border: 1px dashed var(--border);
            border-radius: 20px;
        }

        .empty-icon {
            font-size: 3rem;
            color: var(--border);
            margin-bottom: 1rem;
        }

        .empty-title {
            font-size: 1.1rem;
            font-weight: 700;
            margin-bottom: .5rem;
        }

        .empty-text {
            color: var(--muted);
            font-size: .9rem;
        }

        .reveal {
            opacity: 0;
            transform: translateY(28px);
            transition: opacity .7s,transform .7s;
        }

            .reveal.visible {
                opacity: 1;
                transform: translateY(0);
            }

        footer {
            background: var(--black-2);
            border-top: 1px solid var(--border);
            padding: 2.5rem 0;
            text-align: center;
        }

        .footer-brand {
            font-size: 1.1rem;
            font-weight: 900;
            background: linear-gradient(135deg,#ff6b7a,var(--red));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            margin-bottom: .4rem;
        }

        .footer-text {
            color: var(--muted);
            font-size: .82rem;
        }
    </style>
</head>
<body>

    <!-- NAVBAR -->
    <nav class="navbar navbar-expand-lg">
        <div class="container">
            <a class="navbar-brand" href="/"><img src="~/images/Unistay_logo.png" alt="UniStay" style="height:48px;filter:drop-shadow(0 2px 8px rgba(230,57,70,.3))"></a>
            <div class="collapse navbar-collapse" id="nav">
                <ul class="navbar-nav mx-auto gap-1">
                    <li class="nav-item"><a class="nav-link" href="/Home/Announcements">الإعلانات</a></li>
                    <li class="nav-item"><a class="nav-link active" href="/Home/Cities" style="color:#fff!important">المدن الجامعية</a></li>
                    <li class="nav-item"><a class="nav-link" href="/#features">المميزات</a></li>
                    <li class="nav-item"><a class="nav-link" href="/#how">كيف يعمل</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Home/About">عن النظام</a></li>
                </ul>
                <div class="d-flex gap-2 mt-2 mt-lg-0">
                    <a href="/Home/Dates" class="nav-link btn-nav-login">مواعيد التقدم</a>
                    <a href="/Home/Accept" class="nav-link btn-nav-reg">استعلام عن القبول</a>
                </div>
            </div>
        </div>
    </nav>

    <!-- PAGE HERO -->
    <div class="page-hero">
        <div class="orb o1"></div>
        <div class="orb o2"></div>
        <div class="container">
            <div class="page-hero-inner">
                <div class="section-tag fade-up"><i class="fa-solid fa-location-dot" style="margin-left:.4rem"></i>الأماكن</div>
                <h1 class="page-title fade-up-2"><span class="red">المدن الجامعية</span></h1>
                <p class="page-sub fade-up-3">تعرّف على المدن الجامعية المتاحة واختر ما يناسبك</p>
            </div>
        </div>
    </div>

    <!-- CONTENT -->
    <section class="content-section">
        <div class="container">

            @if (Model != null && Model.Any())
            {
                <div class="filter-row reveal">
                    <a href="?type=" class="filter-chip active">
                        <i class="fa-solid fa-border-all"></i> عرض الكل
                    </a>
                    @foreach (var t in Model.Select(c => c.CityType).Distinct())
                    {
                        <a href="?type=@t" class="filter-chip">@t</a>
                    }
                    <span style="color:var(--muted);font-size:.82rem;margin-right:auto">
                        <i class="fa-solid fa-city" style="color:var(--red);margin-left:.35rem"></i>
                        @Model.Count مدينة جامعية
                    </span>
                </div>

                <div class="row g-4">
                    @foreach (var city in Model)
                    {
                        <div class="col-sm-6 col-lg-4 reveal">
                            <div class="city-card">
                                <div class="city-icon">
                                    <i class="fa-solid fa-building-columns"></i>
                                </div>
                                <div class="city-name">@city.Name</div>
                                <span class="city-type">@city.CityType</span>
                                @if (!string.IsNullOrEmpty(city.Location))
                                {
                                    <div class="city-location">
                                        <i class="fa-solid fa-location-dot" style="color:var(--red);margin-left:.3rem"></i>
                                        @city.Location
                                    </div>
                                }
                                <div class="city-stats">
                                    <div>
                                        <span class="city-stat-num">@city.CityBuildings.Count</span>
                                        <div class="city-stat-lbl">مبنى</div>
                                    </div>
                                    <div>
                                        <span class="city-stat-num">@city.CityBuildings.Sum(b => b.CityRooms.Count)</span>
                                        <div class="city-stat-lbl">غرفة</div>
                                    </div>
                                    <div>
                                        <span class="city-stat-num">@city.CityBuildings.Sum(b => b.CityRooms.Sum(r => r.BedsCount))</span>
                                        <div class="city-stat-lbl">سرير</div>
                                    </div>
                                </div>
                                <a asp-action="CityDetails" asp-route-id="@city.ID" class="btn-city-details">
                                    <i class="fa-solid fa-arrow-left" style="font-size:.75rem"></i>
                                    التفاصيل
                                </a>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="empty-state reveal">
                    <div class="empty-icon"><i class="fa-solid fa-building-columns"></i></div>
                    <div class="empty-title">لا توجد مدن جامعية متاحة</div>
                    <div class="empty-text">سيتم إضافة المدن الجامعية قريباً</div>
                </div>
            }

        </div>
    </section>

    <!-- FOOTER -->
    <footer>
        <div class="container">
            <div class="footer-brand">UniStay</div>
            <div class="footer-text"><span>نظام إدارة السكن الجامعي</span> &nbsp;·&nbsp; جميع الحقوق محفوظة &nbsp;·&nbsp; &copy; 2026</div>
        </div>
    </footer>

    <script src="/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        window.addEventListener('scroll', () => { document.querySelector('.navbar').classList.toggle('scrolled', scrollY > 40); });
        const ro = new IntersectionObserver(entries => { entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('visible'); ro.unobserve(e.target); } }); }, { threshold: .12 });
        document.querySelectorAll('.reveal').forEach((el, i) => { el.style.transitionDelay = (i % 4) * .08 + 's'; ro.observe(el); });
    </script>
</body>
</html>
