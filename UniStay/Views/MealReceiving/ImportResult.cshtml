@model ExcelImportResultViewModel
@{
    ViewData["Title"] = "نتيجة الاستيراد";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="page-title"><i class="bi bi-file-earmark-excel"></i> نتيجة استيراد الاستلام</h2>
    <a asp-action="Import" class="btn btn-secondary"><i class="bi bi-arrow-right"></i> استيراد جديد</a>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="stat-card bg-white">
            <div class="d-flex align-items-center gap-3">
                <div class="icon bg-success bg-opacity-10 text-success"><i class="bi bi-check-circle"></i></div>
                <div>
                    <div class="value">@Model.ImportedCount</div>
                    <div class="label">تم الاستيراد</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card bg-white">
            <div class="d-flex align-items-center gap-3">
                <div class="icon bg-danger bg-opacity-10 text-danger"><i class="bi bi-x-circle"></i></div>
                <div>
                    <div class="value">@Model.FailedCount</div>
                    <div class="label">فشل</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card bg-white">
            <div class="d-flex align-items-center gap-3">
                <div class="icon bg-warning bg-opacity-10 text-warning"><i class="bi bi-exclamation-triangle"></i></div>
                <div>
                    <div class="value">@Model.DuplicateCount</div>
                    <div class="label">مكرر</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card bg-white">
            <div class="d-flex align-items-center gap-3">
                <div class="icon bg-info bg-opacity-10 text-info"><i class="bi bi-list"></i></div>
                <div>
                    <div class="value">@Model.TotalRows</div>
                    <div class="label">إجمالي الصفوف</div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header bg-primary text-white"><h5 class="mb-0">تفاصيل الاستيراد</h5></div>
    <div class="card-body">
        <div class="table-responsive animate-fade-in">
            <table class="table table-striped table-hover mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>#</th>
                        <th>رقم الطالب</th>
                        <th>الرقم القومي</th>
                        <th>التاريخ</th>
                        <th>نوع الوجبة</th>
                        <th>الحالة</th>
                        <th>الرسالة</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var d in Model.Details)
                    {
                        <tr>
                            <td>@d.RowNumber</td>
                            <td>@d.StudentIDStr</td>
                            <td>@d.NationalID</td>
                            <td>@d.MealDate</td>
                            <td>@d.MealType</td>
                            <td>
                                @if (d.Status == "تم")
                                {
                                    <span class="badge bg-success">@d.Status</span>
                                }
                                else if (d.Status == "مكرر")
                                {
                                    <span class="badge bg-warning">@d.Status</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">@d.Status</span>
                                }
                            </td>
                            <td>@d.Message</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
