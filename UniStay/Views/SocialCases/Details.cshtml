@model SocialCaseDetailsVM
@{
    ViewData["Title"] = "تفاصيل حالة البحث الاجتماعي";
}

<div class="container-fluid" dir="rtl">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="mb-0"><i class="bi bi-search-heart"></i> تفاصيل حالة البحث الاجتماعي</h4>
        <div>
            <a asp-action="Edit" asp-route-id="@Model.CaseId" class="btn btn-primary btn-sm"><i class="bi bi-pencil"></i> تعديل</a>
            <a asp-action="Index" class="btn btn-outline-dark btn-sm"><i class="bi bi-arrow-right"></i> عودة</a>
        </div>
    </div>

    @if (Model.Status == "مفتوحة")
    {
        <form method="post" asp-action="StartInvestigation" asp-route-id="@Model.CaseId" class="d-inline">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-success btn-sm mb-2"><i class="bi bi-check-circle"></i> بدء التحقيق</button>
        </form>
    }

    @if (Model.Status == "قيد التحقيق")
    {
        <form method="post" asp-action="Close" asp-route-id="@Model.CaseId" class="d-inline">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-danger btn-sm mb-2"><i class="bi bi-x-circle"></i> إغلاق الحالة</button>
        </form>
    }

    @if (Model.Status == "مغلقة" || Model.Status == "مؤرشفة")
    {
        <form method="post" asp-action="ReOpen" asp-route-id="@Model.CaseId" class="d-inline">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-warning btn-sm mb-2"><i class="bi bi-arrow-counterclockwise"></i> إعادة فتح</button>
        </form>
    }

    <div class="row">
        <div class="col-md-6">
            <div class="card shadow-sm mb-3">
                <div class="card-header"><i class="bi bi-info-circle"></i> معلومات الحالة</div>
                <div class="card-body">
                    <table class="table table-sm table-borderless mb-0">
                        <tr><td style="width:120px;"><strong>نوع الحالة:</strong></td><td>@Model.CaseType</td></tr>
                        <tr><td><strong>الحالة:</strong></td><td>@Model.Status</td></tr>
                        <tr><td><strong>الأولوية:</strong></td>
                            <td>
                                <span class="badge @(Model.Priority == "عاجلة" ? "bg-danger" : Model.Priority == "عالية" ? "bg-warning text-dark" : Model.Priority == "متوسطة" ? "bg-info text-dark" : "bg-secondary")">
                                    @Model.Priority
                                </span>
                            </td>
                        </tr>
                        <tr><td><strong>المسؤول:</strong></td><td>@Model.AssignedTo</td></tr>
                        <tr><td><strong>تاريخ الإنشاء:</strong></td><td>@Model.CreatedAt?.ToString("yyyy/MM/dd HH:mm")</td></tr>
                        <tr><td><strong>تاريخ الإغلاق:</strong></td><td>@Model.ClosedAt?.ToString("yyyy/MM/dd HH:mm")</td></tr>
                    </table>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card shadow-sm mb-3">
                <div class="card-header"><i class="bi bi-person"></i> معلومات الطالب</div>
                <div class="card-body">
                    <table class="table table-sm table-borderless mb-0">
                        <tr><td style="width:120px;"><strong>الاسم:</strong></td><td>@Model.StudentName</td></tr>
                        <tr><td><strong>الرقم الجامعي:</strong></td><td>@Model.StudentCode</td></tr>
                        <tr><td><strong>الرقم القومي:</strong></td><td>@Model.NationalID</td></tr>
                        <tr><td><strong>الهاتف:</strong></td><td>@Model.StudentPhone</td></tr>
                        <tr><td colspan="2">
                            <a asp-controller="StudentProfiles" asp-action="Details" asp-route-id="@Model.StudentId" class="btn btn-outline-info btn-sm"><i class="bi bi-person-vcard"></i> عرض بيانات الطالب</a>
                        </td></tr>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm mb-3">
        <div class="card-header"><i class="bi bi-file-text"></i> وصف الحالة</div>
        <div class="card-body">
            <p class="mb-0">@Model.Description</p>
        </div>
    </div>
</div>
