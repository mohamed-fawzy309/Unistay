@model List<UniStay.ViewModels.Admin.StudentRowViewModel>
@{
    ViewData["Title"] = "الطلاب";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>الطلاب</h2>
</div>

<form method="get" class="row g-2 mb-3 bg-white p-3 rounded shadow-sm">
    <div class="col-md-4">
        <input type="text" name="search" class="form-control" placeholder="بحث بالاسم أو الرقم القومي..." value="@Context.Request.Query["search"]">
    </div>
    <div class="col-md-2">
        <select name="faculty" class="form-select" onchange="this.form.submit()">
            <option value="">كل الكليات</option>
            @foreach (var f in ViewBag.Faculties ?? new List<string>())
            {
                <option value="@f" selected="@(Context.Request.Query["faculty"] == f)">@f</option>
            }
        </select>
    </div>
    <div class="col-md-2">
        <select name="gender" class="form-select" onchange="this.form.submit()">
            <option value="">الكل</option>
            <option value="Male" selected="@(Context.Request.Query["gender"] == "Male")">ذكر</option>
            <option value="Female" selected="@(Context.Request.Query["gender"] == "Female")">أنثى</option>
        </select>
    </div>
    <div class="col-md-2">
        <button type="submit" class="btn btn-primary w-100">بحث</button>
    </div>
    <div class="col-md-2">
        <a asp-action="Students" class="btn btn-secondary w-100">إعادة تعيين</a>
    </div>
</form>

<div class="table-responsive bg-white rounded shadow-sm">
    <table class="table table-hover mb-0">
        <thead class="table-dark">
            <tr>
                <th>#</th>
                <th>الاسم</th>
                <th>الرقم القومي</th>
                <th>النوع</th>
                <th>الكلية</th>
                <th>الفرقة</th>
                <th>التليفون</th>
                <th>البريد</th>
                <th>آخر حالة</th>
                <th>تاريخ التسجيل</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var s in Model)
            {
                <tr>
                    <td>@s.ID</td>
                    <td>@s.FullName</td>
                    <td>@s.NationalID</td>
                    <td>@(s.Gender == "Male" ? "ذكر" : "أنثى")</td>
                    <td>@s.Faculty</td>
                    <td>@s.AcademicYear</td>
                    <td>@s.Phone</td>
                    <td>@s.Email</td>
                    <td>
                        <span class="badge bg-@(s.LatestApplicationStatus switch { "Pending" => "secondary", "UnderReview" => "primary", "Accepted" => "success", "Rejected" => "danger", "Allocated" => "dark", _ => "light" })">
                            @(s.LatestApplicationStatus ?? "لا يوجد")
                        </span>
                    </td>
                    <td>@s.CreatedAt.ToString("yyyy-MM-dd")</td>
                    <td>
                        <a asp-action="StudentDetails" asp-route-id="@s.ID" class="btn btn-info btn-sm">تفاصيل</a>
                    </td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr><td colspan="11" class="text-center text-muted py-4">لا يوجد طلاب</td></tr>
            }
        </tbody>
    </table>
</div>

@if (ViewBag.TotalPages > 1)
{
    <nav class="mt-3">
        <ul class="pagination justify-content-center">
            @for (int i = 1; i <= ViewBag.TotalPages; i++)
            {
                <li class="page-item @(i == ViewBag.Page ? "active" : "")">
                    <a class="page-link" href="@Url.Action("Students", new { page = i, search = Context.Request.Query["search"], faculty = Context.Request.Query["faculty"], gender = Context.Request.Query["gender"] })">@i</a>
                </li>
            }
        </ul>
    </nav>
}
