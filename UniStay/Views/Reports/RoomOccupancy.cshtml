@model UniStay.ViewModels.Reports.RoomOccupancyReportViewModel
@{
    ViewData["Title"] = "تقرير إشغال الغرف";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="page-title">تقرير إشغال الغرف</h2>
    <div class="btn-group">
        <a href="@Url.Action("RoomOccupancyExportExcel", new { cityId = Model.Filter.CityID, buildingId = Model.Filter.BuildingID, floor = Model.Filter.Floor, status = Model.Filter.Status })" class="btn btn-success"><i class="bi bi-file-earmark-excel"></i> Excel</a>
        <a href="@Url.Action("RoomOccupancyExportPdf", new { cityId = Model.Filter.CityID, buildingId = Model.Filter.BuildingID, floor = Model.Filter.Floor, status = Model.Filter.Status })" class="btn btn-danger"><i class="bi bi-file-earmark-pdf"></i> PDF</a>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="stat-card bg-white">
            <div class="d-flex align-items-center gap-3">
                <div class="icon bg-primary bg-opacity-10 text-primary"><i class="bi bi-door-open"></i></div>
                <div>
                    <div class="value">@Model.TotalRooms</div>
                    <div class="label">إجمالي الغرف</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card bg-white">
            <div class="d-flex align-items-center gap-3">
                <div class="icon bg-info bg-opacity-10 text-info"><i class="bi bi-bed"></i></div>
                <div>
                    <div class="value">@Model.TotalBeds</div>
                    <div class="label">إجمالي الأسرة</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card bg-white">
            <div class="d-flex align-items-center gap-3">
                <div class="icon bg-danger bg-opacity-10 text-danger"><i class="bi bi-person-fill"></i></div>
                <div>
                    <div class="value">@Model.OccupiedBeds</div>
                    <div class="label">أسرة مشغولة</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card bg-white">
            <div class="d-flex align-items-center gap-3">
                <div class="icon bg-success bg-opacity-10 text-success"><i class="bi bi-person-plus"></i></div>
                <div>
                    <div class="value">@Model.AvailableBeds</div>
                    <div class="label">أسرة متاحة</div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-12">
        <div class="stat-card bg-white">
            <div class="d-flex align-items-center gap-3">
                <div class="icon bg-secondary bg-opacity-10 text-secondary"><i class="bi bi-pie-chart"></i></div>
                <div class="flex-grow-1">
                    <div class="label mb-1">نسبة الإشغال</div>
                    <div class="d-flex align-items-center gap-3">
                        <div class="flex-grow-1">
                            <div class="progress" style="height: 24px;">
                                <div class="progress-bar @(Model.OccupancyRate < 50 ? "bg-success" : Model.OccupancyRate <= 80 ? "bg-warning" : "bg-danger")" role="progressbar" style="width: @Model.OccupancyRate%">@Model.OccupancyRate.ToString("N1")%</div>
                            </div>
                        </div>
                        <span class="badge bg-@(Model.OccupancyRate < 50 ? "success" : Model.OccupancyRate <= 80 ? "warning" : "danger") fs-6">@Model.OccupancyRate.ToString("N1")%</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<form method="get" class="filter-bar row g-2 mb-3">
    <div class="col-md-3">
        <label class="form-label small">المدينة</label>
        <select name="cityId" class="form-select" onchange="this.form.submit()">
            <option value="">الكل</option>
            @foreach (var c in Model.Cities)
            {
                <option value="@c.ID" selected="@(Model.Filter.CityID == c.ID)">@c.Name</option>
            }
        </select>
    </div>
    <div class="col-md-3">
        <label class="form-label small">المبنى</label>
        <select name="buildingId" class="form-select" onchange="this.form.submit()">
            <option value="">الكل</option>
            @foreach (var b in Model.Buildings)
            {
                <option value="@b.ID" selected="@(Model.Filter.BuildingID == b.ID)">@b.Name</option>
            }
        </select>
    </div>
    <div class="col-md-3">
        <label class="form-label small">الدور</label>
        <input type="text" name="floor" class="form-control" placeholder="رقم الدور..." value="@Model.Filter.Floor">
    </div>
    <div class="col-md-3 d-flex align-items-end">
        <a asp-action="RoomOccupancy" class="btn btn-secondary w-100">إعادة تعيين</a>
    </div>
</form>

<div class="table-responsive bg-white rounded shadow-sm animate-fade-in">
    <table class="table table-hover mb-0">
        <thead class="table-dark">
            <tr>
                <th>المدينة</th>
                <th>المبنى</th>
                <th>رقم الغرفة</th>
                <th>الدور</th>
                <th>النوع</th>
                <th>عدد الأسرة</th>
                <th>المشغول حالياً</th>
                <th>المتاح</th>
                <th>نسبة الإشغال</th>
                <th>الحالة</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var r in Model.Rooms)
            {
                var rowClass = r.OccupancyPercent < 50 ? "table-success" : r.OccupancyPercent <= 80 ? "table-warning" : "table-danger";
                <tr class="@rowClass">
                    <td>@r.CityName</td>
                    <td>@r.BuildingName</td>
                    <td class="fw-semibold">@r.RoomNumber</td>
                    <td>@r.FloorNumber</td>
                    <td>@r.RoomType</td>
                    <td>@r.BedsCount</td>
                    <td>@r.CurrentOccupancy</td>
                    <td>@r.AvailableBeds</td>
                    <td>
                        <div class="d-flex align-items-center gap-2">
                            <div class="progress flex-grow-1" style="height: 16px;">
                                <div class="progress-bar @(r.OccupancyPercent < 50 ? "bg-success" : r.OccupancyPercent <= 80 ? "bg-warning" : "bg-danger")" role="progressbar" style="width: @r.OccupancyPercent%"></div>
                            </div>
                            <small class="fw-bold">@r.OccupancyPercent.ToString("N1")%</small>
                        </div>
                    </td>
                    <td>
                        <span class="badge bg-@(r.Status switch { "Active" => "success", "Maintenance" => "warning", "Inactive" => "secondary", _ => "light" })">
                            @(r.Status switch { "Active" => "نشط", "Maintenance" => "صيانة", "Inactive" => "غير نشط", _ => r.Status })
                        </span>
                    </td>
                </tr>
            }
            @if (!Model.Rooms.Any())
            {
                <tr><td colspan="10" class="text-center text-muted py-4">لا توجد غرف</td></tr>
            }
        </tbody>
    </table>
</div>

@if (Model.TotalPages > 1)
{
    <nav class="mt-3">
        <ul class="pagination pagination-modern justify-content-center">
            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(i == Model.Page ? "active" : "")">
                    <a class="page-link" href="@Url.Action("RoomOccupancy", new { page = i, cityId = Model.Filter.CityID, buildingId = Model.Filter.BuildingID, floor = Model.Filter.Floor, status = Model.Filter.Status })">@i</a>
                </li>
            }
        </ul>
    </nav>
}
