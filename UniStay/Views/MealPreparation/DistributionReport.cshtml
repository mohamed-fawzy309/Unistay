@model DistributionReportViewModel
@{
    ViewData["Title"] = "تقرير التوزيع";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="page-title"><i class="bi bi-truck"></i> تقرير التوزيع</h2>
    <div>
        <a asp-action="ExportDistributionReportExcel" asp-route-date="@Model.ReportDate.ToString("yyyy-MM-dd")" class="btn btn-success"><i class="bi bi-file-earmark-excel"></i> إكسل</a>
        <a asp-action="Index" asp-route-date="@Model.ReportDate.ToString("yyyy-MM-dd")" class="btn btn-secondary"><i class="bi bi-arrow-right"></i> رجوع</a>
    </div>
</div>

<p class="text-muted">تاريخ التقرير: @Model.ReportDate.ToString("yyyy-MM-dd")</p>

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="stat-card bg-white">
            <div class="d-flex align-items-center gap-3">
                <div class="icon bg-info bg-opacity-10 text-info"><i class="bi bi-cup-hot"></i></div>
                <div>
                    <div class="value">@Model.TotalPrepared</div>
                    <div class="label">إجمالي المعد</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="stat-card bg-white">
            <div class="d-flex align-items-center gap-3">
                <div class="icon bg-success bg-opacity-10 text-success"><i class="bi bi-check-circle"></i></div>
                <div>
                    <div class="value">@Model.TotalDistributed</div>
                    <div class="label">تم التوزيع</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="stat-card bg-white">
            <div class="d-flex align-items-center gap-3">
                <div class="icon bg-warning bg-opacity-10 text-warning"><i class="bi bi-clock"></i></div>
                <div>
                    <div class="value">@Model.TotalPending</div>
                    <div class="label">قيد الانتظار</div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header bg-warning text-white"><h5 class="mb-0">التوزيع حسب المدينة</h5></div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-striped">
                <thead class="table-dark">
                    <tr>
                        <th>المدينة</th>
                        <th>عدد المعد</th>
                        <th>تم التوزيع</th>
                        <th>المتبقي</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in Model.CitySummaries)
                    {
                        <tr>
                            <td>@c.CityName</td>
                            <td>@c.PreparedCount</td>
                            <td>@c.DistributedCount</td>
                            <td>@c.PendingCount</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
