@model UniStay.ViewModels.Attendance.MonitoringDashboardViewModel
@{
    ViewData["Title"] = "مراقبة API";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="page-title">مراقبة API التعرف على الوجه</h2>
    <a asp-action="Monitoring" class="btn btn-outline-primary btn-sm"><i class="bi bi-arrow-clockwise"></i> تحديث</a>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-3 col-6">
        <div class="card border-0 shadow-sm">
            <div class="card-body text-center">
                <div class="stat-icon bg-success-subtle text-success rounded-circle mx-auto mb-2">
                    <i class="bi bi-check-circle fs-4"></i>
                </div>
                <h6 class="text-muted small">نجاح التعرف</h6>
                <h3 class="mb-0 fw-bold text-success">@Model.SuccessCount</h3>
            </div>
        </div>
    </div>
    <div class="col-md-3 col-6">
        <div class="card border-0 shadow-sm">
            <div class="card-body text-center">
                <div class="stat-icon bg-danger-subtle text-danger rounded-circle mx-auto mb-2">
                    <i class="bi bi-x-circle fs-4"></i>
                </div>
                <h6 class="text-muted small">فشل التعرف</h6>
                <h3 class="mb-0 fw-bold text-danger">@Model.FailedCount</h3>
            </div>
        </div>
    </div>
    <div class="col-md-3 col-6">
        <div class="card border-0 shadow-sm">
            <div class="card-body text-center">
                <div class="stat-icon bg-warning-subtle text-warning rounded-circle mx-auto mb-2">
                    <i class="bi bi-files fs-4"></i>
                </div>
                <h6 class="text-muted small">محاولات مكررة</h6>
                <h3 class="mb-0 fw-bold text-warning">@Model.DuplicateCount</h3>
            </div>
        </div>
    </div>
    <div class="col-md-3 col-6">
        <div class="card border-0 shadow-sm">
            <div class="card-body text-center">
                <div class="stat-icon bg-info-subtle text-info rounded-circle mx-auto mb-2">
                    <i class="bi bi-clock-history fs-4"></i>
                </div>
                <h6 class="text-muted small">إجمالي اليوم</h6>
                <h3 class="mb-0 fw-bold text-info">@(Model.SuccessCount + Model.FailedCount + Model.DuplicateCount)</h3>
            </div>
        </div>
    </div>
</div>

@if (Model.LastErrorMessage != null)
{
    <div class="alert alert-danger">
        <strong>آخر خطأ:</strong> @Model.LastErrorMessage
        @if (Model.LastErrorTime.HasValue)
        {
            <small class="d-block text-muted">@Model.LastErrorTime.Value.ToString("yyyy-MM-dd HH:mm:ss")</small>
        }
    </div>
}

<div class="card border-0 shadow-sm">
    <div class="card-header bg-transparent d-flex justify-content-between align-items-center">
        <span class="fw-bold">سجل API اليوم</span>
    </div>
    <div class="card-body">
        <div class="table-responsive" style="max-height: 500px; overflow-y: auto;">
            <table class="table table-sm table-hover mb-0">
                <thead class="table-dark sticky-top">
                    <tr>
                        <th>#</th>
                        <th>الطالب</th>
                        <th>الحالة</th>
                        <th>الرسالة</th>
                        <th>الوقت</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.RecentLogs.Count == 0)
                    {
                        <tr>
                            <td colspan="5" class="text-center text-muted py-4">لا توجد سجلات اليوم</td>
                        </tr>
                    }
                    @foreach (var log in Model.RecentLogs.Select((l, i) => new { l, i }))
                    {
                        <tr>
                            <td>@(log.i + 1)</td>
                            <td>@(log.l.StudentID?.ToString() ?? "-")</td>
                            <td>
                                <span class="badge @(log.l.Status == "Success" ? "bg-success" : log.l.Status == "Failed" ? "bg-danger" : "bg-warning text-dark")">
                                    @log.l.Status
                                </span>
                            </td>
                            <td class="small">@log.l.Message</td>
                            <td class="small">@log.l.CreatedAt?.ToString("HH:mm:ss")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
