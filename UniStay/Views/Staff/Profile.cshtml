@model UniStay.ViewModels.Staff.StaffProfileViewModel
@{
    ViewData["Title"] = "الملف الشخصي";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="page-title">الملف الشخصي</h2>
</div>

<div class="row g-3">
    <div class="col-md-4">
        <div class="card border-0 shadow-sm animate-fade-in text-center">
            <div class="card-body py-5">
                <div class="bg-primary bg-opacity-10 text-primary rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width:100px;height:100px;">
                    <i class="bi bi-person" style="font-size:3rem;"></i>
                </div>
                <h5 class="fw-bold">@Model.Name</h5>
                <p class="text-muted small mb-1">@Model.Email</p>
                <p class="text-muted small mb-0">@Model.Phone</p>
                @if (Model.LastLoginAt.HasValue)
                {
                    <p class="text-muted small mt-2">
                        <i class="bi bi-clock"></i> آخر دخول: @Model.LastLoginAt.Value.ToString("g")
                    </p>
                }
            </div>
        </div>
    </div>

    <div class="col-md-8">
        <div class="card border-0 shadow-sm animate-fade-in">
            <div class="card-header bg-white py-3">
                <h5 class="fw-bold mb-0">معلومات الحساب</h5>
            </div>
            <div class="card-body">
                <div class="row mb-3">
                    <label class="col-sm-4 fw-semibold text-muted">الاسم</label>
                    <div class="col-sm-8">@Model.Name</div>
                </div>
                <div class="row mb-3">
                    <label class="col-sm-4 fw-semibold text-muted">البريد الإلكتروني</label>
                    <div class="col-sm-8">@Model.Email</div>
                </div>
                <div class="row mb-3">
                    <label class="col-sm-4 fw-semibold text-muted">رقم الهاتف</label>
                    <div class="col-sm-8">@Model.Phone</div>
                </div>
                <div class="row mb-3">
                    <label class="col-sm-4 fw-semibold text-muted">الرقم القومي</label>
                    <div class="col-sm-8">@Model.NationalID</div>
                </div>
                <hr>
                <h6 class="fw-bold mb-3">المدن المسندة</h6>
                @if (Model.AssignedCities.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>المدينة</th>
                                    <th>النوع</th>
                                    <th>الدور</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var city in Model.AssignedCities)
                                {
                                    <tr>
                                        <td>@city.CityName</td>
                                        <td>@city.CityType</td>
                                        <td><span class="badge @(city.IsPrimary ? "bg-success" : "bg-secondary")">@(city.IsPrimary ? "رئيسي" : city.RoleInCity)</span></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <p class="text-muted">لم يتم إسناد أي مدينة</p>
                }
            </div>
        </div>
    </div>
</div>
