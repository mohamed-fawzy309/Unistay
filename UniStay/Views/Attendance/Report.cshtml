@model UniStay.ViewModels.Attendance.AttendanceReportViewModel
@{
    ViewData["Title"] = "تقرير الحضور والغياب";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="page-title">تقرير الحضور والغياب</h2>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">@TempData["Success"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">@TempData["Error"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
}

<div asp-validation-summary="ModelOnly" class="alert alert-danger d-none"></div>

<form method="get" class="filter-bar row g-2 mb-3">
    <div class="col-md-2">
        <label class="form-label small">من تاريخ</label>
        <input type="date" name="fromDate" class="form-control" value="@Model.FromDate?.ToString("yyyy-MM-dd")" onchange="this.form.submit()">
    </div>
    <div class="col-md-2">
        <label class="form-label small">إلى تاريخ</label>
        <input type="date" name="toDate" class="form-control" value="@Model.ToDate?.ToString("yyyy-MM-dd")" onchange="this.form.submit()">
    </div>
    <div class="col-md-2">
        <label class="form-label small">المدينة</label>
        <select name="dormitoryCityId" class="form-select" onchange="this.form.submit()">
            <option value="">الكل</option>
            @foreach (var city in Model.Cities)
            {
                <option value="@city.ID" selected="@(Model.DormitoryCityID == city.ID)">@city.Name</option>
            }
        </select>
    </div>
    <div class="col-md-2">
        <label class="form-label small">رقم الطالب</label>
        <input type="number" name="studentId" class="form-control" value="@Model.StudentID" onchange="this.form.submit()" placeholder="كود الطالب">
    </div>
    <div class="col-md-2 d-flex align-items-end">
        <a asp-action="Report" class="btn btn-secondary w-100">إعادة تعيين</a>
    </div>
</form>

<div class="table-responsive bg-white rounded shadow-sm animate-fade-in">
    <table class="table table-hover mb-0">
        <thead class="table-dark">
            <tr>
                <th>#</th>
                <th>الطالب</th>
                <th>الرقم القومي</th>
                <th>التاريخ</th>
                <th>إلى تاريخ</th>
                <th>النوع</th>
                <th>الحالة</th>
                <th>ولي الأمر</th>
                <th>السبب</th>
                <th>تمت المراجعة بواسطة</th>
                <th>تاريخ الإضافة</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var rec in Model.Records)
            {
                <tr>
                    <td>@rec.ID</td>
                    <td>@rec.StudentName</td>
                    <td>@rec.NationalID</td>
                    <td>@rec.AbsenceDate.ToString("yyyy-MM-dd")</td>
                    <td>@rec.ToDate?.ToString("yyyy-MM-dd")</td>
                    <td>
                        <span class="badge-@(rec.AbsenceType == "Absence" ? "warning" : "info")">
                            @(rec.AbsenceType == "Absence" ? "غياب" : "إذن")
                        </span>
                    </td>
                    <td>
                        <span class="badge-@(rec.Status switch { "Approved" => "success", "Pending" => "warning", "Rejected" => "danger", "Expired" => "secondary", _ => "secondary" })">
                            @(rec.Status switch { "Approved" => "موافق", "Pending" => "معلق", "Rejected" => "مرفوض", "Expired" => "منتهي", _ => rec.Status })
                        </span>
                    </td>
                    <td>@rec.GuardianName</td>
                    <td>@rec.Reason</td>
                    <td>@rec.ReviewedByName</td>
                    <td>@rec.CreatedAt?.ToString("yyyy-MM-dd")</td>
                </tr>
            }
            @if (!Model.Records.Any())
            {
                <tr><td colspan="11" class="text-center text-muted py-4">لا توجد سجلات</td></tr>
            }
        </tbody>
    </table>
</div>

@if (Model.TotalPages > 1)
{
    <nav class="mt-3">
        <ul class="pagination pagination-modern justify-content-center">
            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(i == Model.Page ? "active" : "")">
                    <a class="page-link" href="@Url.Action("Report", new { page = i, fromDate = Model.FromDate?.ToString("yyyy-MM-dd"), toDate = Model.ToDate?.ToString("yyyy-MM-dd"), dormitoryCityId = Model.DormitoryCityID, studentId = Model.StudentID })">@i</a>
                </li>
            }
        </ul>
    </nav>
}
