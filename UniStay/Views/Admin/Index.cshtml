@{
    ViewData["Title"] = "لوحة التحكم";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>لوحة التحكم</h2>
    <span class="text-muted">@DateTime.Now.ToString("dddd, d MMMM yyyy")</span>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card border-0 shadow-sm bg-primary text-white">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <h6 class="card-title mb-1">الطلبات المعلقة</h6>
                    <h3 class="mb-0">@ViewBag.PendingCount</h3>
                </div>
                <i class="bi bi-inbox fs-1 opacity-50"></i>
            </div>
            <a asp-action="PendingApplications" class="card-footer text-white text-center text-decoration-none small bg-dark bg-opacity-10">عرض الكل</a>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm bg-success text-white">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <h6 class="card-title mb-1">إجمالي الطلاب</h6>
                    <h3 class="mb-0">@ViewBag.StudentCount</h3>
                </div>
                <i class="bi bi-people fs-1 opacity-50"></i>
            </div>
            <a asp-action="Students" class="card-footer text-white text-center text-decoration-none small bg-dark bg-opacity-10">عرض الكل</a>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm bg-warning text-white">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <h6 class="card-title mb-1">المقيمون حالياً</h6>
                    <h3 class="mb-0">@ViewBag.AllocatedCount</h3>
                </div>
                <i class="bi bi-house-check fs-1 opacity-50"></i>
            </div>
            <a asp-action="Students" class="card-footer text-white text-center text-decoration-none small bg-dark bg-opacity-10">عرض الكل</a>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm bg-info text-white">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <h6 class="card-title mb-1">المدن الجامعية</h6>
                    <h3 class="mb-0">@ViewBag.CityCount</h3>
                </div>
                <i class="bi bi-building fs-1 opacity-50"></i>
            </div>
            <a asp-action="Cities" class="card-footer text-white text-center text-decoration-none small bg-dark bg-opacity-10">إدارة المدن</a>
        </div>
    </div>
</div>

<div class="row g-3">
    <div class="col-md-6">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white">
                <h5 class="mb-0">إجراءات سريعة</h5>
            </div>
            <div class="card-body">
                <div class="list-group list-group-flush">
                    <a asp-action="PendingApplications" class="list-group-item list-group-item-action d-flex align-items-center gap-3">
                        <i class="bi bi-list-check fs-4 text-primary"></i>
                        <span>مراجعة الطلبات المعلقة</span>
                    </a>
                    <a asp-action="Students" class="list-group-item list-group-item-action d-flex align-items-center gap-3">
                        <i class="bi bi-people fs-4 text-success"></i>
                        <span>إدارة الطلاب</span>
                    </a>
                    <a asp-action="Announcements" class="list-group-item list-group-item-action d-flex align-items-center gap-3">
                        <i class="bi bi-megaphone fs-4 text-warning"></i>
                        <span>إضافة إعلان جديد</span>
                    </a>
                    <a asp-action="Schedules" class="list-group-item list-group-item-action d-flex align-items-center gap-3">
                        <i class="bi bi-calendar-event fs-4 text-info"></i>
                        <span>إدارة مواعيد التقديم</span>
                    </a>
                    <a asp-action="BuildingLayout" class="list-group-item list-group-item-action d-flex align-items-center gap-3">
                        <i class="bi bi-map fs-4 text-danger"></i>
                        <span>الكروكي التفاعلي للمباني</span>
                    </a>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white">
                <h5 class="mb-0">آخر الطلبات</h5>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>الطالب</th>
                                <th>الحالة</th>
                                <th>التاريخ</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (ViewBag.LatestApplications != null)
                            {
                                foreach (var app in ViewBag.LatestApplications)
                                {
                                    <tr>
                                        <td>@app.StudentName</td>
                                        <td>
                                            <span class="badge bg-@(app.Status switch { "Pending" => "secondary", "UnderReview" => "primary", "Accepted" => "success", "Rejected" => "danger", "Allocated" => "dark", _ => "light" })">
                                                @app.Status
                                            </span>
                                        </td>
                                        <td>@app.CreatedAt.ToString("yyyy-MM-dd")</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
