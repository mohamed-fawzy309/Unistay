@model UniStay.ViewModels.Application.ApplicationViewModel
@{
    ViewData["Title"] = "تقديم طلب سكن جامعي - UniStay";
    Layout = null;
}

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>تقديم طلب سكن جامعي — UniStay</title>
    <link href="~/lib/bootstrap/dist/css/bootstrap.rtl.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@300;400;500;700;800;900&display=swap" rel="stylesheet" />
    <style>
        :root {
            --red: #e63946; --red-dark: #b52530; --red-dim: rgba(230,57,70,.15);
            --black: #080b10; --black-2: #0f1319; --black-3: #161c26; --black-4: #1e2736;
            --border: #1e2736; --text: #e8eaf0; --muted: #6b7a99;
            --success: #10b981; --success-dim: rgba(16,185,129,.15);
            --warn: #f59e0b; --danger: #ef4444;
        }
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body { font-family: 'Tajawal', sans-serif; background: var(--black); color: var(--text); overflow-x: hidden; }
        ::-webkit-scrollbar { width: 5px; }
        ::-webkit-scrollbar-track { background: var(--black); }
        ::-webkit-scrollbar-thumb { background: var(--red-dark); border-radius: 3px; }

        .navbar {
            background: rgba(8,11,16,.85); backdrop-filter: blur(16px);
            border-bottom: 1px solid rgba(230,57,70,.12);
            padding: .9rem 0; position: fixed; top: 0; width: 100%; z-index: 1000;
        }
        .navbar-brand {
            font-size: 1.5rem; font-weight: 900;
            background: linear-gradient(135deg,#ff6b7a,var(--red));
            -webkit-background-clip: text; -webkit-text-fill-color: transparent;
            text-decoration: none;
        }
        .nav-link { color: var(--muted) !important; font-weight: 500; font-size: .9rem; transition: color .2s; padding: .4rem .9rem !important; text-decoration: none; }
        .nav-link:hover { color: #fff !important; }

        .page-header { padding: 7rem 0 2rem; text-align: center; position: relative; }
        .page-header::before {
            content: ''; position: absolute; inset: 0;
            background-image: linear-gradient(rgba(230,57,70,.05) 1px, transparent 1px),
                linear-gradient(90deg, rgba(230,57,70,.05) 1px, transparent 1px);
            background-size: 55px 55px;
        }
        .page-header-content { position: relative; z-index: 2; }
        .page-title { font-size: 2.2rem; font-weight: 900; margin-bottom: .5rem; }
        .page-title span { background: linear-gradient(135deg,#ff6b7a,var(--red)); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
        .page-sub { color: var(--muted); font-size: 1rem; max-width: 600px; margin: 0 auto; line-height: 1.8; }

        .section { padding: 2rem 0 4rem; }

        .form-card {
            background: var(--black-2); border: 1px solid var(--border);
            border-radius: 18px; padding: 2rem; margin-bottom: 1.5rem;
            transition: border-color .3s;
        }
        .form-card:hover { border-color: rgba(230,57,70,.2); }
        .form-card-header {
            display: flex; align-items: center; gap: .75rem;
            font-size: 1.1rem; font-weight: 800; margin-bottom: 1.5rem;
            padding-bottom: .75rem; border-bottom: 1px solid var(--border);
        }
        .form-card-header i { color: var(--red); font-size: 1.2rem; width: 1.5rem; text-align: center; }
        .step-badge {
            display: inline-flex; align-items: center; justify-content: center;
            width: 28px; height: 28px; border-radius: 50%;
            background: var(--red-dim); border: 1px solid rgba(230,57,70,.3);
            color: var(--red); font-size: .8rem; font-weight: 800;
            margin-left: .5rem;
        }

        .field-label {
            display: block; font-size: .82rem; font-weight: 700;
            color: var(--muted); margin-bottom: .4rem;
        }
        .field-label .required { color: var(--red); margin-right: .1rem; }
        .field-label .hint { font-weight: 400; font-size: .75rem; color: var(--muted); margin-right: .3rem; }

        .form-control, .form-select {
            background: var(--black-3); border: 1.5px solid var(--border);
            border-radius: 10px; color: var(--text);
            font-family: 'Tajawal', sans-serif; font-size: .95rem;
            padding: .75rem 1rem; transition: border-color .25s, box-shadow .25s;
        }
        .form-control:focus, .form-select:focus {
            border-color: rgba(230,57,70,.55); box-shadow: 0 0 0 3px var(--red-dim);
            background: var(--black-3); color: var(--text);
        }
        .form-control::placeholder { color: #4a5568; font-size: .85rem; }
        .form-select option { background: var(--black-3); color: var(--text); }
        .form-control.is-invalid, .form-select.is-invalid {
            border-color: var(--danger); box-shadow: 0 0 0 3px rgba(239,68,68,.12);
        }
        .text-danger { color: var(--danger) !important; font-size: .8rem; margin-top: .2rem; display: block; }
        .text-muted-small { color: var(--muted); font-size: .75rem; margin-top: .2rem; display: block; }

        .instructions-box {
            background: rgba(16,185,129,.08); border: 1px solid rgba(16,185,129,.2);
            border-radius: 12px; padding: 1rem 1.25rem;
            display: flex; align-items: flex-start; gap: .75rem;
            margin-bottom: 1.5rem;
        }
        .instructions-box i { color: var(--success); font-size: 1.1rem; margin-top: .1rem; }
        .instructions-box p { color: var(--success); font-size: .85rem; line-height: 1.7; margin: 0; }

        .alert-validation {
            background: rgba(239,68,68,.1); border: 1px solid rgba(239,68,68,.25);
            border-radius: 12px; padding: .9rem 1.1rem;
            display: flex; align-items: flex-start; gap: .7rem; margin-bottom: 1.5rem;
        }
        .alert-validation i { color: var(--danger); font-size: 1rem; margin-top: .1rem; }
        .alert-validation ul { color: var(--danger); font-size: .85rem; margin: 0; padding-right: 1.2rem; }
        .alert-validation li { margin-bottom: .2rem; }

        /* ── Sub-section (from Register style) ── */
        .sub-section {
            background: rgba(230,57,70,.04);
            border: 1px dashed rgba(230,57,70,.2);
            border-radius: 12px;
            padding: 1.2rem 1.3rem;
            margin-top: 1rem;
        }
        .sub-section-title {
            font-size: .78rem; font-weight: 700; color: var(--red);
            letter-spacing: 1px; text-transform: uppercase;
            margin-bottom: .9rem; display: flex; align-items: center; gap: .5rem;
        }
        .sub-section-title::before {
            content: ''; width: 16px; height: 2px;
            background: var(--red); border-radius: 2px;
        }

        /* ── Password strength ── */
        .strength-bar { flex: 1; height: 4px; border-radius: 4px; background: var(--border); transition: background .3s; }
        .pass-rule { font-size: .78rem; color: var(--muted); display: flex; align-items: center; gap: .4rem; }

        .btn-submit {
            background: linear-gradient(135deg, var(--red), var(--red-dark));
            border: none; color: #fff; border-radius: 12px;
            padding: 1rem 2.5rem; font-family: 'Tajawal', sans-serif;
            font-size: 1.05rem; font-weight: 700; cursor: pointer;
            display: inline-flex; align-items: center; gap: .7rem;
            position: relative; overflow: hidden;
            transition: transform .2s, box-shadow .2s;
        }
        .btn-submit::before {
            content: ''; position: absolute; top: 0; left: -100%; width: 60%; height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255,255,255,.2), transparent);
            transition: left .5s;
        }
        .btn-submit:hover::before { left: 150%; }
        .btn-submit:hover { transform: translateY(-2px); box-shadow: 0 10px 30px rgba(230,57,70,.4); color: #fff; }
        .btn-submit:disabled { opacity: .6; cursor: not-allowed; transform: none; box-shadow: none; }

        .form-check-input { background: var(--black-3); border: 1.5px solid var(--border); cursor: pointer; }
        .form-check-input:checked { background: var(--red); border-color: var(--red); }
        .form-check-label { color: var(--text); font-size: .9rem; }

        .declaration-box {
            background: var(--black-3); border: 1px solid var(--border);
            border-radius: 12px; padding: 1rem 1.25rem;
        }

        .tab-btn-group { display: flex; gap: 0; margin-bottom: 1.5rem; }
        .tab-btn {
            flex: 1; padding: .7rem 1rem;
            background: var(--black-3); border: 1.5px solid var(--border);
            color: var(--muted); font-family: 'Tajawal', sans-serif;
            font-size: .9rem; font-weight: 600; cursor: pointer;
            transition: all .25s; text-align: center;
        }
        .tab-btn:first-child { border-radius: 0 10px 10px 0; }
        .tab-btn:last-child { border-radius: 10px 0 0 10px; }
        .tab-btn.active { background: var(--red-dim); border-color: rgba(230,57,70,.4); color: var(--red); }
        .tab-btn:hover:not(.active) { background: var(--black-4); }

        footer {
            background: var(--black-2); border-top: 1px solid var(--border);
            padding: 2rem 0; text-align: center;
        }
        .footer-brand {
            font-size: 1.1rem; font-weight: 900;
            background: linear-gradient(135deg,#ff6b7a,var(--red));
            -webkit-background-clip: text; -webkit-text-fill-color: transparent;
            margin-bottom: .4rem;
        }
        .footer-text { color: var(--muted); font-size: .82rem; }
        .footer-text span { color: var(--red); }

        @@media (max-width: 768px) {
            .page-title { font-size: 1.6rem; }
            .form-card { padding: 1.25rem; }
        }
    </style>
</head>
<body>

    <nav class="navbar">
        <div class="container d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center gap-3">
                <button class="btn btn-sm btn-outline-secondary" onclick="history.back()" title="رجوع" style="border-color:var(--border);color:var(--muted)">
                    <i class="fa-solid fa-arrow-right"></i>
                </button>
                <a href="/" class="nav-link"><i class="fa-solid fa-house" style="margin-left:.3rem"></i>الرئيسية</a>
            </div>
            <a class="navbar-brand" href="/"><img src="~/images/Unistay_logo.png" alt="UniStay" style="height:45px"></a>
        </div>
    </nav>

    <section class="page-header">
        <div class="container page-header-content">
            <h1 class="page-title">تقديم طلب <span>السكن الجامعي</span></h1>
            <p class="page-sub">املأ البيانات التالية بعناية. جميع الحقول ذات العلامة <span style="color:var(--red)">*</span> إلزامية.</p>
        </div>
    </section>

    <section class="section">
        <div class="container">

            <form asp-action="Apply" method="post" id="applicationForm" enctype="multipart/form-data" novalidate>
                @Html.AntiForgeryToken()

                @* Validation Summary *@
                @if (!ViewData.ModelState.IsValid)
                {
                    var errors = ViewData.ModelState.Values.SelectMany(v => v.Errors).Select(e => e.ErrorMessage).ToList();
                    if (errors.Any())
                    {
                        <div class="alert-validation">
                            <i class="fa-solid fa-circle-exclamation"></i>
                            <div>
                                <strong style="color:var(--danger);font-size:.9rem">يُرجى تصحيح الأخطاء التالية:</strong>
                                <ul>
                                    @foreach (var err in errors)
                                    {
                                        <li>@err</li>
                                    }
                                </ul>
                            </div>
                        </div>
                    }
                }

                @* ── STEP 1: Student Type ── *@
                <div class="form-card">
                    <div class="form-card-header">
                        <span class="step-badge">1</span>
                        نوع التقديم
                    </div>
                    <div class="instructions-box">
                        <i class="fa-solid fa-circle-info"></i>
                        <p>اختر "طالب جديد" إذا كنت تتقدم لأول مرة، أو "طالب مستمر" إذا كنت مسجلاً في الأعوام السابقة وتريد تجديد السكن.</p>
                    </div>
                    <div class="tab-btn-group">
                        <input type="radio" name="IsReturningStudent" id="tabNew" value="false" checked hidden>
                        <input type="radio" name="IsReturningStudent" id="tabReturning" value="true" hidden>
                        <label class="tab-btn active" id="tabNewLabel" for="tabNew" onclick="toggleStudentType(false)">
                            <i class="fa-solid fa-user-plus me-1"></i> طالب جديد
                        </label>
                        <label class="tab-btn" id="tabReturningLabel" for="tabReturning" onclick="toggleStudentType(true)">
                            <i class="fa-solid fa-rotate me-1"></i> طالب مستمر
                        </label>
                    </div>

                    <div class="instructions-box mt-3">
                        <i class="fa-solid fa-circle-info"></i>
                        <p>اختر "مصري" إذا كنت تحمل الجنسية المصرية، أو "وافد" إذا كنت من جنسية أخرى.</p>
                    </div>
                    <div class="tab-btn-group">
                        <input type="radio" name="NationalityToggle" id="tabEgyptian" value="Egyptian" checked hidden>
                        <input type="radio" name="NationalityToggle" id="tabForeign" value="Foreign" hidden>
                        <label class="tab-btn active" id="tabEgyptianLabel" for="tabEgyptian" onclick="toggleNationalityTab(false)">
                            <i class="fa-solid fa-flag me-1"></i> مصري
                        </label>
                        <label class="tab-btn" id="tabForeignLabel" for="tabForeign" onclick="toggleNationalityTab(true)">
                            <i class="fa-solid fa-globe me-1"></i> وافد
                        </label>
                    </div>
                </div>

                @* ── STEP 2: Personal Data ── *@
                <div class="form-card">
                    <div class="form-card-header">
                        <span class="step-badge">2</span>
                        <i class="fa-solid fa-user"></i>
                        البيانات الشخصية
                    </div>
                    <div class="instructions-box">
                        <i class="fa-solid fa-circle-info"></i>
                        <p>تأكد من كتابة الاسم الرباعي كما هو في الوثائق الرسمية. الرقم القومي يجب أن يكون 14 رقماً بالضبط.</p>
                    </div>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="FullName" class="field-label">
                                الاسم الرباعي <span class="required">*</span>
                            </label>
                            <input asp-for="FullName" class="form-control" placeholder="الاسم كما في شهادة الميلاد" />
                            <span asp-validation-for="FullName" class="text-danger"></span>
                        </div>
                        <div class="col-md-3">
                            <label asp-for="Gender" class="field-label">النوع <span class="required">*</span></label>
                            <select asp-for="Gender" class="form-select">
                                <option value="">-- اختر --</option>
                                <option value="Male">ذكر</option>
                                <option value="Female">أنثى</option>
                            </select>
                            <span asp-validation-for="Gender" class="text-danger"></span>
                        </div>
                        <div class="col-md-3">
                            <label asp-for="Religion" class="field-label">الديانة <span class="required">*</span></label>
                            <select asp-for="Religion" class="form-select">
                                <option value="">-- اختر --</option>
                                <option value="Muslim">مسلم</option>
                                <option value="Christian">مسيحي</option>
                            </select>
                            <span asp-validation-for="Religion" class="text-danger"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="BirthDate" class="field-label">تاريخ الميلاد <span class="required">*</span></label>
                            <input asp-for="BirthDate" class="form-control" id="birthDate" placeholder="اختر تاريخ الميلاد" />
                            <span asp-validation-for="BirthDate" class="text-danger"></span>
                        </div>
                        <div class="col-md-4">
                            <label class="field-label">محل الميلاد</label>
                            <input asp-for="BirthPlace" class="form-control" placeholder="المحافظة / المدينة" />
                        </div>
                        <div class="col-md-4">
                            <label class="field-label">العمر <span class="hint">— يحسب تلقائياً</span></label>
                            <input type="text" id="calculatedAge" class="form-control" readonly style="background:var(--black-4);color:var(--success)" placeholder="--" />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Phone" class="field-label">رقم التليفون <span class="required">*</span></label>
                            <input asp-for="Phone" class="form-control" placeholder="01xxxxxxxxx" maxlength="11" oninput="this.value=this.value.replace(/\D/g,'')" />
                            <span asp-validation-for="Phone" class="text-danger"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Email" class="field-label">البريد الإلكتروني <span class="required">*</span></label>
                            <input asp-for="Email" type="email" class="form-control" placeholder="example@domain.com" />
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Nationality" class="field-label">الجنسية <span class="required">*</span></label>
                            <select asp-for="Nationality" class="form-select" id="nationalitySelect">
                                <option value="">-- اختر الجنسية --</option>
                                <option value="مصري">🇪🇬 مصري</option>
                                <option value="سعودي">🇸🇦 سعودي</option>
                                <option value="ليبي">🇱🇾 ليبي</option>
                                <option value="سوداني">🇸🇩 سوداني</option>
                                <option value="يمني">🇾🇪 يمني</option>
                                <option value="سوري">🇸🇾 سوري</option>
                                <option value="عراقي">🇮🇶 عراقي</option>
                                <option value="أردني">🇯🇴 أردني</option>
                                <option value="فلسطيني">🇵🇸 فلسطيني</option>
                                <option value="مغربي">🇲🇦 مغربي</option>
                                <option value="تونسي">🇹🇳 تونسي</option>
                                <option value="جزائري">🇩🇿 جزائري</option>
                                <option value="كويتي">🇰🇼 كويتي</option>
                                <option value="قطري">🇶🇦 قطري</option>
                                <option value="إماراتي">🇦🇪 إماراتي</option>
                                <option value="بحاريني">🇧🇪 بحريني</option>
                                <option value="عماني">🇴🇲 عماني</option>
                                <option value="لبناني">🇱🇧 لبناني</option>
                                <option value="ليبي">🇱🇾 ليبي</option>
                                <option value="موريتاني">🇲🇷 موريتاني</option>
                                <option value="صومالي">🇸🇴 صومالي</option>
                                <option value="جيبوتي">🇩🇯 جيبوتي</option>
                                <option value="أفغاني">🇦🇫 أفغاني</option>
                                <option value="أمريكي">🇺🇸 أمريكي</option>
                                <option value="بريطاني">🇬🇧 بريطاني</option>
                                <option value="فرنسي">🇫🇷 فرنسي</option>
                                <option value="ألماني">🇩🇪 ألماني</option>
                                <option value="إيطالي">🇮🇹 إيطالي</option>
                                <option value="إسباني">🇪🇸 إسباني</option>
                                <option value="تركي">🇹🇷 تركي</option>
                                <option value="هندي">🇮🇳 هندي</option>
                                <option value="صيني">🇨🇳 صيني</option>
                                <option value="باكستاني">🇵🇰 باكستاني</option>
                                <option value="ماليزي">🇲🇾 ماليزي</option>
                                <option value="إندونيسي">🇮🇩 إندونيسي</option>
                                <option value="نيجيري">🇳🇬 نيجيري</option>
                                <option value="أخرى">🌍 أخرى</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Governorate" class="field-label">المحافظة <span class="required">*</span></label>
                            <select asp-for="Governorate" class="form-select" id="governorateSelect">
                                <option value="">-- اختر المحافظة --</option>
                            </select>
                            <span asp-validation-for="Governorate" class="text-danger"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Markaz" class="field-label">المركز <span class="required">*</span></label>
                            <select asp-for="Markaz" class="form-select" id="markazSelect">
                                <option value="">-- اختر المركز --</option>
                            </select>
                            <span asp-validation-for="Markaz" class="text-danger"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="City" class="field-label">القرية / المدينة <span class="required">*</span></label>
                            <select asp-for="City" class="form-select" id="villageSelect">
                                <option value="">-- اختر القرية --</option>
                            </select>
                            <span asp-validation-for="City" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Address" class="field-label">العنوان بالتفصيل <span class="required">*</span></label>
                            <textarea asp-for="Address" class="form-control" rows="2" placeholder="الشارع، الرقم، المنطقة…"></textarea>
                            <span asp-validation-for="Address" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                @* ── STEP 3: Private Data (Egyptian / Foreign toggle) ── *@
                <div class="form-card">
                    <div class="form-card-header">
                        <span class="step-badge">3</span>
                        <i class="fa-solid fa-id-card"></i>
                        البيانات الخاصة
                    </div>

                    @* ── Egyptian Fields ── *@
                    <div id="egyptian-fields">
                        <div class="instructions-box">
                            <i class="fa-solid fa-circle-info"></i>
                            <p>أدخل الرقم القومي المكون من 14 رقم. بيانات الأب إلزامية للمصريين.</p>
                        </div>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="NationalID" class="field-label">
                                    الرقم القومي <span class="required">*</span>
                                    <span class="hint">— 14 رقم</span>
                                </label>
