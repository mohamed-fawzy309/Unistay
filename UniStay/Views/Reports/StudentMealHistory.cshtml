@model UniStay.ViewModels.Reports.StudentMealHistoryViewModel
@{
    ViewData["Title"] = "سجل الوجبات";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="page-title">سجل الوجبات</h2>
    <a asp-action="StudentMealHistoryExportExcel" asp-route-studentId="@Model.Filter.StudentID" asp-route-cityId="@Model.Filter.CityID" asp-route-mealType="@Model.Filter.MealType" asp-route-fromDate="@Model.Filter.FromDate?.ToString("yyyy-MM-dd")" asp-route-toDate="@Model.Filter.ToDate?.ToString("yyyy-MM-dd")" asp-route-search="@Model.Filter.Search" class="btn btn-success"><i class="bi bi-file-earmark-excel"></i> Excel</a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">@TempData["Success"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">@TempData["Error"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
}

<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="stat-card bg-white">
            <div class="d-flex align-items-center gap-3">
                <div class="icon bg-info bg-opacity-10 text-info"><i class="bi bi-egg-fried"></i></div>
                <div>
                    <div class="value">@Model.TotalMeals</div>
                    <div class="label">إجمالي الوجبات</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card bg-white">
            <div class="d-flex align-items-center gap-3">
                <div class="icon bg-success bg-opacity-10 text-success"><i class="bi bi-check-circle"></i></div>
                <div>
                    <div class="value">@Model.TotalConsumed</div>
                    <div class="label">تم الاستلام</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card bg-white">
            <div class="d-flex align-items-center gap-3">
                <div class="icon bg-danger bg-opacity-10 text-danger"><i class="bi bi-x-circle"></i></div>
                <div>
                    <div class="value">@Model.TotalCancelled</div>
                    <div class="label">ملغاة</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card bg-white">
            <div class="d-flex align-items-center gap-3">
                <div class="icon bg-warning bg-opacity-10 text-warning"><i class="bi bi-cash"></i></div>
                <div>
                    <div class="value">@Model.TotalSpent.ToString("N2")</div>
                    <div class="label">إجمالي المدفوعات</div>
                </div>
            </div>
        </div>
    </div>
</div>

<form method="get" class="filter-bar row g-2 mb-3">
    <input type="hidden" name="studentId" value="@Model.Filter.StudentID" />
    <div class="col-md-3">
        <label class="form-label small">المدينة</label>
        <select name="cityId" class="form-select" onchange="this.form.submit()">
            <option value="">الكل</option>
            @foreach (var c in Model.Cities)
            {
                <option value="@c.ID" selected="@(Model.Filter.CityID == c.ID)">@c.Name</option>
            }
        </select>
    </div>

    <div class="col-md-3">
        <label class="form-label small">من تاريخ</label>
        <input type="date" name="fromDate" class="form-control" value="@Model.Filter.FromDate?.ToString("yyyy-MM-dd")" onchange="this.form.submit()">
    </div>
    <div class="col-md-3">
        <label class="form-label small">إلى تاريخ</label>
        <input type="date" name="toDate" class="form-control" value="@Model.Filter.ToDate?.ToString("yyyy-MM-dd")" onchange="this.form.submit()">
    </div>
    <div class="col-md-3">
        <label class="form-label small">بحث</label>
        <input type="text" name="search" class="form-control" placeholder="اسم الطالب..." value="@Model.Filter.Search">
    </div>
    <div class="col-md-3 d-flex align-items-end">
        <a asp-action="StudentMealHistory" class="btn btn-secondary w-100">إعادة تعيين</a>
    </div>
</form>

<div class="table-responsive bg-white rounded shadow-sm animate-fade-in">
    <table class="table table-hover mb-0">
        <thead class="table-dark">
            <tr>
                <th>الطالب</th>
                <th>الرقم القومي</th>
                <th>المدينة</th>
                <th>التاريخ</th>
                <th>نوع الوجبة</th>
                <th>السعر</th>
                <th>الحالة</th>
                <th>وقت المسح</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var m in Model.Meals)
            {
                <tr>
                    <td class="fw-semibold">@m.StudentName</td>
                    <td>@m.NationalID</td>
                    <td>@(m.CityName ?? "—")</td>
                    <td><small>@m.MealDate.ToString("yyyy/MM/dd")</small></td>
                    <td>وجبة يومية</td>
                    <td>@m.Price?.ToString("N2")</td>
                    <td>
                        <span class="badge bg-@(m.Status switch { "Consumed" => "success", "Cancelled" => "secondary", _ => "secondary" })">@m.StatusDisplay</span>
                    </td>
                    <td><small>@m.ScannedAt?.ToString("yyyy/MM/dd HH:mm")</small></td>
                </tr>
            }
            @if (!Model.Meals.Any())
            {
                <tr><td colspan="8" class="text-center text-muted py-4">لا توجد بيانات</td></tr>
            }
        </tbody>
    </table>
</div>

@if (Model.TotalPages > 1)
{
    <nav class="mt-3">
        <ul class="pagination pagination-modern justify-content-center">
            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(i == Model.Page ? "active" : "")">
                    <a class="page-link" asp-action="StudentMealHistory" asp-route-page="@i" asp-route-studentId="@Model.Filter.StudentID" asp-route-cityId="@Model.Filter.CityID" asp-route-mealType="@Model.Filter.MealType" asp-route-fromDate="@Model.Filter.FromDate?.ToString("yyyy-MM-dd")" asp-route-toDate="@Model.Filter.ToDate?.ToString("yyyy-MM-dd")" asp-route-search="@Model.Filter.Search">@i</a>
                </li>
            }
        </ul>
    </nav>
}
