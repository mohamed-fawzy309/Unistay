@model ExcelImportViewModel
@{
    ViewData["Title"] = "استلام وجبات من إكسل";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="page-title"><i class="bi bi-file-earmark-excel"></i> استلام وجبات من إكسل</h2>
</div>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">@TempData["Error"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
}

<div class="card">
    <div class="card-header bg-primary text-white"><h5 class="mb-0">رفع ملف Excel</h5></div>
    <div class="card-body">
        <p class="text-muted">صيغة الملف: رقم الطالب | الرقم القومي | التاريخ | نوع الوجبة</p>
        <form asp-action="Import" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label">المدينة</label>
                    <select name="DormitoryCityID" class="form-select" required>
                        <option value="">-- اختر المدينة --</option>
                        @foreach (var c in Model.Cities)
                        {
                            <option value="@c.ID">@c.Name</option>
                        }
                    </select>
                </div>
                <div class="col-md-6">
                    <label class="form-label">ملف Excel</label>
                    <input type="file" name="ExcelFile" class="form-control" accept=".xlsx" required>
                </div>
                <div class="col-md-2 d-flex align-items-end">
                    <button type="submit" class="btn btn-primary w-100"><i class="bi bi-upload"></i> رفع</button>
                </div>
            </div>
        </form>
    </div>
</div>
