@model List<UniStay.ViewModels.Admin.AppConfigViewModel>
@{
    ViewData["Title"] = "إعدادات التطبيق";
    var categories = ViewBag.Categories as List<string> ?? new();
    var currentCategory = Context.Request.Query["category"].FirstOrDefault();
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="page-title">إعدادات التطبيق</h2>
    <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addModal">
        <i class="bi bi-plus-circle"></i> إضافة إعداد
    </button>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show animate-fade-in">@TempData["Success"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show animate-fade-in">@TempData["Error"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
}

<div class="filter-bar row g-2 mb-3">
    <div class="col-md-4">
        <form method="get" class="d-flex gap-2">
            <select name="category" class="form-select" onchange="this.form.submit()">
                <option value="">جميع التصنيفات</option>
                @foreach (var cat in categories)
                {
                    <option value="@cat" selected="@(currentCategory == cat)">@cat</option>
                }
            </select>
            @if (!string.IsNullOrEmpty(currentCategory))
            {
                <a asp-action="AppConfig" class="btn btn-secondary">إعادة تعيين</a>
            }
        </form>
    </div>
</div>

<div class="table-responsive">
    <table class="table table-hover table-bordered bg-white animate-fade-in">
        <thead class="table-light">
            <tr>
                <th>#</th>
                <th>المفتاح</th>
                <th>القيمة</th>
                <th>الوصف</th>
                <th>التصنيف</th>
                <th>الحالة</th>
                <th>إجراءات</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Any())
            {
                int i = 1;
                foreach (var item in Model)
                {
                    <tr>
                        <td>@(i++)</td>
                        <td><code>@item.ConfigKey</code></td>
                        <td style="max-width:300px;word-break:break-all">@item.ConfigValue</td>
                        <td>@item.Description</td>
                        <td><span class="badge bg-info">@item.Category</span></td>
                        <td><span class="badge @(item.IsActive ? "bg-success" : "bg-secondary")">@(item.IsActive ? "نشط" : "غير نشط")</span></td>
                        <td>
                            <button class="btn btn-outline-warning btn-sm" data-bs-toggle="modal" data-bs-target="#editModal-@item.ID">
                                <i class="bi bi-pencil"></i> تعديل
                            </button>
                        </td>
                    </tr>

                    <div class="modal fade" id="editModal-@item.ID" tabindex="-1" aria-hidden="true">
                        <div class="modal-dialog modal-dialog-centered">
                            <form asp-action="EditAppConfig" method="post" class="modal-content">
                                <input type="hidden" name="ID" value="@item.ID">
                                <div class="modal-header">
                                    <h5 class="modal-title fw-bold">تعديل @item.ConfigKey</h5>
                                    <button type="button" class="btn-close m-0 ms-auto" data-bs-dismiss="modal"></button>
                                </div>
                                <div class="modal-body">
                                    <div class="mb-3">
                                        <label class="form-label fw-semibold">القيمة <span class="text-danger">*</span></label>
                                        @if (item.ConfigValue?.Length > 100)
                                        {
                                            <textarea name="ConfigValue" class="form-control" rows="3" required>@item.ConfigValue</textarea>
                                        }
                                        else
                                        {
                                            <input name="ConfigValue" class="form-control" value="@item.ConfigValue" required>
                                        }
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label fw-semibold">الوصف</label>
                                        <textarea name="Description" class="form-control" rows="2">@item.Description</textarea>
                                    </div>
                                    <div class="form-check form-switch">
                                        <input name="IsActive" class="form-check-input" type="checkbox" value="true" checked="@item.IsActive" id="ac-active-@item.ID">
                                        <label class="form-check-label" for="ac-active-@item.ID">نشط</label>
                                    </div>
                                </div>
                                <div class="modal-footer">
                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إلغاء</button>
                                    <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> حفظ</button>
                                </div>
                            </form>
                        </div>
                    </div>
                }
            }
            else
            {
                <tr><td colspan="7" class="text-center py-4 text-muted">لا توجد إعدادات مضافة بعد</td></tr>
            }
        </tbody>
    </table>
</div>

<div class="modal fade" id="addModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <form asp-action="AppConfig" method="post" class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title fw-bold">إضافة إعداد</h4>
                <button type="button" class="btn-close m-0 ms-auto" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label fw-semibold">المفتاح <span class="text-danger">*</span></label>
                    <input name="ConfigKey" class="form-control" placeholder="مثال: MaxStudentsPerRoom" required>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">القيمة <span class="text-danger">*</span></label>
                    <input name="ConfigValue" class="form-control" required>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">الوصف</label>
                    <textarea name="Description" class="form-control" rows="2"></textarea>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">التصنيف</label>
                    <input name="Category" class="form-control" placeholder="مثال: General, Housing, Fees">
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إلغاء</button>
                <button type="submit" class="btn btn-primary"><i class="bi bi-plus-lg"></i> إضافة</button>
            </div>
        </form>
    </div>
</div>
