@model CoordinationResultsViewModel
@{
    ViewData["Title"] = "نتائج التنسيق";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-table"></i> نتائج التنسيق</h2>
    </div>

    <form method="get" class="row mb-4">
        <div class="col-md-4">
            <select name="cityId" class="form-select" onchange="this.form.submit()">
                @foreach (var c in (IEnumerable<UniStay.Models.DormitoryCity>)ViewBag.Cities)
                {
                    <option value="@c.ID" selected="@(c.ID == Model.DormitoryCityID ? true : null)">@c.Name</option>
                }
            </select>
        </div>
    </form>

    @if (Model.Total > 0)
    {
        <div class="row mb-4">
            <div class="col-md-3">
                <div class="card border-primary">
                    <div class="card-body text-center">
                        <h6>الإجمالي</h6>
                        <h3>@Model.Total</h3>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-success">
                    <div class="card-body text-center">
                        <h6>مقبول</h6>
                        <h3 class="text-success">@Model.AcceptedCount</h3>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-warning">
                    <div class="card-body text-center">
                        <h6>انتظار</h6>
                        <h3 class="text-warning">@Model.WaitlistCount</h3>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-danger">
                    <div class="card-body text-center">
                        <h6>مرفوض</h6>
                        <h3 class="text-danger">@Model.RejectedCount</h3>
                    </div>
                </div>
            </div>
        </div>

        <div class="card">
            <div class="card-body">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>الاسم</th>
                            <th>الرقم القومي</th>
                            <th>الكلية</th>
                            <th>الدرجة</th>
                            <th>الترتيب</th>
                            <th>الحالة</th>
                            <th>تاريخ المعالجة</th>
                            <th>إجراءات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in Model.Results)
                        {
                            <tr>
                                <td>@r.ID</td>
                                <td>@r.StudentName</td>
                                <td>@r.NationalID</td>
                                <td>@r.Faculty</td>
                                <td>@r.TotalScore?.ToString("N2")</td>
                                <td>@r.Rank</td>
                                <td>
                                    @switch (r.Status)
                                    {
                                        case "Accepted": <span class="badge bg-success">مقبول</span>; break;
                                        case "Waitlist": <span class="badge bg-warning">انتظار</span>; break;
                                        case "Rejected": <span class="badge bg-danger">مرفوض</span>; break;
                                        default: <span class="badge bg-secondary">@r.Status</span>; break;
                                    }
                                </td>
                                <td>@r.ProcessedAt?.ToString("yyyy/MM/dd")</td>
                                <td>
                                    <button class="btn btn-sm btn-outline-warning" onclick="loadOverride(@r.ID)" title="تعديل يدوي للدرجات">
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

                @if (Model.TotalPages > 1)
                {
                    <nav>
                        <ul class="pagination">
                            @for (int i = 1; i <= Model.TotalPages; i++)
                            {
                                <li class="page-item @(i == Model.Page ? "active" : "")">
                                    <a class="page-link" href="@Url.Action("Results", new { cityId = Model.DormitoryCityID, page = i })">@i</a>
                                </li>
                            }
                        </ul>
                    </nav>
                }
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-info">لا توجد نتائج تنسيق بعد</div>
    }
</div>

<!-- Manual Override Modal -->
<div class="modal fade" id="overrideModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">تعديل درجات التنسيق يدوياً</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p class="mb-1"><strong id="ovStudent"></strong> <small id="ovNationalID" class="text-muted"></small></p>
                <p class="text-muted small" id="ovFaculty"></p>
                <hr />
                <form id="overrideForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="ovId" name="ID" />
                    <div class="row mb-2">
                        <div class="col-6">
                            <label>درجة المسافة</label>
                            <input type="number" step="0.01" class="form-control" id="ovDistance" name="DistanceScore" />
                        </div>
                        <div class="col-6">
                            <label>الدرجة الأكاديمية</label>
                            <input type="number" step="0.01" class="form-control" id="ovGrade" name="GradeScore" />
                        </div>
                    </div>
                    <div class="row mb-2">
                        <div class="col-6">
                            <label>درجة العمر</label>
                            <input type="number" step="0.01" class="form-control" id="ovAge" name="AgeScore" />
                        </div>
                        <div class="col-6">
                            <label>مكافأة خاصة</label>
                            <input type="number" step="0.01" class="form-control" id="ovBonus" name="SpecialBonus" />
                        </div>
                    </div>
                    <div class="row mb-2">
                        <div class="col-6">
                            <label>المجموع</label>
                            <input type="text" class="form-control" id="ovTotal" readonly />
                        </div>
                        <div class="col-6">
                            <label>الترتيب</label>
                            <input type="text" class="form-control" id="ovRank" readonly />
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إلغاء</button>
                <button type="button" class="btn btn-warning" onclick="saveOverride()"><i class="bi bi-save"></i> حفظ التعديلات</button>
            </div>
        </div>
    </div>
</div>

<script>
    function loadOverride(id) {
        fetch('/Coordination/ManualOverride?id=' + id)
            .then(r => r.json())
            .then(resp => {
                if (!resp.success) { alert(resp.message); return; }
                var d = resp.data;
                document.getElementById('ovId').value = d.id;
                document.getElementById('ovStudent').textContent = d.studentName;
                document.getElementById('ovNationalID').textContent = d.nationalID;
                document.getElementById('ovFaculty').textContent = d.faculty;
                document.getElementById('ovDistance').value = d.distanceScore;
                document.getElementById('ovGrade').value = d.gradeScore;
                document.getElementById('ovAge').value = d.ageScore;
                document.getElementById('ovBonus').value = d.specialBonus;
                document.getElementById('ovTotal').value = d.totalScore;
                document.getElementById('ovRank').value = d.rank;
                var modal = new bootstrap.Modal(document.getElementById('overrideModal'));
                modal.show();
            });
    }

    function saveOverride() {
        var data = {
            ID: parseInt(document.getElementById('ovId').value),
            DistanceScore: parseFloat(document.getElementById('ovDistance').value) || 0,
            GradeScore: parseFloat(document.getElementById('ovGrade').value) || 0,
            AgeScore: parseFloat(document.getElementById('ovAge').value) || 0,
            SpecialBonus: parseFloat(document.getElementById('ovBonus').value) || 0
        };
        fetch('/Coordination/ManualOverrideSave', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value },
            body: JSON.stringify(data)
        }).then(r => r.json()).then(resp => {
            if (resp.success) {
                document.getElementById('ovTotal').value = resp.totalScore;
                alert('تم حفظ التعديلات بنجاح');
                location.reload();
            } else {
                alert(resp.message);
            }
        });
    }
</script>
