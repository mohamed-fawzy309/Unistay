@model UniStay.ViewModels.Account.StudentLoginViewModel
@{
    ViewData["Title"] = "تسجيل دخول الطلاب - UniStay";
    Layout = "~/Views/Shared/_LoginLayout.cshtml";
}

<div class="container">
    <div class="row justify-content-center align-items-center min-vh-100">
        <div class="col-lg-5 col-md-7">
            <div class="card shadow-lg border-0 rounded-4">
                <div class="card-header bg-success text-white text-center py-4">
                    <h4 class="mb-0">بوابة الطالب</h4>
                    <p class="mb-0">نظام UniStay - جامعة أسيوط</p>
                </div>
                <div class="card-body p-5">
                    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                    {
                        <div class="alert alert-danger">@Model.ErrorMessage</div>
                    }

                    <form asp-action="Login" method="post">
                        @Html.AntiForgeryToken()

                        <div class="mb-4">
                            <label asp-for="NationalID" class="form-label fw-bold"></label>
                            <input asp-for="NationalID" class="form-control form-control-lg" placeholder="الرقم القومي (14 رقم)" />
                            <span asp-validation-for="NationalID" class="text-danger"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Password" class="form-label fw-bold"></label>
                            <input asp-for="Password" type="password" class="form-control form-control-lg" />
                            <span asp-validation-for="Password" class="text-danger"></span>
                        </div>

                        <div class="d-flex justify-content-between mb-4">
                            <div class="form-check">
                                <input asp-for="RememberMe" class="form-check-input" type="checkbox">
                                <label asp-for="RememberMe" class="form-check-label">تذكرني</label>
                            </div>
                        </div>

                        <button type="submit" class="btn btn-success btn-lg w-100">دخول إلى بوابة الطالب</button>
                    </form>

                    <div class="text-center mt-4">
                        <a asp-action="Register" class="text-decoration-none">
                            ليس لديك حساب؟ إنشاء حساب جديد
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}