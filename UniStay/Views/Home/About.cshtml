@{
    ViewData["Title"] = "عن النظام";
}

<h2 class="mb-4">عن UniStay</h2>

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <h5>نظام إدارة المدن الجامعية</h5>
        <p>UniStay هو نظام متكامل لإدارة المدن الجامعية بجامعة أسيوط، يهدف إلى تسهيل عملية التقديم والتسكين وإدارة جميع جوانب الحياة الطلابية داخل المدن الجامعية.</p>
    </div>
</div>

<div class="row">
    <div class="col-md-6 mb-3">
        <div class="card shadow-sm h-100">
            <div class="card-body">
                <h5>المميزات</h5>
                <ul>
                    <li>إدارة طلبات التقديم والتسكين</li>
                    <li>متابعة الحضور والغياب</li>
                    <li>تسجيل المخالفات</li>
                    <li>إدارة المدفوعات</li>
                    <li>التواصل مع الطلاب</li>
                </ul>
            </div>
        </div>
    </div>
    <div class="col-md-6 mb-3">
        <div class="card shadow-sm h-100">
            <div class="card-body">
                <h5>الاتصال</h5>
                <p class="mb-1"><strong>الإدارة العامة للمدن الجامعية</strong></p>
                <p class="mb-1">جامعة أسيوط</p>
                <p class="mb-0">جمهورية مصر العربية</p>
            </div>
        </div>
    </div>
</div>
