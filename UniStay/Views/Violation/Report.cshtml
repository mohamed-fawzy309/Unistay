@model UniStay.ViewModels.Violation.ViolationReportViewModel
@{
    ViewData["Title"] = "تقرير المخالفات";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="page-title">تقرير المخالفات</h2>
    <div>
        <a asp-action="ReportExportExcel" asp-route-filterStatus="@Model.FilterStatus" asp-route-filterSeverity="@Model.FilterSeverity" asp-route-dormitoryCityId="@Model.DormitoryCityID" class="btn btn-success"><i class="bi bi-file-earmark-excel"></i> Excel</a>
        <a asp-action="ReportExportPdf" asp-route-filterStatus="@Model.FilterStatus" asp-route-filterSeverity="@Model.FilterSeverity" asp-route-dormitoryCityId="@Model.DormitoryCityID" class="btn btn-danger"><i class="bi bi-file-earmark-pdf"></i> PDF</a>
        <a asp-action="Add" class="btn btn-primary"><i class="bi bi-plus-circle"></i> تسجيل مخالفة جديدة</a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">@TempData["Success"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">@TempData["Error"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
}

<div asp-validation-summary="ModelOnly" class="alert alert-danger d-none"></div>

<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="stat-card bg-white">
            <div class="d-flex align-items-center gap-3">
                <div class="icon bg-danger bg-opacity-10 text-danger"><i class="bi bi-exclamation-triangle"></i></div>
                <div>
                    <div class="value">@Model.Violations.Count</div>
                    <div class="label">إجمالي المخالفات</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card bg-white">
            <div class="d-flex align-items-center gap-3">
                <div class="icon bg-warning bg-opacity-10 text-warning"><i class="bi bi-clock"></i></div>
                <div>
                    <div class="value">@Model.Violations.Count(v => v.Status == "Active")</div>
                    <div class="label">نشط</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card bg-white">
            <div class="d-flex align-items-center gap-3">
                <div class="icon bg-success bg-opacity-10 text-success"><i class="bi bi-check-circle"></i></div>
                <div>
                    <div class="value">@Model.Violations.Count(v => v.Status == "Paid")</div>
                    <div class="label">مدفوع</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card bg-white">
            <div class="d-flex align-items-center gap-3">
                <div class="icon bg-dark bg-opacity-10 text-dark"><i class="bi bi-person-x"></i></div>
                <div>
                    <div class="value">@Model.Violations.Count(v => v.IsOnBlacklist)</div>
                    <div class="label">القائمة السوداء</div>
                </div>
            </div>
        </div>
    </div>
</div>

<form method="get" class="filter-bar row g-2 mb-3">
    <div class="col-md-3">
        <label class="form-label small">الحالة</label>
        <select name="filterStatus" class="form-select" onchange="this.form.submit()">
            <option value="">الكل</option>
            <option value="Active" selected="@(Model.FilterStatus == "Active")">نشط</option>
            <option value="Paid" selected="@(Model.FilterStatus == "Paid")">مدفوع</option>
            <option value="Cancelled" selected="@(Model.FilterStatus == "Cancelled")">ملغي</option>
        </select>
    </div>
    <div class="col-md-3">
        <label class="form-label small">درجة الخطورة</label>
        <select name="filterSeverity" class="form-select" onchange="this.form.submit()">
            <option value="">الكل</option>
            <option value="Low" selected="@(Model.FilterSeverity == "Low")">منخفضة</option>
            <option value="Medium" selected="@(Model.FilterSeverity == "Medium")">متوسطة</option>
            <option value="High" selected="@(Model.FilterSeverity == "High")">عالية</option>
            <option value="Critical" selected="@(Model.FilterSeverity == "Critical")">حرجة</option>
        </select>
    </div>
    <div class="col-md-3">
        <label class="form-label small">المدينة</label>
        <select name="dormitoryCityId" class="form-select" onchange="this.form.submit()">
            <option value="">الكل</option>
            @foreach (var city in Model.Cities)
            {
                <option value="@city.ID" selected="@(Model.DormitoryCityID == city.ID)">@city.Name</option>
            }
        </select>
    </div>
    <div class="col-md-3 d-flex align-items-end">
        <a asp-action="Report" class="btn btn-secondary w-100">إعادة تعيين</a>
    </div>
</form>

<div class="table-responsive bg-white rounded shadow-sm animate-fade-in">
    <table class="table table-hover mb-0">
        <thead class="table-dark">
            <tr>
                <th>#</th>
                <th>الطالب</th>
                <th>الرقم القومي</th>
                <th>نوع المخالفة</th>
                <th>درجة الخطورة</th>
                <th>الغرامة</th>
                <th>المدفوع</th>
                <th>الحالة</th>
                <th>القائمة السوداء</th>
                <th>تاريخ التسجيل</th>
                <th>المسجل</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var v in Model.Violations)
            {
                <tr>
                    <td>@v.ID</td>
                    <td>@v.StudentName</td>
                    <td>@v.NationalID</td>
                    <td>@(v.ViolationType switch { "Smoking" => "تدخين", "Noise" => "إزعاج", "Damage" => "تخريب", "Curfew" => "حظر تجول", "Fighting" => "مشاجرة", "Alcohol" => "مواد محظورة", "UnauthorizedGuest" => "دخول غير مصرح", _ => v.ViolationType })</td>
                    <td>
                        <span class="badge-@(v.Severity switch { "Low" => "info", "Medium" => "warning", "High" => "danger", "Critical" => "dark", _ => "secondary" })">
                            @(v.Severity switch { "Low" => "منخفضة", "Medium" => "متوسطة", "High" => "عالية", "Critical" => "حرجة", _ => v.Severity })
                        </span>
                    </td>
                    <td>@v.FineAmount?.ToString("N2")</td>
                    <td>@v.FinePaid?.ToString("N2")</td>
                    <td>
                        <span class="badge-@(v.Status switch { "Active" => "danger", "Paid" => "success", "Cancelled" => "secondary", _ => "secondary" })">
                            @(v.Status switch { "Active" => "نشط", "Paid" => "مدفوع", "Cancelled" => "ملغي", _ => v.Status })
                        </span>
                    </td>
                    <td>
                        @if (v.IsOnBlacklist)
                        {
                            <span class="badge-dark">في القائمة السوداء</span>
                        }
                        else
                        {
                            <span class="text-muted">—</span>
                        }
                    </td>
                    <td>@v.RecordedAt?.ToString("yyyy-MM-dd")</td>
                    <td>@v.RecordedByName</td>
                    <td>
                        @if (v.Status == "Active")
                        {
                            <div class="btn-group btn-group-sm">
                                <button type="button" class="btn btn-success" onclick="payFine(@v.ID)" title="دفع الغرامة">
                                    <i class="bi bi-cash"></i>
                                </button>
                                @if (!v.IsOnBlacklist)
                                {
                                    <button type="button" class="btn btn-dark" onclick="blacklist(@v.ID)" title="إضافة للقائمة السوداء">
                                        <i class="bi bi-person-x"></i>
                                    </button>
                                }
                                <button type="button" class="btn btn-secondary" onclick="cancelViolation(@v.ID)" title="إلغاء">
                                    <i class="bi bi-x-circle"></i>
                                </button>
                            </div>
                        }
                    </td>
                </tr>
            }
            @if (!Model.Violations.Any())
            {
                <tr><td colspan="12" class="text-center text-muted py-4">لا توجد مخالفات</td></tr>
            }
        </tbody>
    </table>
</div>

@if (Model.TotalPages > 1)
{
    <nav class="mt-3">
        <ul class="pagination pagination-modern justify-content-center">
            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(i == Model.Page ? "active" : "")">
                    <a class="page-link" href="@Url.Action("Report", new { page = i, filterStatus = Model.FilterStatus, filterSeverity = Model.FilterSeverity, dormitoryCityId = Model.DormitoryCityID })">@i</a>
                </li>
            }
        </ul>
    </nav>
}

@section Scripts {
    <script>
        async function postAction(url, data) {
            try {
                const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value
                    || document.querySelector('input[name="__RequestVerificationToken"]')?.value;
                const response = await fetch(url, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': token
                    },
                    body: JSON.stringify(data || {})
                });
                return await response.json();
            } catch {
                return { success: false, message: 'خطأ في الاتصال' };
            }
        }

        async function payFine(id) {
            const amount = prompt('المبلغ المدفوع (اترك فارغاً لكامل الغرامة):');
            if (amount !== null) {
                const result = await postAction('/Violation/PayFine/' + id, { amount: amount ? parseFloat(amount) : null });
                if (result.success) { location.reload(); }
                else { alert(result.message); }
            }
        }

        async function blacklist(id) {
            if (!confirm('إضافة الطالب إلى القائمة السوداء؟')) return;
            const result = await postAction('/Violation/Blacklist/' + id);
            if (result.success) { location.reload(); }
            else { alert(result.message); }
        }

        async function cancelViolation(id) {
            if (!confirm('إلغاء المخالفة؟')) return;
            const result = await postAction('/Violation/Cancel/' + id);
            if (result.success) { location.reload(); }
            else { alert(result.message); }
        }
    </script>
}
