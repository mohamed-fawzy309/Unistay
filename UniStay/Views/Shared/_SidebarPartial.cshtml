@inject UniStay.Services.Interfaces.IPermissionService _permService
@{
    var userIdClaim = User.FindFirst("UserID")?.Value;
    var userId = 0;
    int.TryParse(userIdClaim, out userId);
    var perms = userId > 0 ? _permService.GetUserPermissionKeys(userId) : new HashSet<string>();
    bool isSuperAdmin = User.HasClaim("UserType", "Admin");
    bool HasAny(params string[] keys) => keys.Any(k => perms.Contains(k));
}
