@model List<UniStay.ViewModels.Admin.ApplicationRowViewModel>
@{
    ViewData["Title"] = "الطلبات المعلقة";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>الطلبات المعلقة</h2>
    <a asp-action="AllApplications" class="btn btn-outline-primary">كل الطلبات</a>
</div>

<!-- Filters -->
<form method="get" class="row g-2 mb-3 bg-white p-3 rounded shadow-sm">
<div class="col-md-3">
    <label class="form-label small">بحث</label>
    <input type="text"
           name="search"
           class="form-control"
           value="@ViewBag.Search"
           placeholder="بحث بالاسم أو الرقم القومي">
</div>
    <div class="col-md-2">
        <label class="form-label small">الحالة</label>
        <select name="status" class="form-select" onchange="this.form.submit()">
            <option value="">الكل</option>
            <option value="Pending" selected="@(ViewBag.FilterStatus == "Pending")">معلق</option>
            <option value="UnderReview" selected="@(ViewBag.FilterStatus == "UnderReview")">قيد المراجعة</option>
            <option value="Accepted" selected="@(ViewBag.FilterStatus == "Accepted")">مقبول</option>
            <option value="Rejected" selected="@(ViewBag.FilterStatus == "Rejected")">مرفوض</option>
        </select>
    </div>
    <div class="col-md-2">
        <label class="form-label small">نوع الطالب</label>
        <select name="studentType" class="form-select" onchange="this.form.submit()">
            <option value="">الكل</option>
            <option value="New" selected="@(ViewBag.FilterStudentType == "New")">جديد</option>
            <option value="Returning" selected="@(ViewBag.FilterStudentType == "Returning")">مستمر</option>
            <option value="Foreign" selected="@(ViewBag.FilterStudentType == "Foreign")">وافد</option>
        </select>
    </div>
    <div class="col-md-2">
        <label class="form-label small">المدينة</label>
        <select name="cityId" class="form-select" onchange="this.form.submit()">
            <option value="">الكل</option>
            @foreach (var city in ViewBag.Cities)
            {
                <option value="@city.ID" selected="@(ViewBag.FilterCityId == city.ID)">@city.Name</option>
            }
        </select>
    </div>
    <div class="col-md-2">
        <label class="form-label small">من تاريخ</label>
        <input type="date" name="from" class="form-control" value="@ViewBag.FilterFrom?.ToString("yyyy-MM-dd")" onchange="this.form.submit()">
    </div>
    <div class="col-md-2">
        <label class="form-label small">إلى تاريخ</label>
        <input type="date" name="to" class="form-control" value="@ViewBag.FilterTo?.ToString("yyyy-MM-dd")" onchange="this.form.submit()">
    </div>
    <div class="col-md-2 d-flex align-items-end">
<div class="col-md-2 d-flex align-items-end">
    <button type="submit" class="btn btn-primary w-100">
        بحث
    </button>
</div>
        <a asp-action="PendingApplications" class="btn btn-secondary w-100">إعادة تعيين</a>
    </div>
</form>

<!-- Table -->
<div class="table-responsive bg-white rounded shadow-sm">
    <table class="table table-hover mb-0">
        <thead class="table-dark">
            <tr>
                <th>#</th>
                <th>الطالب</th>
                <th>الرقم القومي</th>
                <th>الكلية</th>
                <th>المدينة</th>
                <th>النوع</th>
                <th>الحالة</th>
                <th>التحقق</th>
                <th>تاريخ التقديم</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var app in Model)
            {
                <tr>
                    <td>@app.ID</td>
                    <td>@app.StudentName</td>
                    <td>@app.NationalID</td>
                    <td>@app.Faculty</td>
                    <td>@app.CityName</td>
                    <td>@(app.StudentType == "New" ? "جديد" : app.StudentType == "Returning" ? "مستمر" : "وافد")</td>
                    <td>
                        <span class="badge bg-@(app.Status switch { "Pending" => "secondary", "UnderReview" => "primary", "Accepted" => "success", "Rejected" => "danger", "Allocated" => "dark", _ => "light" })">
                            @(app.Status switch { "Pending" => "معلق", "UnderReview" => "قيد المراجعة", "Accepted" => "مقبول", "Rejected" => "مرفوض", "Allocated" => "تم التسكين", "Waitlist" => "قائمة انتظار", _ => app.Status })
                        </span>
                    </td>
                    <td>
                        <span class="badge bg-@(app.ServerVerificationStatus switch { "Verified" => "success", "VerifiedWithDiff" => "warning", "NotFound" => "danger", _ => "secondary" })">
                            @(app.ServerVerificationStatus switch { "NotChecked" => "لم يُتحقق", "Verified" => "مطابق", "VerifiedWithDiff" => "اختلافات", "NotFound" => "غير موجود", _ => app.ServerVerificationStatus })
                        </span>
                    </td>
                    <td>@app.CreatedAt.ToString("yyyy-MM-dd")</td>
                    <td>
                        <a asp-action="ReviewApplication" asp-route-id="@app.ID" class="btn btn-primary btn-sm">مراجعة</a>
                        <form asp-action="QuickApprove" asp-route-id="@app.ID" method="post" class="d-inline" onsubmit="return confirm('قبول الطلب؟')">
                            <button type="submit" class="btn btn-success btn-sm">قبول سريع</button>
                        </form>
                        <button type="button" class="btn btn-danger btn-sm" data-bs-toggle="modal" data-bs-target="#rejectModal-@app.ID">رفض</button>

                        <!-- Reject Modal -->
                        <div class="modal fade" id="rejectModal-@app.ID" tabindex="-1">
                            <div class="modal-dialog">
                                <form asp-action="QuickReject" asp-route-id="@app.ID" method="post" class="modal-content">
                                    <div class="modal-header">
                                        <h5 class="modal-title">رفض الطلب</h5>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                    </div>
                                    <div class="modal-body">
                                        <div class="mb-3">
                                            <label class="form-label">سبب الرفض <span class="text-danger">*</span></label>
                                            <textarea name="reason" class="form-control" rows="3" required></textarea>
                                        </div>
                                    </div>
                                    <div class="modal-footer">
                                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إلغاء</button>
                                        <button type="submit" class="btn btn-danger">تأكيد الرفض</button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr><td colspan="10" class="text-center text-muted py-4">لا توجد طلبات</td></tr>
            }
        </tbody>
    </table>
</div>

<!-- Pagination -->
@if (ViewBag.TotalPages > 1)
{
    <nav class="mt-3">
        <ul class="pagination justify-content-center">
            @for (int i = 1; i <= ViewBag.TotalPages; i++)
            {
                <li class="page-item @(i == ViewBag.Page ? "active" : "")">
                    <a class="page-link" href="@Url.Action("PendingApplications", new { page = i, status = ViewBag.FilterStatus, studentType = ViewBag.FilterStudentType, cityId = ViewBag.FilterCityId, faculty = ViewBag.FilterFaculty, from = ViewBag.FilterFrom?.ToString("yyyy-MM-dd"), to = ViewBag.FilterTo?.ToString("yyyy-MM-dd") })">@i</a>
                </li>
            }
        </ul>
    </nav>
}
