@model HousingOrderViewModel
@{
    Layout = null;
    var today = DateTime.Now.ToString("yyyy/MM/dd");
}

<!DOCTYPE html>
<html dir="rtl">
<head>
    <meta charset="utf-8" />
    <title>أمر تسكين - @Model.StudentName</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <style>
        @@media print {
            .no-print { display: none !important; }
            body { padding: 20px; }
        }
        body {
            font-family: 'Segoe UI', Tahoma, sans-serif;
            padding: 40px;
            background: #fff;
        }
        .header { text-align: center; border-bottom: 3px double #0d6efd; padding-bottom: 20px; margin-bottom: 30px; }
        .header h2 { margin-bottom: 0; color: #0d6efd; }
        .header h4 { color: #666; }
        .order-number { font-size: 1.2em; color: #0d6efd; border: 2px solid #0d6efd; display: inline-block; padding: 5px 20px; border-radius: 5px; margin: 10px 0; }
        .info-table th { background: #f8f9fa; width: 200px; }
        .signatures { margin-top: 50px; }
        .signatures .col-6 p { margin-bottom: 5px; }
        .signatures .col-6 hr { width: 200px; }
    </style>
</head>
<body>
    <div class="no-print mb-3">
        <button class="btn btn-primary" onclick="window.print()"><i class="bi bi-printer"></i> طباعة</button>
        <button class="btn btn-secondary" onclick="window.close()">إغلاق</button>
    </div>

    <div class="header">
        <h4>جامعة أسيوط</h4>
        <h5>الإدارة العامة للمدن الجامعية</h5>
        <h2>أمر تسكين</h2>
        <div class="order-number">رقم الأمر: @Model.OrderNumber</div>
        <p class="text-muted">تاريخ الطباعة: @today</p>
    </div>

    <table class="table table-bordered info-table">
        <tr>
            <th>اسم الطالب</th>
            <td>@Model.StudentName</td>
        </tr>
        <tr>
            <th>الرقم القومي</th>
            <td>@Model.NationalID</td>
        </tr>
        <tr>
            <th>الكلية</th>
            <td>@Model.Faculty</td>
        </tr>
        <tr>
            <th>العام الدراسي</th>
            <td>@Model.AcademicYear</td>
        </tr>
        <tr>
            <th>المدينة الجامعية</th>
            <td>@Model.CityName</td>
        </tr>
        <tr>
            <th>المبنى</th>
            <td>@Model.BuildingName</td>
        </tr>
        <tr>
            <th>رقم الغرفة</th>
            <td>@Model.RoomNumber</td>
        </tr>
        <tr>
            <th>رقم السرير</th>
            <td>@Model.BedNumber</td>
        </tr>
        <tr>
            <th>نوع السكن</th>
            <td>@Model.HousingType</td>
        </tr>
        <tr>
            <th>تاريخ التسكين</th>
            <td>@Model.StartDate</td>
        </tr>
    </table>

    <div class="signatures row text-center mt-5 pt-4">
        <div class="col-4">
            <hr style="width:180px;margin:auto">
            <p class="mt-1">إدارة المدن الجامعية</p>
        </div>
        <div class="col-4">
            <hr style="width:180px;margin:auto">
            <p class="mt-1">مشرف المبنى</p>
        </div>
        <div class="col-4">
            <hr style="width:180px;margin:auto">
            <p class="mt-1">الطالب</p>
        </div>
    </div>

    <div class="mt-4 small text-muted text-center">
        هذا الأمر صادر من نظام UniStay لإدارة المدن الجامعية بجامعة أسيوط
    </div>

    <script>
        window.onload = function () {
            // Auto-print if needed
        };
    </script>
</body>
</html>
