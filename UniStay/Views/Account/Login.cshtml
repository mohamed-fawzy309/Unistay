@model UniStay.ViewModels.Account.LoginViewModel
@{
    ViewData["Title"] = "تسجيل دخول الموظفين - UniStay";
    Layout = "~/Views/Shared/_LoginLayout.cshtml";   // سننشئه لاحقاً
}

<div class="container">
    <div class="row justify-content-center align-items-center min-vh-100">
        <div class="col-lg-5 col-md-7 col-sm-10">
            <div class="card shadow-lg border-0 rounded-4 overflow-hidden">
                <div class="card-header bg-primary text-white text-center py-4">
                    <h3 class="mb-0">نظام إدارة المدن الجامعية</h3>
                    <p class="mb-0 mt-2">جامعة أسيوط - UniStay</p>
                </div>
                <div class="card-body p-4 p-lg-5">
                    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                    {
                        <div class="alert alert-danger">@Model.ErrorMessage</div>
                    }

                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success">@TempData["Success"]</div>
                    }

                    <form asp-action="Login" method="post" asp-route-returnUrl="@ViewData["ReturnUrl"]">
                        @Html.AntiForgeryToken()

                        <div class="mb-4">
                            <label class="form-label fw-bold">الرقم القومي</label>
                            <input asp-for="NationalID" class="form-control form-control-lg" placeholder="أدخل الرقم القومي" />
                            <span asp-validation-for="NationalID" class="text-danger"></span>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-bold">كلمة المرور</label>
                            <input asp-for="Password" type="password" class="form-control form-control-lg" placeholder="••••••••" />
                            <span asp-validation-for="Password" class="text-danger"></span>
                        </div>

                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <div class="form-check">
                                <input asp-for="RememberMe" class="form-check-input" type="checkbox">
                                <label asp-for="RememberMe" class="form-check-label">تذكرني</label>
                            </div>
                            <a asp-action="ForgotPassword" class="text-decoration-none">نسيت كلمة المرور؟</a>
                        </div>

                        <button type="submit" class="btn btn-primary btn-lg w-100 mb-3">دخول</button>
                    </form>

                    <div class="text-center text-muted small mt-4">
                        نظام UniStay v1.0 — بوابة الموظفين
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}