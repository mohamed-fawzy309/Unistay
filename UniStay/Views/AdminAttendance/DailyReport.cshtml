@model UniStay.ViewModels.Attendance.DailyReportViewModel
@{
    ViewData["Title"] = "التقرير اليومي";
    var cities = ViewBag.Cities as List<UniStay.Models.DormitoryCity>;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="page-title">التقرير اليومي</h2>
    <div class="d-flex gap-2">
        <a asp-action="DailyReportExportExcel" asp-route-date="@Model.FilterDate?.ToString("yyyy-MM-dd")" asp-route-studentName="@Model.FilterStudentName" asp-route-roomNumber="@Model.FilterRoomNumber" asp-route-cityId="@Model.FilterCityId" class="btn btn-success btn-sm"><i class="bi bi-file-earmark-excel"></i> Excel</a>
        <a asp-action="DailyReportExportPdf" asp-route-date="@Model.FilterDate?.ToString("yyyy-MM-dd")" asp-route-studentName="@Model.FilterStudentName" asp-route-roomNumber="@Model.FilterRoomNumber" asp-route-cityId="@Model.FilterCityId" class="btn btn-danger btn-sm"><i class="bi bi-file-earmark-pdf"></i> PDF</a>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-right"></i> العودة</a>
    </div>
</div>

<div class="row g-2 mb-3">
    <div class="col-md-3">
        <div class="card border-0 shadow-sm bg-primary bg-opacity-10 text-center py-2">
            <small class="text-muted">الحاضرون</small>
            <h5 class="mb-0 fw-bold text-primary">@Model.PresentCount</h5>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm bg-danger bg-opacity-10 text-center py-2">
            <small class="text-muted">الغائبون</small>
            <h5 class="mb-0 fw-bold text-danger">@Model.AbsentCount</h5>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm bg-success bg-opacity-10 text-center py-2">
            <small class="text-muted">نسبة الحضور</small>
            <h5 class="mb-0 fw-bold text-success">@Model.AttendancePercentage%</h5>
        </div>
    </div>
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-md-3">
        <label class="form-label small">التاريخ</label>
        <input type="date" name="date" class="form-control" value="@Model.FilterDate?.ToString("yyyy-MM-dd")">
    </div>
    <div class="col-md-3">
        <label class="form-label small">اسم الطالب</label>
        <input type="text" name="studentName" class="form-control" value="@Model.FilterStudentName" placeholder="بحث بالاسم">
    </div>
    <div class="col-md-2">
        <label class="form-label small">رقم الغرفة</label>
        <input type="text" name="roomNumber" class="form-control" value="@Model.FilterRoomNumber" placeholder="مثال: A101">
    </div>
    <div class="col-md-2">
        <label class="form-label small">المدينة</label>
        <select name="cityId" class="form-select">
            <option value="">الكل</option>
            @if (cities != null)
            {
                foreach (var c in cities)
                {
                    <option value="@c.ID" selected="@(Model.FilterCityId == c.ID)">@c.Name</option>
                }
            }
        </select>
    </div>
    <div class="col-md-2 d-flex align-items-end gap-1">
        <button type="submit" class="btn btn-primary w-100"><i class="bi bi-search"></i> بحث</button>
        <a asp-action="DailyReport" class="btn btn-secondary w-100">إعادة</a>
    </div>
</form>

<div class="card border-0 shadow-sm">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>#</th>
                        <th>الطالب</th>
                        <th>الرقم القومي</th>
                        <th>رقم الغرفة</th>
                        <th>المدينة</th>
                        <th>وقت التعرف</th>
                        <th>نسبة الثقة</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Rows.Count == 0)
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted py-4">لا توجد سجلات</td>
                        </tr>
                    }
                    @foreach (var item in Model.Rows.Select((r, i) => new { r, i }))
                    {
                        <tr>
                            <td>@(item.i + 1)</td>
                            <td>@item.r.StudentName</td>
                            <td>@item.r.NationalID</td>
                            <td>@item.r.RoomNumber</td>
                            <td>@item.r.CityName</td>
                            <td>@item.r.RecognizedAt?.ToString("HH:mm:ss")</td>
                            <td>
                                <span class="badge @(item.r.Confidence >= 0.8m ? "bg-success" : item.r.Confidence >= 0.6m ? "bg-warning text-dark" : "bg-danger")">
                                    @(item.r.Confidence?.ToString("P1") ?? "N/A")
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
