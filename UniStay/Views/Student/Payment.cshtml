@model UniStay.Models.Allocation
@{
    ViewData["Title"] = "إتمام الدفع";
    var deadline = (DateTime)ViewBag.Deadline;
    var remaining = (int)ViewBag.RemainingSeconds;
    var amount = (decimal)ViewBag.Amount;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="mb-0" style="font-weight:800">
        <i class="bi bi-credit-card me-2" style="color:var(--red)"></i> إتمام الدفع
    </h4>
</div>

<div class="row g-4">
    <div class="col-md-7">
        @* Countdown Card *@
        <div class="card-site mb-3">
            <div class="card-site-header">
                <i class="bi bi-clock" style="color:var(--red)"></i>
                المهلة المتبقية
            </div>
            <div class="card-site-body text-center py-4">
                <div style="font-size:2.8rem;font-weight:900;font-family:monospace;direction:ltr;color:var(--red)" id="countdown">
                    <span id="hours">00</span>:<span id="minutes">00</span>:<span id="seconds">00</span>
                </div>
                <p style="color:var(--muted);font-size:.85rem;margin-top:.3rem">متبقي من الـ 24 ساعة لإتمام الدفع</p>
                <div class="progress mt-3" style="height:6px;background:var(--border);border-radius:3px">
                    <div id="progressBar" class="progress-bar" role="progressbar" style="width:100%;background:var(--red);border-radius:3px"></div>
                </div>
            </div>
        </div>

        @* Booking Details *@
        <div class="card-site">
            <div class="card-site-header">
                <i class="bi bi-receipt" style="color:var(--red)"></i>
                تفاصيل الحجز
            </div>
            <div class="card-site-body">
                <div class="row mb-2">
                    <div class="col-6" style="color:var(--muted);font-size:.9rem">المبنى</div>
                    <div class="col-6 fw-bold" style="font-size:.95rem">@Model.CityRoom?.CityBuilding?.BuildingName</div>
                </div>
                <div class="row mb-2">
                    <div class="col-6" style="color:var(--muted);font-size:.9rem">الغرفة</div>
                    <div class="col-6 fw-bold" style="font-size:.95rem">@Model.CityRoom?.RoomNumber</div>
                </div>
                <div class="row mb-2">
                    <div class="col-6" style="color:var(--muted);font-size:.9rem">رقم السرير</div>
                    <div class="col-6 fw-bold" style="font-size:.95rem">@Model.BedNumber</div>
                </div>
                <div class="row mb-2">
                    <div class="col-6" style="color:var(--muted);font-size:.9rem">الدور</div>
                    <div class="col-6 fw-bold" style="font-size:.95rem">@Model.CityRoom?.FloorNumber</div>
                </div>
                <hr style="border-color:var(--border);margin:1rem 0">
                <div class="row">
                    <div class="col-6" style="font-size:1.1rem;color:var(--muted)">المبلغ المطلوب</div>
                    <div class="col-6 fw-bold" style="font-size:1.2rem;color:var(--red)">@(amount.ToString("N2")) ج.م</div>
                </div>
            </div>
        </div>
    </div>

    @* Payment Simulation *@
    <div class="col-md-5">
        <div class="card-site">
            <div class="card-site-header">
                <i class="bi bi-credit-card-2-front" style="color:var(--success)"></i>
                محاكاة الدفع
            </div>
            <div class="card-site-body text-center py-4">
                <div style="font-size:3.5rem;margin-bottom:.8rem;color:var(--muted)">
                    <i class="bi bi-credit-card"></i>
                </div>
                <p style="color:var(--muted);font-size:.88rem;margin-bottom:1.2rem">هذه محاكاة لعملية الدفع. اضغط على الزر لتأكيد الدفع.</p>
                @Html.AntiForgeryToken()
                <button id="btnPay" class="btn w-100" style="background:var(--success);color:#fff;border:none;border-radius:10px;padding:.85rem;font-weight:700;font-size:1rem;transition:all .2s">
                    <i class="bi bi-check-circle me-2"></i> تأكيد الدفع — @(amount.ToString("N2")) ج.م
                </button>
                <div id="paymentResult" class="mt-3"></div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function() {
            var deadlineMs = new Date('@deadline.ToString("o")').getTime();
            var totalSec = @ViewBag.RemainingSeconds;

            function updateCountdown() {
                var now = Date.now();
                var diff = Math.max(0, Math.floor((deadlineMs - now) / 1000));

                if (diff <= 0) {
                    document.getElementById('countdown').innerHTML = '<span style="color:var(--muted);font-size:1.2rem">انتهت المهلة</span>';
                    document.getElementById('btnPay').disabled = true;
                    document.getElementById('btnPay').innerHTML = '<i class="bi bi-x-circle me-2"></i> انتهت المهلة';
                    document.getElementById('progressBar').style.width = '0%';
                    document.getElementById('progressBar').style.background = 'var(--muted)';
                    return;
                }

                document.getElementById('hours').textContent =
                    String(Math.floor(diff / 3600)).padStart(2, '0');
                document.getElementById('minutes').textContent =
                    String(Math.floor((diff % 3600) / 60)).padStart(2, '0');
                document.getElementById('seconds').textContent =
                    String(Math.floor(diff % 60)).padStart(2, '0');

                document.getElementById('progressBar').style.width =
                    (diff / (24 * 3600) * 100) + '%';
            }

            updateCountdown();
            setInterval(updateCountdown, 1000);

            document.getElementById('btnPay').addEventListener('click', function() {
                var btn = this;
                btn.disabled = true;
                btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span> جاري المعالجة...';

                var xhr = new XMLHttpRequest();
                xhr.open('POST', '@Url.Action("ProcessPayment", "Student")', true);
                xhr.setRequestHeader('X-CSRF-TOKEN', document.querySelector('[name=__RequestVerificationToken]').value);
                xhr.setRequestHeader('Content-Type', 'application/json');
                xhr.withCredentials = true;

                xhr.onload = function() {
                    if (xhr.status !== 200) {
                        document.getElementById('paymentResult').innerHTML =
                            '<div class="alert alert-danger" style="font-size:.85rem"><i class="bi bi-exclamation-circle me-2"></i> خطأ ' + xhr.status + '<br><small>' + xhr.responseText.substring(0, 200) + '</small></div>';
                        btn.disabled = false;
                        btn.innerHTML = '<i class="bi bi-check-circle me-2"></i> تأكيد الدفع — @(amount.ToString("N2")) ج.م';
                        return;
                    }

                    var r;
                    try { r = JSON.parse(xhr.responseText); } catch (e) {
                        document.getElementById('paymentResult').innerHTML =
                            '<div class="alert alert-danger" style="font-size:.85rem"><i class="bi bi-exclamation-circle me-2"></i> خطأ في الاستجابة<br><small>' + xhr.responseText.substring(0, 300) + '</small></div>';
                        btn.disabled = false;
                        btn.innerHTML = '<i class="bi bi-check-circle me-2"></i> تأكيد الدفع — @(amount.ToString("N2")) ج.م';
                        return;
                    }

                    if (r.success) {
                        document.getElementById('paymentResult').innerHTML =
                            '<div class="alert alert-success" style="font-size:.9rem"><i class="bi bi-check-circle-fill me-2"></i>' + r.message + '</div>';
                        btn.innerHTML = '<i class="bi bi-check-circle me-2"></i> تم الدفع بنجاح';
                        setTimeout(function() { window.location.href = '@Url.Action("Home", "Student")'; }, 2000);
                    } else if (r.expired) {
                        location.reload();
                    } else {
                        document.getElementById('paymentResult').innerHTML =
                            '<div class="alert alert-danger" style="font-size:.9rem"><i class="bi bi-exclamation-circle me-2"></i>' + r.message + '</div>';
                        btn.disabled = false;
                        btn.innerHTML = '<i class="bi bi-check-circle me-2"></i> تأكيد الدفع — @(amount.ToString("N2")) ج.م';
                    }
                };

                xhr.onerror = function() {
                    document.getElementById('paymentResult').innerHTML =
                        '<div class="alert alert-danger" style="font-size:.9rem"><i class="bi bi-exclamation-circle me-2"></i> حدث خطأ في الاتصال</div>';
                    btn.disabled = false;
                    btn.innerHTML = '<i class="bi bi-check-circle me-2"></i> تأكيد الدفع — @(amount.ToString("N2")) ج.م';
                };

                xhr.send('{}');
            });
        })();
    </script>
}
