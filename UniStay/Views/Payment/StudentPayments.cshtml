@model StudentPaymentsViewModel
@{
    ViewData["Title"] = Model != null ? "مدفوعات الطالب" : "تسجيل الرسوم";
}

@if (Model == null)
{
    <div class="container-fluid py-4">
        <h2 class="mb-4"><i class="bi bi-currency-exchange"></i> تسجيل الرسوم</h2>
        <div class="card">
            <div class="card-body">
                <div class="row g-2 mb-3">
                    <div class="col-md-6">
                        <input type="text" id="studentSearch" class="form-control" placeholder="ابحث باسم الطالب أو الرقم القومي..." autocomplete="off">
                    </div>
                    <div class="col-md-3">
                        <select id="studentSelect" class="form-select" onchange="if(this.value) window.location.href='@Url.Action("StudentPayments")?studentId=' + this.value">
                            <option value="">-- اختر الطالب --</option>
                            @foreach (var s in (IEnumerable<SelectListItem>)ViewBag.Students)
                            {
                                <option value="@s.Value">@s.Text</option>
                            }
                        </select>
                    </div>
                </div>
                <div id="searchResults" class="list-group" style="display:none"></div>
            </div>
        </div>
    </div>

    @section Scripts {
        <script>
            let searchTimeout;
            document.getElementById('studentSearch').addEventListener('input', function () {
                clearTimeout(searchTimeout);
                const term = this.value.trim();
                if (term.length < 2) {
                    document.getElementById('searchResults').style.display = 'none';
                    return;
                }
                searchTimeout = setTimeout(async () => {
                    try {
                        const res = await fetch('@Url.Action("StudentPayments")?term=' + encodeURIComponent(term));
                        const data = await res.json();
                        const container = document.getElementById('searchResults');
                        container.innerHTML = '';
                        if (data.length === 0) {
                            container.innerHTML = '<a class="list-group-item text-muted">لا توجد نتائج</a>';
                        } else {
                            data.forEach(s => {
                                const a = document.createElement('a');
                                a.href = '@Url.Action("StudentPayments")?studentId=' + s.id;
                                a.className = 'list-group-item list-group-item-action d-flex justify-content-between align-items-center';
                                a.innerHTML = '<span><strong>' + s.fullName + '</strong><br><small class="text-muted">' + s.nationalID + '</small></span><i class="bi bi-chevron-left"></i>';
                                container.appendChild(a);
                            });
                        }
                        container.style.display = 'block';
                    } catch (e) {
                        console.error(e);
                    }
                }, 300);
            });
        </script>
    }
    return;
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-credit-card"></i> مدفوعات @Model.StudentName</h2>
        <div>
            <a asp-action="StudentPayments" class="btn btn-outline-secondary me-2"><i class="bi bi-search"></i> بحث</a>
            <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#recordPaymentModal">
                <i class="bi bi-plus-circle"></i> تسجيل دفعة
            </button>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-md-4">
            <div class="card border-success">
                <div class="card-body text-center">
                    <h6>المدفوع</h6>
                    <h3 class="text-success">@Model.TotalPaid.ToString("N2")</h3>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-danger">
                <div class="card-body text-center">
                    <h6>المستحق</h6>
                    <h3 class="text-danger">@Model.TotalDue.ToString("N2")</h3>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-info">
                <div class="card-body text-center">
                    <h6>المتبقي</h6>
                    <h3 class="text-info">@Model.Balance.ToString("N2")</h3>
                </div>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>النوع</th>
                        <th>المبلغ</th>
                        <th>المدفوع</th>
                        <th>الحالة</th>
                        <th>طريقة الدفع</th>
                        <th>رقم الإيصال</th>
                        <th>التاريخ</th>
                        <th>المسجل</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model.Payments)
                    {
                        <tr>
                            <td>@p.ID</td>
                            <td>@p.PaymentType</td>
                            <td>@p.Amount.ToString("N2")</td>
                            <td>@p.PaidAmount.ToString("N2")</td>
                            <td>
                                @switch (p.Status)
                                {
                                    case "Completed": <span class="badge bg-success">مكتمل</span>; break;
                                    case "Partial": <span class="badge bg-warning">جزئي</span>; break;
                                    case "Pending": <span class="badge bg-secondary">معلق</span>; break;
                                    case "Overdue": <span class="badge bg-danger">متأخر</span>; break;
                                    default: <span class="badge bg-secondary">@p.Status</span>; break;
                                }
                            </td>
                            <td>@p.PaymentMethod</td>
                            <td>@p.ReceiptNumber</td>
                            <td>@p.RecordedAt?.ToString("yyyy/MM/dd")</td>
                            <td>@p.RecordedByName</td>
                            <td>
                                <a asp-action="Receipt" asp-route-id="@p.ID" class="btn btn-sm btn-info"><i class="bi bi-receipt"></i></a>
                                @if (p.Status != "Overdue")
                                {
                                    <button class="btn btn-sm btn-danger" onclick="markOverdue(@p.ID)"><i class="bi bi-exclamation-triangle"></i></button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="modal fade" id="recordPaymentModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="recordPaymentForm">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title">تسجيل دفعة</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="studentId" value="@Model.StudentID" />
                    <input type="hidden" name="academicYear" />
                    <div class="mb-3">
                        <label class="form-label">نوع الدفعة</label>
                        <select name="paymentType" class="form-select" required>
                            <option value="HousingFee">رسوم سكن</option>
                            <option value="MealFee">رسوم وجبات</option>
                            <option value="SecurityDeposit">تأمين</option>
                            <option value="Fine">غرامة</option>
                            <option value="Other">أخرى</option>
                        </select>
                    </div>
                    <div class="row mb-3">
                        <div class="col-6">
                            <label class="form-label">المبلغ</label>
                            <input name="amount" class="form-control" type="number" step="0.01" required />
                        </div>
                        <div class="col-6">
                            <label class="form-label">المدفوع</label>
                            <input name="paidAmount" class="form-control" type="number" step="0.01" required />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">طريقة الدفع</label>
                        <select name="paymentMethod" class="form-select" required>
                            <option value="Cash">نقداً</option>
                            <option value="BankTransfer">تحويل بنكي</option>
                            <option value="Card">بطاقة</option>
                            <option value="Online">أونلاين</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">ملاحظات</label>
                        <textarea name="notes" class="form-control" rows="2"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-primary"><i class="bi bi-check"></i> تسجيل</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('recordPaymentForm')?.addEventListener('submit', async function (e) {
            e.preventDefault();
            const formData = new FormData(this);
            try {
                const res = await fetch('@Url.Action("Record")', {
                    method: 'POST',
                    body: new URLSearchParams(formData),
                    headers: { 'Request-Verification-Token': document.querySelector('input[name="__RequestVerificationToken"]')?.value || '' }
                });
                const data = await res.json();
                if (data.success) { location.reload(); } else { alert(data.message); }
            } catch (e) {
                alert('حدث خطأ');
            }
        });

        async function markOverdue(id) {
            if (!confirm('تأكيد وضع الدفعة كمتأخرة؟')) return;
            try {
                const res = await fetch('@Url.Action("MarkOverdue")', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: 'paymentId=' + id
                });
                const data = await res.json();
                if (data.success) { location.reload(); } else { alert(data.message); }
            } catch (e) {
                alert('حدث خطأ');
            }
        }
    </script>
}
