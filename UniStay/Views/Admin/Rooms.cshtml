@model List<UniStay.ViewModels.Admin.RoomRowViewModel>
@{
    ViewData["Title"] = "الغرف";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>الغرف</h2>
    <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addModal">إضافة غرفة</button>
</div>

<form method="get" class="row g-2 mb-3 bg-white p-3 rounded shadow-sm">
    <div class="col-md-3">
        <select name="buildingId" class="form-select" onchange="this.form.submit()">
            <option value="">كل المباني</option>
            @foreach (var b in ViewBag.Buildings)
            {
                <option value="@b.ID" selected="@(ViewBag.FilterBuildingId == b.ID)">
                    @b.DormitoryCity.Name — @b.BuildingName
                </option>
            }
        </select>
    </div>
    <div class="col-md-3">
        <a asp-action="Buildings" class="btn btn-outline-secondary">المباني</a>
    </div>
</form>

<div class="table-responsive bg-white rounded shadow-sm">
    <table class="table table-hover mb-0">
        <thead class="table-dark">
            <tr>
                <th>#</th>
                <th>رقم الغرفة</th>
                <th>المبنى</th>
                <th>المدينة</th>
                <th>الدور</th>
                <th>النوع</th>
                <th>الأسرة</th>
                <th>مشغول</th>
                <th>متبقي</th>
                <th>تكييف</th>
                <th>الحالة</th>
                <th></th>
            </tr>
        </thead>
      <tbody>
@foreach (var r in Model)
{
    <tr>
        <td>@r.ID</td>
        <td>@r.RoomNumber</td>
        <td>@r.BuildingName</td>
        <td>@r.CityName</td>
        <td>@r.FloorNumber</td>
        <td>@r.RoomType</td>
        <td>@r.BedsCount</td>
        <td>@r.CurrentOccupancy</td>
        <td>@(r.BedsCount - r.CurrentOccupancy)</td>
        <td>@(r.HasAC ? "نعم" : "لا")</td>
        <td>
            <span class="badge bg-@(r.IsActive ? "success" : "danger")">
                @(r.IsActive ? "نشطة" : "غير نشطة")
            </span>
        </td>
        <td>
            <button class="btn btn-outline-warning btn-sm"
                    data-bs-toggle="modal"
                    data-bs-target="#editModal-@r.ID">
                تعديل
            </button>
        </td>
    </tr>
}

@if (!Model.Any())
{
    <tr>
        <td colspan="12" class="text-center text-muted py-4">
            لا توجد غرف
        </td>
    </tr>
}
 </tbody>
</table>
</div>

@foreach (var r in Model)
{
    <div class="modal fade" id="editModal-@r.ID" tabindex="-1">
        <div class="modal-dialog">
            <form asp-action="EditRoom" method="post" class="modal-content">

                @Html.AntiForgeryToken()

                <input type="hidden" name="ID" value="@r.ID" />

                <div class="modal-header">
                    <h5 class="modal-title">
                        تعديل الغرفة @r.RoomNumber
                    </h5>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal">
                    </button>
                </div>

                <div class="modal-body">

                    <div class="mb-3">
                        <label class="form-label">رقم الغرفة</label>
                        <input name="RoomNumber"
                               class="form-control"
                               value="@r.RoomNumber"
                               required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">الدور</label>
                        <input name="FloorNumber"
                               type="number"
                               class="form-control"
                               value="@r.FloorNumber" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">عدد الأسرة</label>
                        <input name="BedsCount"
                               type="number"
                               class="form-control"
                               value="@r.BedsCount" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">النوع</label>

                        <select name="RoomType" class="form-select">
                            @if (r.RoomType == "إشراف")
                            {
                                <option value="إشراف" selected>إشراف</option>
                            }
                            else
                            {
                                <option value="إشراف">إشراف</option>
                            }

                            @if (r.RoomType == "مخزن")
                            {
                                <option value="مخزن" selected>مخزن</option>
                            }
                            else
                            {
                                <option value="مخزن">مخزن</option>
                            }

                            @if (r.RoomType == "Quad")
{
    <option value="Quad" selected>رباعي</option>
}
else
{
    <option value="Quad">رباعي</option>
}

@if (r.RoomType == "Triple")
{
    <option value="Triple" selected>ثلاثي</option>
}
else
{
    <option value="Triple">ثلاثي</option>
}

@if (r.RoomType == "Double")
{
    <option value="Double" selected>ثنائي</option>
}
else
{
    <option value="Double">ثنائي</option>
}

@if (r.RoomType == "Single")
{
    <option value="Single" selected>فردي</option>
}
else
{
    <option value="Single">فردي</option>
}
                        </select>
                    </div>

                    <div class="form-check mb-2">
                        <input class="form-check-input"
                               type="checkbox"
                               name="HasAC"
                               value="true"
                               @(r.HasAC ? "checked" : "") />

                        <input type="hidden" name="HasAC" value="false" />

                        <label class="form-check-label">
                            تكييف
                        </label>
                    </div>

                    <div class="form-check">
                        <input class="form-check-input"
                               type="checkbox"
                               name="IsActive"
                               value="true"
                               @(r.IsActive ? "checked" : "") />

                        <input type="hidden" name="IsActive" value="false" />

                        <label class="form-check-label">
                            نشطة
                        </label>
                    </div>

                </div>

                <div class="modal-footer">
                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">
                        إلغاء
                    </button>

                    <button type="submit"
                            class="btn btn-primary">
                        حفظ
                    </button>
                </div>

            </form>
        </div>
    </div>
}


<!-- Add Modal -->
<div class="modal fade" id="addModal" tabindex="-1">
    <div class="modal-dialog">
        <form asp-action="Rooms" method="post" class="modal-content">
            <div class="modal-header"><h5 class="modal-title">إضافة غرفة</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label">المبنى <span class="text-danger">*</span></label>
                    <select name="CityBuildingID" class="form-select">
                        @foreach (var b in ViewBag.Buildings)
                        {
                            <option value="@b.ID">@b.DormitoryCity.Name — @b.BuildingName</option>
                        }
                    </select>
                </div>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">رقم الغرفة <span class="text-danger">*</span></label>
                        <input name="RoomNumber" class="form-control" required>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">الدور</label>
                        <input name="FloorNumber" type="number" class="form-control" value="1">
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">عدد الأسرة</label>
                        <input name="BedsCount" type="number" class="form-control" value="4">
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">النوع</label>
                        <select name="RoomType" class="form-select">
                            <option value="إشراف">إشراف</option>
                            <option value="مخزن">مخزن</option>
                            <option value="Quad">رباعي</option>
                            <option value="Triple">ثلاثي</option>
                            <option value="Double">ثنائي</option>
                            <option value="Single">فردي</option>
                        </select>
                    </div>
                    <div class="col-12">
                        <div class="form-check form-check-inline">
                            <input name="HasAC" class="form-check-input" type="checkbox" value="true">
                            <label class="form-check-label">تكييف</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input name="HasBalcony" class="form-check-input" type="checkbox" value="true">
                            <label class="form-check-label">بلكونة</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input name="HasPrivateBathroom" class="form-check-input" type="checkbox" value="true">
                            <label class="form-check-label">حمام خاص</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input name="HasFridge" class="form-check-input" type="checkbox" value="true">
                            <label class="form-check-label">ثلاجة</label>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إلغاء</button>
                <button type="submit" class="btn btn-primary">إضافة</button>
            </div>
        </form>
    </div>
</div>
