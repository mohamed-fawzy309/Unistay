@model SocialCasePrintVM
@{
    Layout = null;
}

<!DOCTYPE html>
<html dir="rtl">
<head>
    <meta charset="utf-8" />
    <title>@Model.Title</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <style>
        body { font-family: 'Segoe UI', Tahoma, sans-serif; padding: 20px; }
        .header { border-bottom: 2px solid #333; margin-bottom: 20px; padding-bottom: 10px; }
        .header h2 { margin: 0; }
        .footer { margin-top: 30px; font-size: 12px; color: #666; border-top: 1px solid #ccc; padding-top: 10px; }
        table { font-size: 13px; }
    </style>
</head>
<body>
    <div class="header text-center">
        <h2>@Model.Title</h2>
        <h5>@Model.OrganizationName</h5>
    </div>

    @if (Model.Cases.Any())
    {
        <table class="table table-bordered">
            <thead>
                <tr>
                    <th>#</th>
                    <th>الطالب</th>
                    <th>الرقم الجامعي</th>
                    <th>نوع الحالة</th>
                    <th>الأولوية</th>
                    <th>الحالة</th>
                    <th>المسؤول</th>
                    <th>تاريخ الإنشاء</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in Model.Cases.Select((item, idx) => new { item, idx }))
                {
                    <tr>
                        <td>@(c.idx + 1)</td>
                        <td>@c.item.StudentName</td>
                        <td>@c.item.StudentCode</td>
                        <td>@c.item.CaseType</td>
                        <td>@c.item.Priority</td>
                        <td>@c.item.Status</td>
                        <td>@c.item.AssignedTo</td>
                        <td>@c.item.CreatedAt?.ToString("yyyy/MM/dd")</td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <p class="text-center text-muted">لا توجد حالات</p>
    }

    <div class="footer">
        <div class="row">
            <div class="col-6">تمت الطباعة: @Model.PrintedAt</div>
            <div class="col-6 text-start">@Model.OrganizationName</div>
        </div>
    </div>

    <script>window.print();</script>
</body>
</html>
