@model MealBookingIndexViewModel
@{
    ViewData["Title"] = "حجز الوجبات";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="page-title"><i class="bi bi-calendar-check"></i> حجز الوجبات</h2>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">@TempData["Success"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">@TempData["Error"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
}

<div class="card">
    <div class="card-header bg-primary text-white"><h5 class="mb-0">مسح باركود الطالب</h5></div>
    <div class="card-body">
        <form asp-action="Scan" method="post" class="row g-3">
            @Html.AntiForgeryToken()
            <div class="col-md-8">
                <label class="form-label">الرقم القومي / كود الطالب / QR</label>
                <input name="SearchTerm" class="form-control form-control-lg" placeholder="امسح الباركود أو أدخل الرقم القومي" autofocus>
            </div>
            <div class="col-md-4 d-flex align-items-end">
                <button type="submit" class="btn btn-primary btn-lg w-100"><i class="bi bi-search"></i> بحث</button>
            </div>
        </form>
    </div>
</div>

<div class="card mt-4">
    <div class="card-body text-center text-muted py-5">
        <i class="bi bi-calendar-check" style="font-size: 4rem;"></i>
        <p class="mt-3">قم بمسح باركود الطالب أو إدخال الرقم القومي لبدء الحجز</p>
    </div>
</div>
