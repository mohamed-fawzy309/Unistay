@model UniStay.ViewModels.Account.ForgotPasswordViewModel
@{
    ViewData["Title"] = "استعادة كلمة المرور";
    Layout = "~/Views/Shared/_LoginLayout.cshtml";
}

<div class="container">
    <div class="row justify-content-center align-items-center min-vh-100">
        <div class="col-lg-5 col-md-7">
            <div class="card shadow-lg">
                <div class="card-header bg-warning text-dark text-center py-3">
                    <h4 class="mb-0">استعادة كلمة المرور</h4>
                </div>
                <div class="card-body p-5">
                    @if (ViewBag.Message != null)
                    {
                        <div class="alert alert-success">@ViewBag.Message</div>
                    }

                    <form asp-action="ForgotPassword" method="post">
                        @Html.AntiForgeryToken()

                        <div class="mb-4">
                            <label asp-for="Identifier" class="form-label fw-bold"></label>
                            <input asp-for="Identifier" class="form-control form-control-lg"
                                   placeholder="الرقم القومي أو البريد الإلكتروني" />
                            <span asp-validation-for="Identifier" class="text-danger"></span>
                        </div>

                        <button type="submit" class="btn btn-warning btn-lg w-100 text-dark fw-bold">
                            إرسال كلمة مرور مؤقتة
                        </button>
                    </form>

                    <div class="text-center mt-4">
                        <a asp-action="Login" class="text-decoration-none">← العودة لصفحة الدخول</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}