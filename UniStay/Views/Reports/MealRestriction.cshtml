@model UniStay.ViewModels.Reports.MealRestrictionReportViewModel
@{
    ViewData["Title"] = "قيود الوجبات";
    var totalRestrictions = Model.TotalBlocks + Model.TotalCancellations;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="page-title">قيود الوجبات</h2>
    <div class="btn-group">
        <a asp-action="MealRestrictionExportExcel" asp-route-cityId="@Model.Filter.CityID" asp-route-type="@Model.Filter.Type" asp-route-fromDate="@Model.Filter.FromDate?.ToString("yyyy-MM-dd")" asp-route-toDate="@Model.Filter.ToDate?.ToString("yyyy-MM-dd")" class="btn btn-success"><i class="bi bi-file-earmark-excel"></i> Excel</a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">@TempData["Success"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">@TempData["Error"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
}

<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="stat-card bg-white">
            <div class="d-flex align-items-center gap-3">
                <div class="icon bg-primary bg-opacity-10 text-primary"><i class="bi bi-slash-circle"></i></div>
                <div>
                    <div class="value">@totalRestrictions</div>
                    <div class="label">إجمالي القيود</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card bg-white">
            <div class="d-flex align-items-center gap-3">
                <div class="icon bg-danger bg-opacity-10 text-danger"><i class="bi bi-ban"></i></div>
                <div>
                    <div class="value">@Model.TotalBlocks</div>
                    <div class="label">حظر</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card bg-white">
            <div class="d-flex align-items-center gap-3">
                <div class="icon bg-warning bg-opacity-10 text-warning"><i class="bi bi-x-circle"></i></div>
                <div>
                    <div class="value">@Model.TotalCancellations</div>
                    <div class="label">إلغاء</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card bg-white">
            <div class="d-flex align-items-center gap-3">
                <div class="icon bg-success bg-opacity-10 text-success"><i class="bi bi-toggle-on"></i></div>
                <div>
                    <div class="value">@Model.ActiveBlocks</div>
                    <div class="label">نشط حالياً</div>
                </div>
            </div>
        </div>
    </div>
</div>

<form method="get" class="filter-bar row g-2 mb-3">
    <div class="col-md-3">
        <label class="form-label small">المدينة</label>
        <select name="cityId" class="form-select" onchange="this.form.submit()">
            <option value="">الكل</option>
            @foreach (var c in Model.Cities)
            {
                <option value="@c.ID" selected="@(Model.Filter.CityID == c.ID)">@c.Name</option>
            }
        </select>
    </div>
    <div class="col-md-3">
        <label class="form-label small">النوع</label>
        <select name="type" class="form-select" onchange="this.form.submit()">
            <option value="">الكل</option>
            <option value="Block" selected="@(Model.Filter.Type == "Block")">حظر</option>
            <option value="Cancellation" selected="@(Model.Filter.Type == "Cancellation")">إلغاء</option>
        </select>
    </div>
    <div class="col-md-3">
        <label class="form-label small">بحث</label>
        <input type="text" name="search" class="form-control" placeholder="اسم الطالب..." value="@Model.Filter.Search">
    </div>
    <div class="col-md-3 d-flex align-items-end">
        <a asp-action="MealRestriction" class="btn btn-secondary w-100">إعادة تعيين</a>
    </div>
</form>

<div class="table-responsive bg-white rounded shadow-sm animate-fade-in">
    <table class="table table-hover mb-0">
        <thead class="table-dark">
            <tr>
                <th>النوع</th>
                <th>الطالب</th>
                <th>الرقم القومي</th>
                <th>المدينة</th>
                <th>من تاريخ</th>
                <th>إلى تاريخ</th>
                <th>نشط?</th>
                <th>تاريخ الإنشاء</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var r in Model.Restrictions)
            {
                <tr class="@(r.IsActive ? "" : "table-secondary")">
                    <td>
                        <span class="badge bg-@(r.Type == "Block" ? "danger" : "warning")">@r.TypeDisplay</span>
                    </td>
                    <td class="fw-semibold">@r.StudentName</td>
                    <td>@r.NationalID</td>
                    <td>@(r.CityName ?? "—")</td>
                    <td><small>@r.FromDate?.ToString("yyyy/MM/dd")</small></td>
                    <td><small>@(r.ToDate?.ToString("yyyy/MM/dd") ?? "—")</small></td>
                    <td>
                        @if (r.IsActive)
                        {
                            <span class="text-success"><i class="bi bi-check-circle"></i> نعم</span>
                        }
                        else
                        {
                            <span class="text-muted"><i class="bi bi-x-circle"></i> لا</span>
                        }
                    </td>
                    <td><small>@r.CreatedAt.ToString("yyyy/MM/dd")</small></td>
                </tr>
            }
            @if (!Model.Restrictions.Any())
            {
                <tr><td colspan="8" class="text-center text-muted py-4">لا توجد بيانات</td></tr>
            }
        </tbody>
    </table>
</div>

@if (Model.TotalPages > 1)
{
    <nav class="mt-3">
        <ul class="pagination pagination-modern justify-content-center">
            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(i == Model.Page ? "active" : "")">
                    <a class="page-link" asp-action="MealRestriction" asp-route-page="@i" asp-route-cityId="@Model.Filter.CityID" asp-route-type="@Model.Filter.Type" asp-route-search="@Model.Filter.Search">@i</a>
                </li>
            }
        </ul>
    </nav>
}
