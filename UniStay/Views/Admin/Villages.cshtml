@model List<UniStay.ViewModels.Admin.VillageViewModel>
@{
    ViewData["Title"] = "القرى";
    var cities = ViewBag.Cities as List<UniStay.Models.DormitoryCity> ?? new();
    var filterCityId = ViewBag.FilterCityId as int?;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="page-title">القرى</h2>
    <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addModal">
        <i class="bi bi-plus-circle"></i> إضافة قرية
    </button>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show animate-fade-in">@TempData["Success"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show animate-fade-in">@TempData["Error"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
}

<div class="filter-bar row g-2 mb-3">
    <div class="col-md-4">
        <form method="get" class="d-flex gap-2">
            <select name="cityId" class="form-select" onchange="this.form.submit()">
                <option value="">جميع المدن</option>
                @foreach (var c in cities)
                {
                    <option value="@c.ID" selected="@(filterCityId == c.ID)">@c.Name</option>
                }
            </select>
            @if (filterCityId.HasValue)
            {
                <a asp-action="Villages" class="btn btn-secondary">إعادة تعيين</a>
            }
        </form>
    </div>
</div>

<div class="table-responsive">
    <table class="table table-hover table-bordered bg-white animate-fade-in">
        <thead class="table-light">
            <tr>
                <th>#</th>
                <th>الاسم</th>
                <th>المدينة</th>
                <th>الحالة</th>
                <th>تاريخ الإضافة</th>
                <th>إجراءات</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Any())
            {
                int i = 1;
                foreach (var item in Model)
                {
                    <tr>
                        <td>@(i++)</td>
                        <td>@item.Name</td>
                        <td>@item.CityName</td>
                        <td><span class="badge @(item.IsActive ? "bg-success" : "bg-secondary")">@(item.IsActive ? "نشط" : "غير نشط")</span></td>
                        <td>@item.CreatedAt?.ToString("yyyy-MM-dd")</td>
                        <td>
                            <button class="btn btn-outline-warning btn-sm" data-bs-toggle="modal" data-bs-target="#editModal-@item.ID">
                                <i class="bi bi-pencil"></i> تعديل
                            </button>
                        </td>
                    </tr>

                    <!-- Edit Modal -->
                    <div class="modal fade" id="editModal-@item.ID" tabindex="-1" aria-hidden="true">
                        <div class="modal-dialog modal-dialog-centered">
                            <form asp-action="EditVillage" method="post" class="modal-content">
                                <input type="hidden" name="ID" value="@item.ID">
                                <div class="modal-header">
                                    <h5 class="modal-title fw-bold">تعديل @item.Name</h5>
                                    <button type="button" class="btn-close m-0 ms-auto" data-bs-dismiss="modal"></button>
                                </div>
                                <div class="modal-body">
                                    <div class="mb-3">
                                        <label class="form-label fw-semibold">الاسم <span class="text-danger">*</span></label>
                                        <input name="Name" class="form-control" value="@item.Name" required>
                                    </div>
                                    <div class="form-check form-switch">
                                        <input name="IsActive" class="form-check-input" type="checkbox" value="true" checked="@item.IsActive" id="v-active-@item.ID">
                                        <label class="form-check-label" for="v-active-@item.ID">نشط</label>
                                    </div>
                                </div>
                                <div class="modal-footer">
                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إلغاء</button>
                                    <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> حفظ</button>
                                </div>
                            </form>
                        </div>
                    </div>
                }
            }
            else
            {
                <tr><td colspan="6" class="text-center py-4 text-muted">لا توجد قرى مضافة بعد</td></tr>
            }
        </tbody>
    </table>
</div>

<!-- Add Modal -->
<div class="modal fade" id="addModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <form asp-action="Villages" method="post" class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title fw-bold">إضافة قرية</h4>
                <button type="button" class="btn-close m-0 ms-auto" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label fw-semibold">المدينة <span class="text-danger">*</span></label>
                    <select name="DormitoryCityID" class="form-select" required>
                        <option value="" selected disabled>اختر المدينة</option>
                        @foreach (var c in cities)
                        {
                            <option value="@c.ID" selected="@(filterCityId == c.ID)">@c.Name</option>
                        }
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">الاسم <span class="text-danger">*</span></label>
                    <input name="Name" class="form-control" placeholder="مثال: قرية الأمل" required>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إلغاء</button>
                <button type="submit" class="btn btn-primary"><i class="bi bi-plus-lg"></i> إضافة</button>
            </div>
        </form>
    </div>
</div>
