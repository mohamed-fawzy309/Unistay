@model ErrorViewModel
@{
    ViewData["Title"] = "خطأ";
    Layout = "_LoginLayout";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden text-center">
                <div class="card-body p-5">
                    <div class="mb-4">
                        <i class="bi bi-exclamation-triangle-fill text-danger" style="font-size:4rem;"></i>
                    </div>
                    <h2 class="fw-bold mb-3">عذراً، حدث خطأ غير متوقع</h2>
                    <p class="text-muted mb-4">نأسف للإزعاج، يرجى المحاولة مرة أخرى لاحقاً.</p>
                    @if (Model.ShowRequestId)
                    {
                        <p class="text-muted small">
                            <strong>معرف الطلب:</strong> <code class="text-danger">@Model.RequestId</code>
                        </p>
                    }
                    <div class="d-flex justify-content-center gap-3">
                        <a href="javascript:history.back()" class="btn btn-outline-secondary btn-lg px-4">
                            <i class="bi bi-arrow-right"></i> العودة
                        </a>
                        <a href="/" class="btn btn-primary btn-lg px-4">
                            <i class="bi bi-house"></i> الصفحة الرئيسية
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
