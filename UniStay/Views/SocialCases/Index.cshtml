@model SocialCaseListVM
@{
    ViewData["Title"] = "حالات البحث الاجتماعي";
}

<div class="container-fluid" dir="rtl">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="mb-0"><i class="bi bi-search-heart"></i> حالات البحث الاجتماعي</h4>
        <div>
            <a asp-action="Create" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg"></i> إضافة حالة</a>
            <a asp-action="ExportExcel" asp-route-search="@Model.SearchTerm" asp-route-status="@Model.StatusFilter" asp-route-priority="@Model.PriorityFilter" asp-route-caseType="@Model.CaseTypeFilter" class="btn btn-success btn-sm"><i class="bi bi-file-earmark-excel"></i> Excel</a>
            <a asp-action="ExportPdf" asp-route-search="@Model.SearchTerm" asp-route-status="@Model.StatusFilter" asp-route-priority="@Model.PriorityFilter" asp-route-caseType="@Model.CaseTypeFilter" class="btn btn-danger btn-sm"><i class="bi bi-file-earmark-pdf"></i> PDF</a>
            <a asp-action="Print" asp-route-search="@Model.SearchTerm" asp-route-status="@Model.StatusFilter" asp-route-priority="@Model.PriorityFilter" asp-route-caseType="@Model.CaseTypeFilter" class="btn btn-secondary btn-sm" target="_blank"><i class="bi bi-printer"></i> طباعة</a>
        </div>
    </div>

    <form method="get" class="row g-2 mb-3">
        <div class="col-md-4">
            <input type="text" name="search" class="form-control form-control-sm" placeholder="بحث باسم الطالب أو الرقم الجامعي" value="@Model.SearchTerm" />
        </div>
        <div class="col-md-2">
            <select name="status" class="form-select form-select-sm">
                <option value="">كل الحالات</option>
                @foreach (var s in Model.Statuses)
                {
                    <option value="@s" selected="@(Model.StatusFilter == s)">@s</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <select name="priority" class="form-select form-select-sm">
                <option value="">كل الأولويات</option>
                @foreach (var p in Model.Priorities)
                {
                    <option value="@p" selected="@(Model.PriorityFilter == p)">@p</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <input type="text" name="caseType" class="form-control form-control-sm" placeholder="نوع الحالة" value="@Model.CaseTypeFilter" />
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-primary btn-sm w-100"><i class="bi bi-search"></i> بحث</button>
        </div>
    </form>

    <div class="card shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-striped mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>#</th>
                            <th>الطالب</th>
                            <th>الرقم الجامعي</th>
                            <th>نوع الحالة</th>
                            <th>الأولوية</th>
                            <th>الحالة</th>
                            <th>المسؤول</th>
                            <th>تاريخ الإنشاء</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Cases.Any())
                        {
                            <tr><td colspan="9" class="text-center text-muted py-3">لا توجد نتائج</td></tr>
                        }
                        @foreach (var c in Model.Cases.Select((item, idx) => new { item, idx }))
                        {
                            <tr>
                                <td>@((Model.Page - 1) * 20 + c.idx + 1)</td>
                                <td>@c.item.StudentName</td>
                                <td>@c.item.StudentCode</td>
                                <td>@c.item.CaseType</td>
                                <td>
                                    <span class="badge @(c.item.Priority == "عاجلة" ? "bg-danger" : c.item.Priority == "عالية" ? "bg-warning text-dark" : c.item.Priority == "متوسطة" ? "bg-info text-dark" : "bg-secondary")">
                                        @c.item.Priority
                                    </span>
                                </td>
                                <td>@c.item.Status</td>
                                <td>@c.item.AssignedTo</td>
                                <td>@c.item.CreatedAt?.ToString("yyyy/MM/dd")</td>
                                <td class="text-nowrap">
                                    <a asp-action="Details" asp-route-id="@c.item.CaseId" class="btn btn-outline-info btn-sm" title="عرض"><i class="bi bi-eye"></i></a>
                                    <a asp-action="Edit" asp-route-id="@c.item.CaseId" class="btn btn-outline-primary btn-sm" title="تعديل"><i class="bi bi-pencil"></i></a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    @if (Model.TotalPages > 1)
    {
        <nav class="mt-3">
            <ul class="pagination pagination-sm justify-content-center">
                <li class="page-item @(Model.Page <= 1 ? "disabled" : "")">
                    <a class="page-link" asp-route-search="@Model.SearchTerm" asp-route-status="@Model.StatusFilter" asp-route-priority="@Model.PriorityFilter" asp-route-caseType="@Model.CaseTypeFilter" asp-route-page="@(Model.Page - 1)">السابق</a>
                </li>
                @for (int p = Math.Max(1, Model.Page - 4); p <= Math.Min(Model.TotalPages, Model.Page + 4); p++)
                {
                    <li class="page-item @(p == Model.Page ? "active" : "")">
                        <a class="page-link" asp-route-search="@Model.SearchTerm" asp-route-status="@Model.StatusFilter" asp-route-priority="@Model.PriorityFilter" asp-route-caseType="@Model.CaseTypeFilter" asp-route-page="@p">@p</a>
                    </li>
                }
                <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")">
                    <a class="page-link" asp-route-search="@Model.SearchTerm" asp-route-status="@Model.StatusFilter" asp-route-priority="@Model.PriorityFilter" asp-route-caseType="@Model.CaseTypeFilter" asp-route-page="@(Model.Page + 1)">التالي</a>
                </li>
            </ul>
        </nav>
    }
</div>
