@model List<UniStay.ViewModels.Admin.FeeTypeViewModel>
@{
    ViewData["Title"] = "أنواع الرسوم";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="page-title">أنواع الرسوم</h2>
    <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addModal">
        <i class="bi bi-plus-circle"></i> إضافة نوع رسم
    </button>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show animate-fade-in">@TempData["Success"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show animate-fade-in">@TempData["Error"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
}

<div class="table-responsive">
    <table class="table table-hover table-bordered bg-white animate-fade-in">
        <thead class="table-light">
            <tr>
                <th>#</th>
                <th>الاسم</th>
                <th>الوصف</th>
                <th>التصنيف</th>
                <th>الحالة</th>
                <th>تاريخ الإضافة</th>
                <th>إجراءات</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Any())
            {
                int i = 1;
                foreach (var item in Model)
                {
                    <tr>
                        <td>@(i++)</td>
                        <td>@item.Name</td>
                        <td>@item.Description</td>
                        <td><span class="badge bg-info">@item.FeeCategory</span></td>
                        <td><span class="badge @(item.IsActive ? "bg-success" : "bg-secondary")">@(item.IsActive ? "نشط" : "غير نشط")</span></td>
                        <td>@item.CreatedAt?.ToString("yyyy-MM-dd")</td>
                        <td>
                            <button class="btn btn-outline-warning btn-sm edit-btn"
                                    data-bs-toggle="modal"
                                    data-bs-target="#editModal"
                                    data-id="@item.ID"
                                    data-name="@item.Name"
                                    data-desc="@item.Description"
                                    data-category="@item.FeeCategory"
                                    data-active="@item.IsActive.ToString().ToLower()">
                                <i class="bi bi-pencil"></i> تعديل
                            </button>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr><td colspan="7" class="text-center py-4 text-muted">لا توجد أنواع رسوم مضافة بعد</td></tr>
            }
        </tbody>
    </table>
</div>

<div class="modal fade" id="editModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <form asp-action="EditFeeType" method="post" class="modal-content">
            <input type="hidden" id="editID" name="ID">
            <div class="modal-header">
                <h5 class="modal-title fw-bold">تعديل نوع الرسم</h5>
                <button type="button" class="btn-close m-0 ms-auto" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label fw-semibold">الاسم <span class="text-danger">*</span></label>
                    <input name="Name" id="editName" class="form-control" required>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">الوصف</label>
                    <textarea name="Description" id="editDesc" class="form-control" rows="2"></textarea>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">التصنيف <span class="text-danger">*</span></label>
                    <select name="FeeCategory" id="editCategory" class="form-select" required>
                        <option value="Housing">سكن</option>
                        <option value="Meal">وجبات</option>
                        <option value="Service">خدمات</option>
                        <option value="Fine">غرامات</option>
                        <option value="Other">أخرى</option>
                    </select>
                </div>
                <div class="form-check form-switch">
                    <input name="IsActive" class="form-check-input" type="checkbox" value="true" id="editActive">
                    <label class="form-check-label" for="editActive">نشط</label>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إلغاء</button>
                <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> حفظ</button>
            </div>
        </form>
    </div>
</div>

<div class="modal fade" id="addModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <form asp-action="FeeTypes" method="post" class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title fw-bold">إضافة نوع رسم</h4>
                <button type="button" class="btn-close m-0 ms-auto" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label fw-semibold">الاسم <span class="text-danger">*</span></label>
                    <input name="Name" class="form-control" placeholder="مثال: رسوم السكن" required>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">الوصف</label>
                    <textarea name="Description" class="form-control" rows="2"></textarea>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">التصنيف <span class="text-danger">*</span></label>
                    <select name="FeeCategory" class="form-select" required>
                        <option value="" disabled selected>اختر التصنيف</option>
                        <option value="Housing">سكن</option>
                        <option value="Meal">وجبات</option>
                        <option value="Service">خدمات</option>
                        <option value="Fine">غرامات</option>
                        <option value="Other">أخرى</option>
                    </select>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إلغاء</button>
                <button type="submit" class="btn btn-primary"><i class="bi bi-plus-lg"></i> إضافة</button>
            </div>
        </form>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        var editModal = document.getElementById('editModal');
        editModal.addEventListener('show.bs.modal', function (event) {
            var button = event.relatedTarget;
            document.getElementById('editID').value = button.getAttribute('data-id');
            document.getElementById('editName').value = button.getAttribute('data-name');
            document.getElementById('editDesc').value = button.getAttribute('data-desc');
            document.getElementById('editCategory').value = button.getAttribute('data-category');
            document.getElementById('editActive').checked = button.getAttribute('data-active') === 'true';
        });
    });
</script>