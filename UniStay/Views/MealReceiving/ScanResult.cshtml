@model ScanResultViewModel
@{
    ViewData["Title"] = "نتيجة المسح";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="page-title"><i class="bi bi-upc-scan"></i> نتيجة المسح</h2>
    <a asp-action="Index" class="btn btn-secondary"><i class="bi bi-arrow-right"></i> مسح جديد</a>
</div>

<div class="row">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header bg-primary text-white"><h5 class="mb-0">معلومات الطالب</h5></div>
            <div class="card-body">
                <div class="d-flex align-items-center gap-3 mb-3">
                    @if (!string.IsNullOrEmpty(Model.Photo))
                    {
                        <img src="@Model.Photo" alt="" class="rounded" style="width: 80px; height: 80px; object-fit: cover;">
                    }
                    else
                    {
                        <div class="rounded bg-light d-flex align-items-center justify-content-center" style="width: 80px; height: 80px;">
                            <i class="bi bi-person fs-1 text-muted"></i>
                        </div>
                    }
                    <div>
                        <h5 class="mb-1">@Model.StudentName</h5>
                        <p class="mb-0 text-muted">@Model.NationalID</p>
                        <p class="mb-0 text-muted">@Model.CityName</p>
                    </div>
                </div>
            </div>
        </div>

        <div class="card mt-3">
            <div class="card-header @(Model.IsEligible ? "bg-success" : "bg-danger") text-white">
                <h5 class="mb-0">حالة الأهلية</h5>
            </div>
            <div class="card-body">
                <h4 class="@(Model.IsEligible ? "text-success" : "text-danger")">@Model.EligibilityMessage</h4>
                @if (Model.HasActiveRestriction)
                {
                    <p class="text-muted">سبب الحظر: @Model.RestrictionReason</p>
                }
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card">
            <div class="card-header bg-info text-white"><h5 class="mb-0">الوجبات المتاحة</h5></div>
            <div class="card-body">
                @if (!Model.AvailableMeals.Any())
                {
                    <p class="text-muted text-center py-3">لا توجد وجبات متاحة للاستلام اليوم</p>
                }
                @foreach (var meal in Model.AvailableMeals)
                {
                    <div class="border rounded p-3 mb-2 d-flex justify-content-between align-items-center">
                        <div>
                            <strong>@meal.MealTypeDisplay</strong>
                            <small class="d-block text-muted">@meal.MealDate.ToString("yyyy-MM-dd")</small>
                        </div>
                        <div>
                            <span class="badge bg-info fs-6 ms-2">@meal.Price.ToString("N2")</span>
                            <form asp-action="Confirm" method="post" class="d-inline" onsubmit="return confirm('تأكيد تسليم الوجبة؟')">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="MealID" value="@meal.MealID" />
                                <input type="hidden" name="StudentID" value="@Model.StudentID" />
                                <input type="hidden" name="ScanMethod" value="Barcode" />
                                <button type="submit" class="btn btn-success btn-sm" @(!Model.IsEligible ? "disabled" : "")>
                                    <i class="bi bi-check-lg"></i> تسليم
                                </button>
                            </form>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
