@model List<UniStay.ViewModels.Admin.RoleViewModel>
@{
    ViewData["Title"] = "الأدوار";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="page-title">الأدوار</h2>
    <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addModal">
        <i class="bi bi-plus-circle"></i> إضافة دور
    </button>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show animate-fade-in">@TempData["Success"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show animate-fade-in">@TempData["Error"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
}

<div class="table-responsive">
    <table class="table table-hover table-bordered bg-white animate-fade-in">
        <thead class="table-light">
            <tr>
                <th>#</th>
                <th>الاسم</th>
                <th>الوصف</th>
                <th>عدد المستخدمين</th>
                <th>الحالة</th>
                <th>إجراءات</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Any())
            {
                int i = 1;
                foreach (var item in Model)
                {
                    <tr>
                        <td>@(i++)</td>
                        <td>@item.Name</td>
                        <td>@item.Description</td>
                        <td><span class="badge bg-primary">@item.UserCount</span></td>
                        <td><span class="badge @(item.IsActive ? "bg-success" : "bg-secondary")">@(item.IsActive ? "نشط" : "غير نشط")</span></td>
                        <td>
                            <a asp-action="RolePermissions" asp-route-roleId="@item.ID" class="btn btn-outline-info btn-sm">
                                <i class="bi bi-shield-lock"></i> الصلاحيات
                            </a>
                            <button class="btn btn-outline-warning btn-sm" data-bs-toggle="modal" data-bs-target="#editModal-@item.ID">
                                <i class="bi bi-pencil"></i>
                            </button>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr><td colspan="6" class="text-center py-4 text-muted">لا توجد أدوار مضافة بعد</td></tr>
            }
        </tbody>
    </table>
</div>

@* Modals Section - تم نقلها خارج الجدول هنا *@
@if (Model.Any())
{
    foreach (var item in Model)
    {
        <div class="modal fade" id="editModal-@item.ID" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <form asp-action="EditRole" method="post" class="modal-content">
                    <input type="hidden" name="ID" value="@item.ID">
                    <div class="modal-header">
                        <h5 class="modal-title fw-bold">تعديل @item.Name</h5>
                        <button type="button" class="btn-close m-0 ms-auto" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label fw-semibold">الاسم <span class="text-danger">*</span></label>
                            <input name="Name" class="form-control" value="@item.Name" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">الوصف</label>
                            <textarea name="Description" class="form-control" rows="2">@item.Description</textarea>
                        </div>
                        <div class="form-check form-switch">
                            <input name="IsActive" class="form-check-input" type="checkbox" value="true" checked="@item.IsActive" id="r-active-@item.ID">
                            <label class="form-check-label" for="r-active-@item.ID">نشط</label>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إلغاء</button>
                        <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> حفظ</button>
                    </div>
                </form>
            </div>
        </div>
    }
}

<div class="modal fade" id="addModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <form asp-action="Roles" method="post" class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title fw-bold">إضافة دور</h4>
                <button type="button" class="btn-close m-0 ms-auto" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label fw-semibold">الاسم <span class="text-danger">*</span></label>
                    <input name="Name" class="form-control" placeholder="مثال: مشرف مدينة" required>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">الوصف</label>
                    <textarea name="Description" class="form-control" rows="2"></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إلغاء</button>
                <button type="submit" class="btn btn-primary"><i class="bi bi-plus-lg"></i> إضافة</button>
            </div>
        </form>
    </div>
</div>