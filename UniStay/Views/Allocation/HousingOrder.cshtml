@model HousingOrderViewModel
@{
    ViewData["Title"] = "أمر تسكين";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-file-earmark-text"></i> أمر تسكين</h2>
        <a asp-action="Index" class="btn btn-secondary"><i class="bi bi-arrow-right"></i> العودة</a>
    </div>

    <div class="row">
        <div class="col-md-5">
            <div class="card mb-4">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">اختيار الطالب</h5>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <label class="form-label">بحث</label>
                        <input type="text" id="studentSearch" class="form-control mb-2" placeholder="بحث بالاسم أو الرقم القومي..." />
                    </div>
                    <div class="table-responsive" style="max-height:400px;overflow-y:auto;">
                        <table class="table table-sm table-hover" id="studentsTable">
                            <thead>
                                <tr>
                                    <th>الطالب</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var s in (IEnumerable<UniStay.ViewModels.Allocation.StudentAllocationRow>)ViewBag.Students)
                                {
                                    <tr class="student-row">
                                        <td>
                                            <strong>@s.StudentName</strong><br />
                                            <small class="text-muted">@s.NationalID - @s.Faculty</small><br />
                                            <small class="text-muted">@s.BuildingName / غرفة @s.RoomNumber</small>
                                        </td>
                                        <td>
                                            <a asp-action="HousingOrder" asp-route-studentId="@s.StudentID"
                                               class="btn btn-sm btn-outline-primary">
                                                <i class="bi bi-file-earmark-text"></i> عرض
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    @if (!Model.StudentAllocations.Any())
                    {
                        <div class="alert alert-info">لا يوجد طلاب مسكنين</div>
                    }
                </div>
            </div>
        </div>

        <div class="col-md-7">
            @if (Model.StudentID > 0)
            {
                <div class="card" id="printArea">
                    <div class="card-header bg-success text-white d-flex justify-content-between align-items-center">
                        <h5 class="mb-0"><i class="bi bi-file-earmark-text"></i> أمر تسكين</h5>
                        <div>
                            <button class="btn btn-light btn-sm me-1" onclick="window.print()">
                                <i class="bi bi-printer"></i> طباعة
                            </button>
                            <a asp-action="PrintHousingOrder" asp-route-allocationId="@Model.AllocationID"
                               class="btn btn-light btn-sm" target="_blank">
                                <i class="bi bi-printer"></i> طباعة بصفحة كاملة
                            </a>
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="text-center mb-4">
                            <h4>جامعة أسيوط</h4>
                            <h5>الإدارة العامة للمدن الجامعية</h5>
                            <h3 class="text-primary">أمر تسكين</h3>
                            <p class="text-muted">رقم الأمر: <strong>@Model.OrderNumber</strong></p>
                        </div>

                        <table class="table table-bordered">
                            <tr>
                                <th style="width:200px">اسم الطالب</th>
                                <td>@Model.StudentName</td>
                            </tr>
                            <tr>
                                <th>الرقم القومي</th>
                                <td>@Model.NationalID</td>
                            </tr>
                            <tr>
                                <th>الكلية</th>
                                <td>@Model.Faculty</td>
                            </tr>
                            <tr>
                                <th>العام الدراسي</th>
                                <td>@Model.AcademicYear</td>
                            </tr>
                            <tr>
                                <th>المدينة الجامعية</th>
                                <td>@Model.CityName</td>
                            </tr>
                            <tr>
                                <th>المبنى</th>
                                <td>@Model.BuildingName</td>
                            </tr>
                            <tr>
                                <th>رقم الغرفة</th>
                                <td>@Model.RoomNumber</td>
                            </tr>
                            <tr>
                                <th>رقم السرير</th>
                                <td>@Model.BedNumber</td>
                            </tr>
                            <tr>
                                <th>نوع السكن</th>
                                <td>@Model.HousingType</td>
                            </tr>
                            <tr>
                                <th>تاريخ التسكين</th>
                                <td>@Model.StartDate</td>
                            </tr>
                        </table>

                        <div class="row mt-4">
                            <div class="col-6 text-center">
                                <p>_________________________</p>
                                <p>مدير الإدارة</p>
                            </div>
                            <div class="col-6 text-center">
                                <p>_________________________</p>
                                <p>الطالب</p>
                            </div>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="card">
                    <div class="card-body text-center text-muted py-5">
                        <i class="bi bi-file-earmark-text fs-1"></i>
                        <p class="mt-2">اختر طالباً من القائمة لعرض أمر التسكين</p>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('studentSearch')?.addEventListener('keyup', function () {
            var filter = this.value.toLowerCase();
            var rows = document.querySelectorAll('.student-row');
            rows.forEach(function (row) {
                row.style.display = row.textContent.toLowerCase().includes(filter) ? '' : 'none';
            });
        });
    </script>
}

<style media="print">
    body * { visibility: hidden; }
    #printArea, #printArea * { visibility: visible; }
    #printArea { position: absolute; left: 0; top: 0; width: 100%; }
    .sidebar, .topbar, .btn, .card-header .btn, .card-header a:not(.btn) { display: none !important; }
</style>
