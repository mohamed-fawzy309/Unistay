@{
    ViewData["Title"] = "UniStay - عن النظام";
    Layout = null;
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>UniStay — عن النظام</title>
    <link href="~/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@300;400;500;700;800;900&display=swap" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet" />
    <style>
        :root {
            --red: #e63946;
            --red-dark: #b52530;
            --red-dim: rgba(230,57,70,.15);
            --black: #080b10;
            --black-2: #0f1319;
            --black-3: #161c26;
            --black-4: #1e2736;
            --border: #1e2736;
            --text: #e8eaf0;
            --muted: #6b7a99;
        }

        *, *::before, *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            font-family: 'Tajawal', sans-serif;
            background: var(--black);
            color: var(--text);
            overflow-x: hidden;
        }

        ::-webkit-scrollbar {
            width: 5px;
        }

        ::-webkit-scrollbar-track {
            background: var(--black);
        }

        ::-webkit-scrollbar-thumb {
            background: var(--red-dark);
            border-radius: 3px;
        }

        /* NAVBAR */
        .navbar {
            background: rgba(8,11,16,.85);
            backdrop-filter: blur(16px);
            border-bottom: 1px solid rgba(230,57,70,.12);
            padding: .9rem 0;
            position: fixed;
            top: 0;
            width: 100%;
            z-index: 1000;
            transition: all .3s;
        }

            .navbar.scrolled {
                background: rgba(8,11,16,.97);
                box-shadow: 0 4px 30px rgba(0,0,0,.5);
            }

        .navbar-brand {
            font-size: 1.5rem;
            font-weight: 900;
            background: linear-gradient(135deg,#ff6b7a,var(--red));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .nav-link {
            color: var(--muted) !important;
            font-weight: 500;
            font-size: .9rem;
            transition: color .2s;
            padding: .4rem .9rem !important;
        }

            .nav-link:hover {
                color: #fff !important;
            }

        .btn-nav-login {
            background: transparent;
            border: 1px solid var(--red);
            color: var(--red) !important;
            border-radius: 8px;
            padding: .35rem 1.1rem !important;
            font-size: .88rem;
            font-weight: 600;
            transition: all .25s;
        }

            .btn-nav-login:hover {
                background: var(--red);
                color: #fff !important;
            }

        .btn-nav-reg {
            background: var(--red);
            border: 1px solid var(--red);
            color: #fff !important;
            border-radius: 8px;
            padding: .35rem 1.1rem !important;
            font-size: .88rem;
            font-weight: 600;
            transition: all .25s;
            margin-right: .4rem;
        }

            .btn-nav-reg:hover {
                background: var(--red-dark);
                border-color: var(--red-dark);
            }

        /* PAGE HERO */
        .page-hero {
            padding: 9rem 0 4rem;
            position: relative;
            overflow: hidden;
            background: linear-gradient(180deg, var(--black) 0%, var(--black-2) 100%);
        }

            .page-hero::before {
                content: '';
                position: absolute;
                inset: 0;
                background-image: linear-gradient(rgba(230,57,70,.04) 1px,transparent 1px), linear-gradient(90deg,rgba(230,57,70,.04) 1px,transparent 1px);
                background-size: 55px 55px;
            }

        .orb {
            position: absolute;
            border-radius: 50%;
            filter: blur(90px);
            pointer-events: none;
        }

        .o1 {
            width: 500px;
            height: 500px;
            background: rgba(230,57,70,.07);
            top: -150px;
            left: -100px;
        }

        .o2 {
            width: 350px;
            height: 350px;
            background: rgba(10,20,50,.4);
            bottom: -50px;
            right: -80px;
        }

        .page-hero-inner {
            position: relative;
            z-index: 2;
            text-align: center;
        }

        .section-tag {
            display: inline-block;
            background: var(--red-dim);
            border: 1px solid rgba(230,57,70,.2);
            color: var(--red);
            border-radius: 50px;
            padding: .3rem .9rem;
            font-size: .78rem;
            font-weight: 600;
            letter-spacing: .1em;
            text-transform: uppercase;
            margin-bottom: 1rem;
        }

        .page-title {
            font-size: clamp(2rem,5vw,3.2rem);
            font-weight: 900;
            margin-bottom: .8rem;
        }

            .page-title .red {
                background: linear-gradient(135deg,#ff6b7a,var(--red));
                -webkit-background-clip: text;
                -webkit-text-fill-color: transparent;
            }

        .page-sub {
            color: var(--muted);
            font-size: 1rem;
            max-width: 500px;
            margin: 0 auto;
            line-height: 1.8;
        }

        @@keyframes fadeUp {
            from {
                opacity: 0;
                transform: translateY(24px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .fade-up {
            animation: fadeUp .7s both;
        }

        .fade-up-2 {
            animation: fadeUp .7s .15s both;
        }

        .fade-up-3 {
            animation: fadeUp .7s .3s both;
        }

        /* CONTENT */
        .content-section {
            padding: 5rem 0;
        }

        .content-card {
            background: var(--black-2);
            border: 1px solid var(--border);
            border-radius: 20px;
            padding: 2.5rem;
            transition: border-color .3s, box-shadow .3s;
        }

            .content-card:hover {
                border-color: rgba(230,57,70,.25);
                box-shadow: 0 20px 50px rgba(0,0,0,.35);
            }

        .content-card-icon {
            width: 56px;
            height: 56px;
            border-radius: 14px;
            background: var(--red-dim);
            border: 1px solid rgba(230,57,70,.2);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.4rem;
            color: var(--red);
            margin-bottom: 1.5rem;
        }

        .content-card-title {
            font-size: 1.15rem;
            font-weight: 800;
            margin-bottom: 1rem;
        }

        .content-card-text {
            color: var(--muted);
            font-size: .9rem;
            line-height: 1.9;
        }

        /* FEATURES LIST */
        .feat-list {
            list-style: none;
            padding: 0;
            margin: 0;
        }

            .feat-list li {
                display: flex;
                align-items: flex-start;
                gap: .75rem;
                color: var(--muted);
                font-size: .9rem;
                padding: .55rem 0;
                border-bottom: 1px solid rgba(255,255,255,.04);
            }

                .feat-list li:last-child {
                    border-bottom: none;
                }

                .feat-list li .icon {
                    width: 26px;
                    height: 26px;
                    border-radius: 6px;
                    background: var(--red-dim);
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    font-size: .7rem;
                    color: var(--red);
                    flex-shrink: 0;
                    margin-top: 1px;
                }

        /* CONTACT CARD */
        .contact-card {
            background: linear-gradient(135deg, var(--black-3), var(--black-4));
            border: 1px solid rgba(230,57,70,.2);
            border-radius: 20px;
            padding: 2.5rem;
            position: relative;
            overflow: hidden;
        }

            .contact-card::before {
                content: '';
                position: absolute;
                top: -60px;
                right: -60px;
                width: 200px;
                height: 200px;
                border-radius: 50%;
                background: rgba(230,57,70,.06);
                filter: blur(40px);
                pointer-events: none;
            }

        .contact-row {
            display: flex;
            align-items: center;
            gap: .75rem;
            margin-bottom: 1rem;
            color: var(--muted);
            font-size: .9rem;
        }

            .contact-row:last-child {
                margin-bottom: 0;
            }

            .contact-row .ci {
                width: 36px;
                height: 36px;
                border-radius: 9px;
                background: var(--red-dim);
                border: 1px solid rgba(230,57,70,.15);
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: .85rem;
                color: var(--red);
                flex-shrink: 0;
            }

            .contact-row strong {
                color: var(--text);
                display: block;
                font-size: .82rem;
                margin-bottom: .1rem;
            }

        /* STATS STRIP */
        .stats-strip {
            background: var(--black-2);
            border-top: 1px solid var(--border);
            border-bottom: 1px solid var(--border);
            padding: 3rem 0;
        }

        .stat-box {
            text-align: center;
        }

        .stat-num-lg {
            font-size: 2.2rem;
            font-weight: 900;
            background: linear-gradient(135deg,#ff6b7a,var(--red));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            display: block;
        }

        .stat-lbl {
            color: var(--muted);
            font-size: .8rem;
            letter-spacing: .06em;
            margin-top: .2rem;
        }

        /* REVEAL */
        .reveal {
            opacity: 0;
            transform: translateY(28px);
            transition: opacity .7s, transform .7s;
        }

            .reveal.visible {
                opacity: 1;
                transform: translateY(0);
            }

        /* FOOTER */
        footer {
            background: var(--black-2);
            border-top: 1px solid var(--border);
            padding: 2.5rem 0;
            text-align: center;
        }

        .footer-brand {
            font-size: 1.1rem;
            font-weight: 900;
            background: linear-gradient(135deg,#ff6b7a,var(--red));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            margin-bottom: .4rem;
        }

        .footer-text {
            color: var(--muted);
            font-size: .82rem;
        }

        @@media (max-width:768px) {
            .content-section {
                padding: 3rem 0;
            }
        }
    </style>
</head>
<body>

    <!-- NAVBAR -->
    <nav class="navbar navbar-expand-lg">
        <div class="container">
            <a class="navbar-brand" href="/"><img src="~/images/Unistay_logo.png" alt="UniStay" style="height:48px;filter:drop-shadow(0 2px 8px rgba(230,57,70,.3))"></a>
            <div class="collapse navbar-collapse" id="nav">
                <ul class="navbar-nav mx-auto gap-1">
                    <li class="nav-item"><a class="nav-link" href="/Home/Announcements">الإعلانات</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Home/Cities">المدن الجامعية</a></li>
                    <li class="nav-item"><a class="nav-link" href="/#features">المميزات</a></li>
                    <li class="nav-item"><a class="nav-link" href="/#how">كيف يعمل</a></li>
                    <li class="nav-item"><a class="nav-link active" href="/Home/About" style="color:#fff!important">عن النظام</a></li>
                </ul>
                <div class="d-flex gap-2 mt-2 mt-lg-0">
                    <a href="/Home/Dates" class="nav-link btn-nav-login">مواعيد التقدم</a>
                    <a href="/Home/Accept" class="nav-link btn-nav-reg">استعلام عن القبول</a>
                </div>
            </div>
        </div>
    </nav>

    <!-- PAGE HERO -->
    <div class="page-hero">
        <div class="orb o1"></div>
        <div class="orb o2"></div>
        <div class="container">
            <div class="page-hero-inner">
                <div class="section-tag fade-up"><i class="fa-solid fa-circle-info" style="margin-left:.4rem"></i>عن النظام</div>
                <h1 class="page-title fade-up-2">عن <span class="red">UniStay</span></h1>
                <p class="page-sub fade-up-3">نظام متكامل لإدارة المدن الجامعية بجامعة أسيوط</p>
            </div>
        </div>
    </div>

    <!-- STATS STRIP -->
    <div class="stats-strip">
        <div class="container">
            <div class="row g-4 text-center">
                <div class="col-6 col-md-3 reveal">
                    <div class="stat-box">
                        <span class="stat-num-lg" data-target="10000">0</span>
                        <div class="stat-lbl">سعة المدينة</div>
                    </div>
                </div>
                <div class="col-6 col-md-3 reveal">
                    <div class="stat-box">
                        <span class="stat-num-lg" data-target="1000">0</span>
                        <div class="stat-lbl">غرفة متاحة</div>
                    </div>
                </div>
                <div class="col-6 col-md-3 reveal">
                    <div class="stat-box">
                        <span class="stat-num-lg" data-target="98">0</span>
                        <div class="stat-lbl">% نسبة الرضا</div>
                    </div>
                </div>
                <div class="col-6 col-md-3 reveal">
                    <div class="stat-box">
                        <span class="stat-num-lg" data-target="24">0</span>
                        <div class="stat-lbl">ساعة دعم</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- CONTENT -->
    <section class="content-section">
        <div class="container">

            <!-- About Card -->
            <div class="row g-4 mb-4">
                <div class="col-12 reveal">
                    <div class="content-card">
                        <div class="content-card-icon"><i class="fa-solid fa-university"></i></div>
                        <div class="content-card-title">نظام إدارة المدن الجامعية</div>
                        <div class="content-card-text">
                            UniStay هو نظام متكامل لإدارة المدن الجامعية بجامعة أسيوط، يهدف إلى تسهيل عملية التقديم والتسكين
                            وإدارة جميع جوانب الحياة الطلابية داخل المدن الجامعية.
                            تم تصميم النظام ليكون سهل الاستخدام ومتكامل الخدمات لكل طالب ومسؤول.
                        </div>
                    </div>
                </div>
            </div>

            <div class="row g-4">
                <!-- Features -->
                <div class="col-md-6 reveal">
                    <div class="content-card h-100">
                        <div class="content-card-icon"><i class="fa-solid fa-star"></i></div>
                        <div class="content-card-title">المميزات</div>
                        <ul class="feat-list">
                            <li>
                                <span class="icon"><i class="fa-solid fa-file-circle-check"></i></span>
                                <span>إدارة طلبات التقديم والتسكين</span>
                            </li>
                            <li>
                                <span class="icon"><i class="fa-solid fa-calendar-check"></i></span>
                                <span>متابعة الحضور والغياب</span>
                            </li>
                            <li>
                                <span class="icon"><i class="fa-solid fa-triangle-exclamation"></i></span>
                                <span>تسجيل المخالفات</span>
                            </li>
                            <li>
                                <span class="icon"><i class="fa-solid fa-credit-card"></i></span>
                                <span>إدارة المدفوعات</span>
                            </li>
                            <li>
                                <span class="icon"><i class="fa-solid fa-bell"></i></span>
                                <span>التواصل مع الطلاب والإعلانات</span>
                            </li>
                            <li>
                                <span class="icon"><i class="fa-solid fa-wrench"></i></span>
                                <span>إدارة طلبات الصيانة</span>
                            </li>
                            <li>
                                <span class="icon"><i class="fa-solid fa-utensils"></i></span>
                                <span>نظام إدارة الوجبات</span>
                            </li>
                        </ul>
                    </div>
                </div>

                <!-- Contact -->
                <div class="col-md-6 reveal">
                    <div class="contact-card h-100">
                        <div class="content-card-icon"><i class="fa-solid fa-headset"></i></div>
                        <div class="content-card-title">تواصل معنا</div>
                        <div class="contact-row">
                            <span class="ci"><i class="fa-solid fa-building"></i></span>
                            <div>
                                <strong>الجهة</strong>
                                الإدارة العامة للمدن الجامعية
                            </div>
                        </div>
                        <div class="contact-row">
                            <span class="ci"><i class="fa-solid fa-graduation-cap"></i></span>
                            <div>
                                <strong>الجامعة</strong>
                                جامعة أسيوط
                            </div>
                        </div>
                        <div class="contact-row">
                            <span class="ci"><i class="fa-solid fa-flag"></i></span>
                            <div>
                                <strong>الدولة</strong>
                                جمهورية مصر العربية
                            </div>
                        </div>
                        <div class="contact-row">
                            <span class="ci"><i class="fa-solid fa-envelope"></i></span>
                            <div>
                                <strong>البريد الإلكتروني</strong>
                                dormitory@aun.edu.eg
                            </div>
                        </div>
                        <div style="margin-top:2rem">
                            <a href="/Application/Apply" style="
                                display:inline-flex;align-items:center;gap:.5rem;
                                background:linear-gradient(135deg,var(--red),var(--red-dark));
                                color:#fff;border:none;border-radius:10px;
                                padding:.7rem 1.5rem;font-family:'Tajawal',sans-serif;
                                font-size:.9rem;font-weight:700;text-decoration:none;
                                transition:transform .2s,box-shadow .2s;
                            " onmouseover="this.style.transform='translateY(-3px)';this.style.boxShadow='0 10px 30px rgba(230,57,70,.4)'"
                               onmouseout="this.style.transform='';this.style.boxShadow=''">
                                <i class="fa-solid fa-user-plus"></i>
                                سجّل الآن
                            </a>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </section>

    <!-- FOOTER -->
    <footer>
        <div class="container">
            <div class="footer-brand">UniStay</div>
            <div class="footer-text">
                <span>نظام إدارة السكن الجامعي</span> &nbsp;·&nbsp; جميع الحقوق محفوظة &nbsp;·&nbsp; &copy; 2026
            </div>
        </div>
    </footer>

    <script src="/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        window.addEventListener('scroll', () => {
            document.querySelector('.navbar').classList.toggle('scrolled', scrollY > 40);
        });
        const revealObserver = new IntersectionObserver(entries => {
            entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('visible'); revealObserver.unobserve(e.target); } });
        }, { threshold: .12 });
        document.querySelectorAll('.reveal').forEach((el, i) => { el.style.transitionDelay = (i % 4) * .08 + 's'; revealObserver.observe(el); });

        const counters = document.querySelectorAll('[data-target]');
        const countObserver = new IntersectionObserver(entries => {
            entries.forEach(e => {
                if (!e.isIntersecting) return;
                const el = e.target, end = +el.dataset.target, dur = 1800, step = 16;
                const inc = end / (dur / step); let cur = 0;
                const timer = setInterval(() => {
                    cur = Math.min(cur + inc, end);
                    el.textContent = Math.floor(cur).toLocaleString('ar-EG');
                    if (cur >= end) clearInterval(timer);
                }, step);
                countObserver.unobserve(el);
            });
        }, { threshold: .5 });
        counters.forEach(c => countObserver.observe(c));
    </script>
</body>
</html>
