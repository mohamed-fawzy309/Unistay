@model UniStay.ViewModels.Admin.BuildingLayoutViewModel?
@{
    ViewData["Title"] = "الكروكي التفاعلي";
    var buildings = (IEnumerable<dynamic>)ViewBag.AllBuildings;
    int? selectedId = ViewBag.SelectedId;
}

<h2 class="mb-3">الكروكي التفاعلي</h2>

<div class="row">
    <div class="col-md-3 mb-3">
        <div class="card shadow-sm">
            <div class="card-header bg-dark text-white">
                <h6 class="mb-0">اختاري المبنى</h6>
            </div>
            <div class="list-group list-group-flush">
                @foreach (var b in buildings)
                {
                    <a asp-action="BuildingLayout" asp-route-id="@b.ID"
                       class="list-group-item list-group-item-action @(selectedId == b.ID ? "active" : "")">
                        @b.BuildingName <small class="text-muted">- @b.CityName</small>
                    </a>
                }
            </div>
        </div>
    </div>

    <div class="col-md-9">
        @if (Model == null)
        {
            <div class="alert alert-info">اختاري مبنى من القايمة على اليمين لعرض الكروكي بتاعه.</div>
        }
        else
        {
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h4>@Model.BuildingName</h4>
                <div class="d-flex gap-2">
                    <span class="badge bg-primary fs-6">@Model.CityName</span>
                    <span class="badge bg-info fs-6">@Model.FloorCount أدوار</span>
                    <span class="badge bg-success fs-6">@Model.AvailableBeds سرير متاح</span>
                    <span class="badge bg-secondary fs-6">@Model.TotalBeds إجمالي</span>
                </div>
            </div>

            @foreach (var floor in Model.Floors)
            {
                <div class="card shadow-sm mb-3">
                    <div class="card-header bg-white">
                        <h5 class="mb-0">الدور @floor.FloorNumber</h5>
                    </div>
                    <div class="card-body">
                        <div class="row g-2">
                            @foreach (var room in floor.Rooms)
                            {
                                <div class="col-md-3 col-6">
                                    <div class="card @(room.IsFull ? "border-danger" : room.AvailableBeds > 0 ? "border-success" : "border-secondary")">
                                        <div class="card-body text-center p-2">
                                            <h6 class="mb-1">@room.RoomNumber</h6>
                                            <small class="text-muted">@room.RoomType</small>
                                            <div class="mt-1">
                                                @for (int b = 1; b <= room.BedsCount; b++)
                                                {
                                                    var isOccupied = b <= room.CurrentOccupancy;
                                                    <span class="d-inline-block rounded-circle @(isOccupied ? "bg-danger" : "bg-success")" style="width:12px;height:12px;"
                                                          title="@(isOccupied ? $"سرير {b} مشغول" : $"سرير {b} متاح")"></span>
                                                }
                                            </div>
                                            <small class="d-block mt-1">
                                                <span class="text-danger">@room.CurrentOccupancy</span>/<span class="text-success">@room.AvailableBeds</span>
                                            </small>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>
