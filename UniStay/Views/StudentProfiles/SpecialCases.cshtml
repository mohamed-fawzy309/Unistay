@model StudentSpecialCasesVM
@{
    ViewData["Title"] = "حالات الطالب";
}

<div class="container-fluid" dir="rtl">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="mb-0"><i class="bi bi-exclamation-triangle"></i> حالات الطالب</h4>
        <div>
            <a asp-action="Details" asp-route-id="@Model.StudentId" class="btn btn-outline-info btn-sm"><i class="bi bi-person-vcard"></i> بيانات أساسية</a>
            <a asp-action="Status" asp-route-id="@Model.StudentId" class="btn btn-outline-primary btn-sm"><i class="bi bi-card-list"></i> بيان حالة</a>
            <a asp-action="Index" class="btn btn-outline-dark btn-sm"><i class="bi bi-arrow-right"></i> عودة</a>
        </div>
    </div>

    <div class="card bg-light mb-3">
        <div class="card-body py-2">
            <strong>الطالب:</strong> @Model.StudentName | <strong>الرقم الجامعي:</strong> @Model.StudentCode
        </div>
    </div>

    <div class="row">
        <div class="col-md-6">
            <div class="card shadow-sm mb-3">
                <div class="card-header bg-warning text-dark"><i class="bi bi-star"></i> الحالات الخاصة</div>
                <div class="card-body p-0">
                    <table class="table table-sm mb-0">
                        <thead>
                            <tr><th>النوع</th><th>الوصف</th><th>الحالة</th><th>ملاحظات</th><th>التاريخ</th><th></th></tr>
                        </thead>
                        <tbody>
                            @foreach (var c in Model.SpecialCases)
                            {
                                <tr>
                                    <td>@c.CaseType</td>
                                    <td>@c.Description</td>
                                    <td>
                                        <span class="badge @(c.Status == "Approved" ? "bg-success" : c.Status == "Rejected" ? "bg-danger" : "bg-warning text-dark")">
                                            @(c.Status == "Approved" ? "مقبول" : c.Status == "Rejected" ? "مرفوض" : "قيد المراجعة")
                                        </span>
                                    </td>
                                    <td>@c.ReviewNotes</td>
                                    <td>@c.CreatedAt?.ToString("yyyy/MM/dd")</td>
                                    <td class="text-nowrap">
                                        @if (c.Status == "Pending")
                                        {
                                            <form method="post" asp-action="ApproveSpecialCase" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="caseId" value="@c.CaseId" />
                                                <button type="submit" class="btn btn-success btn-sm" title="قبول"><i class="bi bi-check-lg"></i></button>
                                            </form>
                                            <button type="button" class="btn btn-danger btn-sm" title="رفض" data-bs-toggle="modal" data-bs-target="#rejectModal" data-caseid="@c.CaseId"><i class="bi bi-x-lg"></i></button>
                                        }
                                    </td>
                                </tr>
                            }
                            @if (!Model.SpecialCases.Any()) { <tr><td colspan="6" class="text-center text-muted">لا توجد حالات خاصة</td></tr> }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card shadow-sm mb-3">
                <div class="card-header bg-info text-white d-flex justify-content-between align-items-center">
                    <span><i class="bi bi-search-heart"></i> حالات البحث الاجتماعي</span>
                    <button type="button" class="btn btn-light btn-sm" data-bs-toggle="modal" data-bs-target="#addSocialCaseModal"><i class="bi bi-plus-lg"></i> إضافة</button>
                </div>
                <div class="card-body p-0">
                    <table class="table table-sm mb-0">
                        <thead>
                            <tr><th>النوع</th><th>الوصف</th><th>الأولوية</th><th>الحالة</th><th>التاريخ</th><th></th></tr>
                        </thead>
                        <tbody>
                            @foreach (var c in Model.SocialCases)
                            {
                                <tr>
                                    <td>@c.CaseType</td>
                                    <td>@c.Description</td>
                                    <td>
                                        <span class="badge @(c.Priority == "عاجلة" ? "bg-danger" : c.Priority == "عالية" ? "bg-warning text-dark" : c.Priority == "متوسطة" ? "bg-info text-dark" : "bg-secondary")">
                                            @c.Priority
                                        </span>
                                    </td>
                                    <td>@c.Status</td>
                                    <td>@c.CreatedAt?.ToString("yyyy/MM/dd")</td>
                                    <td>
                                        <a asp-controller="SocialCases" asp-action="Details" asp-route-id="@c.CaseId" class="btn btn-outline-info btn-sm"><i class="bi bi-eye"></i></a>
                                    </td>
                                </tr>
                            }
                            @if (!Model.SocialCases.Any()) { <tr><td colspan="6" class="text-center text-muted">لا توجد حالات بحث اجتماعي</td></tr> }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Reject Modal -->
<div class="modal fade" id="rejectModal" tabindex="-1" dir="rtl">
    <div class="modal-dialog">
        <form method="post" asp-action="RejectSpecialCase" class="modal-content">
            @Html.AntiForgeryToken()
            <div class="modal-header">
                <h5 class="modal-title">رفض الحالة الخاصة</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" name="caseId" id="rejectCaseId" />
                <div class="mb-3">
                    <label class="form-label">ملاحظات الرفض</label>
                    <textarea name="notes" class="form-control" rows="3"></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إلغاء</button>
                <button type="submit" class="btn btn-danger">تأكيد الرفض</button>
            </div>
        </form>
    </div>
</div>

<!-- Add SocialCase Modal -->
<div class="modal fade" id="addSocialCaseModal" tabindex="-1" dir="rtl">
    <div class="modal-dialog">
        <form method="post" asp-action="AddSocialCase" class="modal-content">
            @Html.AntiForgeryToken()
            <div class="modal-header">
                <h5 class="modal-title">إضافة حالة بحث اجتماعي</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" name="studentId" value="@Model.StudentId" />
                <div class="mb-3">
                    <label class="form-label">نوع الحالة</label>
                    <input name="caseType" class="form-control" required />
                </div>
                <div class="mb-3">
                    <label class="form-label">الوصف</label>
                    <textarea name="description" class="form-control" rows="3" required></textarea>
                </div>
                <div class="mb-3">
                    <label class="form-label">الأولوية</label>
                    <select name="priority" class="form-select">
                        <option value="عاجلة">عاجلة</option>
                        <option value="عالية">عالية</option>
                        <option value="متوسطة" selected>متوسطة</option>
                        <option value="منخفضة">منخفضة</option>
                    </select>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إلغاء</button>
                <button type="submit" class="btn btn-primary">إضافة</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        var rejectModal = document.getElementById('rejectModal');
        if (rejectModal) {
            rejectModal.addEventListener('show.bs.modal', function (event) {
                var button = event.relatedTarget;
                var caseId = button.getAttribute('data-caseid');
                document.getElementById('rejectCaseId').value = caseId;
            });
        }
    </script>
}
