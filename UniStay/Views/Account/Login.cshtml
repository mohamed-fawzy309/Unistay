@model UniStay.ViewModels.Account.LoginViewModel
@{
    ViewData["Title"] = "تسجيل دخول الموظفين - UniStay";
    Layout = "~/Views/Shared/_LoginLayout.cshtml";
}

<div class="container">
    <div class="row justify-content-center align-items-center" style="min-height:75vh">
        <div class="col-lg-5 col-md-7 col-sm-10">
            <div class="login-card">
                <div class="login-header">
                    <div style="margin-bottom:.5rem">
                        <i class="fas fa-user-shield" style="font-size:2.2rem;color:var(--red);opacity:.8"></i>
                    </div>
                    <h4>نظام إدارة المدن الجامعية</h4>
                    <p>جامعة أسيوط — UniStay</p>
                </div>
                <div class="login-body">
                    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                    {
                        <div class="alert alert-danger">@Model.ErrorMessage</div>
                    }

                    @if (TempData["Success"] != null)
                    {
                        <div class="alert" style="background:rgba(16,185,129,.12);border:1px solid rgba(16,185,129,.25);color:#10b981;border-radius:10px;font-size:.9rem;padding:.8rem 1rem;">@TempData["Success"]</div>
                    }

                    <form asp-action="Login" method="post" asp-route-returnUrl="@ViewData["ReturnUrl"]">
                        @Html.AntiForgeryToken()

                        <div class="mb-4">
                            <label class="form-label">اسم المستخدم</label>
                            <input asp-for="Name" class="form-control" placeholder="أدخل اسم المستخدم" />
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>

                        <div class="mb-4">
                            <label class="form-label">كلمة المرور</label>
                            <input asp-for="Password" type="password" class="form-control" placeholder="••••••••" />
                            <span asp-validation-for="Password" class="text-danger"></span>
                        </div>

                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <div class="form-check">
                                <input asp-for="RememberMe" class="form-check-input" type="checkbox">
                                <label asp-for="RememberMe" class="form-check-label">تذكرني</label>
                            </div>
                            <a asp-action="ForgotPassword" style="color:var(--red);text-decoration:none;font-weight:600;font-size:.88rem;transition:color .2s;" onmouseover="this.style.color='#ff6b7a'" onmouseout="this.style.color='var(--red)'">نسيت كلمة المرور؟</a>
                        </div>

                        <button type="submit" class="btn-login">
                            <i class="fas fa-arrow-left" style="margin-left:.5rem;"></i>
                            دخول
                        </button>
                    </form>
                </div>
                <div class="login-footer">
                    <a href="/">
                        <i class="fas fa-arrow-right" style="margin-left:.35rem;"></i>
                        العودة للصفحة الرئيسية
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}