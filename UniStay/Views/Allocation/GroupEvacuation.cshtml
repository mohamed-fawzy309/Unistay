@model GroupEvacuationViewModel
@{
    ViewData["Title"] = "إخلاء جماعى";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-person-x-fill"></i> إخلاء جماعى</h2>
        <a asp-action="Index" class="btn btn-secondary"><i class="bi bi-arrow-right"></i> العودة</a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            <i class="bi bi-check-circle-fill"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            <i class="bi bi-exclamation-circle-fill"></i> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <form method="post" id="evacuationForm">
        @Html.AntiForgeryToken()

        <div class="card mb-4">
            <div class="card-header bg-danger text-white">
                <h5 class="mb-0"><i class="bi bi-exclamation-triangle"></i> تحديد سبب الإخلاء</h5>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-8">
                        <label class="form-label" for="Reason">سبب الإخلاء <span class="text-danger">*</span></label>
                        <textarea asp-for="Reason" class="form-control" rows="2" required
                                  placeholder="أدخل سبب الإخلاء (مثل: نهاية العام الدراسي، فصل، مخالفة، ...)"></textarea>
                        <span asp-validation-for="Reason" class="text-danger"></span>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label" for="EvictionType">نوع الإخلاء</label>
                        <select asp-for="EvictionType" class="form-select">
                            <option value="Administrative">إداري</option>
                            <option value="EndOfYear">نهاية العام</option>
                            <option value="Disciplinary">تأديبي</option>
                            <option value="Voluntary">طوعي</option>
                            <option value="Graduation">تخرج</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>

        <div class="card">
            <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                <h5 class="mb-0"><i class="bi bi-people-fill"></i> الطلاب المسكنين</h5>
                <button type="submit" class="btn btn-light text-danger fw-bold" id="evacuateBtn" disabled
                        onclick="return confirm('هل أنت متأكد من إخلاء الطلاب المحددين؟ هذا الإجراء لا يمكن التراجع عنه.')">
                    <i class="bi bi-person-x-fill"></i> إخلاء المحددين
                </button>
            </div>
            <div class="card-body">
                <!-- Filters -->
                <div class="row mb-3">
                    <div class="col-md-3">
                        <div class="input-group">
                            <input type="text" id="searchInput" class="form-control" placeholder="بحث بالاسم أو الرقم القومي..." value="@Model.SearchTerm" />
                            <button class="btn btn-outline-secondary" type="button" onclick="filterTable()"><i class="bi bi-search"></i></button>
                        </div>
                    </div>
                    <div class="col-md-2">
                        <select id="buildingFilter" class="form-select" onchange="filterTable()">
                            <option value="">كل المباني</option>
                            @foreach (var b in Model.Buildings)
                            {
                                <option value="@b.BuildingName">@b.BuildingName</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-2">
                        <select id="facultyFilter" class="form-select" onchange="filterTable()">
                            <option value="">كل الكليات</option>
                            @foreach (var f in Model.Faculties)
                            {
                                <option value="@f">@f</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-5 text-end">
                        <button type="button" class="btn btn-outline-success btn-sm" onclick="selectAll(true)">اختيار الكل</button>
                        <button type="button" class="btn btn-outline-danger btn-sm" onclick="selectAll(false)">إلغاء الكل</button>
                        <span class="text-muted small ms-2"><span id="selectedCount">0</span> طالب محدد</span>
                    </div>
                </div>

                @if (!Model.AllocatedStudents.Any())
                {
                    <div class="alert alert-info">لا يوجد طلاب مسكنين</div>
                }
                else
                {
                    <div class="table-responsive" style="max-height:500px;overflow-y:auto;">
                        <table class="table table-hover" id="studentsTable">
                            <thead>
                                <tr>
                                    <th style="width:50px">
                                        <input type="checkbox" id="selectAll" onchange="toggleSelectAll(this)" />
                                    </th>
                                    <th>الطالب</th>
                                    <th>الرقم القومي</th>
                                    <th>الكلية</th>
                                    <th>المدينة</th>
                                    <th>المبنى</th>
                                    <th>الغرفة</th>
                                    <th>السرير</th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (int i = 0; i < Model.AllocatedStudents.Count; i++)
                                {
                                    var s = Model.AllocatedStudents[i];
                                    <tr class="student-row">
                                        <td>
                                            <input type="checkbox" name="SelectedStudentIDs" value="@s.StudentID"
                                                   class="student-checkbox" onchange="updateSelectAll()" />
                                        </td>
                                        <td class="student-name">@s.StudentName</td>
                                        <td class="student-nationalid">@s.NationalID</td>
                                        <td class="student-faculty">@s.Faculty</td>
                                        <td>@s.CityName</td>
                                        <td class="student-building">@s.BuildingName</td>
                                        <td>@s.RoomNumber</td>
                                        <td>@s.BedNumber</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        function filterTable() {
            var search = document.getElementById('searchInput').value.toLowerCase();
            var building = document.getElementById('buildingFilter').value;
            var faculty = document.getElementById('facultyFilter').value;
            var rows = document.querySelectorAll('.student-row');

            rows.forEach(function (row) {
                var name = row.querySelector('.student-name')?.textContent?.toLowerCase() || '';
                var nationalId = row.querySelector('.student-nationalid')?.textContent?.toLowerCase() || '';
                var rowBuilding = row.querySelector('.student-building')?.textContent?.trim() || '';
                var rowFaculty = row.querySelector('.student-faculty')?.textContent?.trim() || '';

                var matchSearch = name.includes(search) || nationalId.includes(search);
                var matchBuilding = !building || rowBuilding === building;
                var matchFaculty = !faculty || rowFaculty === faculty;

                row.style.display = matchSearch && matchBuilding && matchFaculty ? '' : 'none';
            });

            updateSelectAll();
        }

        document.getElementById('searchInput')?.addEventListener('keyup', filterTable);

        function selectAll(select) {
            var checkboxes = document.querySelectorAll('.student-checkbox');
            checkboxes.forEach(function (cb) {
                var row = cb.closest('.student-row');
                if (row && row.style.display !== 'none') {
                    cb.checked = select;
                }
            });
            updateSelectAll();
        }

        function toggleSelectAll(source) {
            selectAll(source.checked);
        }

        function updateSelectAll() {
            var checkboxes = document.querySelectorAll('.student-checkbox:checked');
            var totalVisible = document.querySelectorAll('.student-row[style*="display: none"]');
            var allVisible = document.querySelectorAll('.student-row');
            var visibleCount = allVisible.length - totalVisible.length;
            var checkedCount = checkboxes.length;

            document.getElementById('selectedCount').textContent = checkedCount;

            var evacuateBtn = document.getElementById('evacuateBtn');
            var reason = document.getElementById('Reason');
            evacuateBtn.disabled = checkedCount === 0 || !reason.value.trim();

            var selectAllCb = document.getElementById('selectAll');
            var visibleCheckboxes = document.querySelectorAll('.student-row:not([style*="display: none"]) .student-checkbox');
            var checkedVisible = document.querySelectorAll('.student-row:not([style*="display: none"]) .student-checkbox:checked');
            selectAllCb.checked = visibleCheckboxes.length > 0 && checkedVisible.length === visibleCheckboxes.length;
        }

        document.getElementById('Reason')?.addEventListener('input', function () {
            var checkedCount = document.querySelectorAll('.student-checkbox:checked').length;
            document.getElementById('evacuateBtn').disabled = checkedCount === 0 || !this.value.trim();
        });

        // Recalculate on any checkbox change
        document.querySelectorAll('.student-checkbox').forEach(function (cb) {
            cb.addEventListener('change', updateSelectAll);
        });
    </script>
}
