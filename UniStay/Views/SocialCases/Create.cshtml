@model SocialCaseCreateVM
@{
    ViewData["Title"] = "إضافة حالة بحث اجتماعي";
}

<div class="container-fluid" dir="rtl">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="mb-0"><i class="bi bi-plus-circle"></i> إضافة حالة بحث اجتماعي</h4>
        <a asp-action="Index" class="btn btn-outline-dark btn-sm"><i class="bi bi-arrow-right"></i> عودة</a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <form method="post">
                @Html.AntiForgeryToken()

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">الطالب <span class="text-danger">*</span></label>

                        <input type="text" id="studentSearch" class="form-control" placeholder="ابحث بالاسم أو الرقم الجامعي أو الرقم القومي..." autocomplete="off" />
                        <div id="studentResults" class="list-group mt-1 position-absolute" style="max-height:220px;overflow-y:auto;display:none;z-index:999;width:calc(100% - 30px);"></div>

                        <input type="hidden" name="StudentID" id="StudentID" required />
                        <div id="selectedStudent" class="mt-2 p-2 bg-light rounded d-none">
                            <i class="bi bi-person-check text-success"></i>
                            <span id="selectedStudentName" class="fw-semibold"></span>
                            <small class="text-muted ms-2" id="selectedStudentCode"></small>
                            <button type="button" class="btn btn-sm btn-link text-danger p-0 ms-2" onclick="clearStudent()">✕</button>
                        </div>

                        @if (ViewBag.StudentId != null)
                        {
                            <small class="text-muted">سيتم ربط الحالة بالطالب المحدد</small>
                        }
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">نوع الحالة <span class="text-danger">*</span></label>
                        <input asp-for="CaseType" class="form-control" required />
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label">الوصف <span class="text-danger">*</span></label>
                    <textarea asp-for="Description" class="form-control" rows="4" required></textarea>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">الأولوية</label>
                        <select asp-for="Priority" class="form-select">
                            <option value="عاجلة">عاجلة</option>
                            <option value="عالية">عالية</option>
                            <option value="متوسطة" selected>متوسطة</option>
                            <option value="منخفضة">منخفضة</option>
                        </select>
                    </div>
                </div>

                <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> حفظ</button>
                <a asp-action="Index" class="btn btn-secondary">إلغاء</a>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let searchTimer = null;

        document.getElementById('studentSearch').addEventListener('input', function () {
            clearTimeout(searchTimer);
            const term = this.value.trim();
            if (term.length < 2) {
                document.getElementById('studentResults').style.display = 'none';
                return;
            }
            searchTimer = setTimeout(() => searchStudents(term), 300);
        });

        document.addEventListener('click', function (e) {
            if (!e.target.closest('#studentSearch') && !e.target.closest('#studentResults')) {
                document.getElementById('studentResults').style.display = 'none';
            }
        });

        async function searchStudents(term) {
            try {
                const res = await fetch(`/SocialCases/SearchStudents?term=${encodeURIComponent(term)}`);
                const data = await res.json();
                const box = document.getElementById('studentResults');

                if (!data.length) {
                    box.innerHTML = '<div class="list-group-item text-muted small">لا توجد نتائج</div>';
                    box.style.display = 'block';
                    return;
                }

                box.innerHTML = data.map(s => `
                    <button type="button" class="list-group-item list-group-item-action"
                            onclick="selectStudent(${s.id}, '${s.name}', '${s.code}')">
                        <span class="fw-semibold">${s.name}</span>
                        <small class="text-muted me-2">${s.code}</small>
                        ${s.nationalId ? `<small class="text-secondary">${s.nationalId}</small>` : ''}
                    </button>
                `).join('');
                box.style.display = 'block';
            } catch {
                console.error('خطأ في البحث');
            }
        }

        function selectStudent(id, name, code) {
            document.getElementById('StudentID').value = id;
            document.getElementById('studentSearch').value = name;
            document.getElementById('selectedStudentName').textContent = name;
            document.getElementById('selectedStudentCode').textContent = code;
            document.getElementById('selectedStudent').classList.remove('d-none');
            document.getElementById('studentResults').style.display = 'none';
        }

        function clearStudent() {
            document.getElementById('StudentID').value = '';
            document.getElementById('studentSearch').value = '';
            document.getElementById('selectedStudent').classList.add('d-none');
        }

        // لو في studentId محدد مسبقاً
        @if (ViewBag.StudentId != null)
        {
                <text>
                fetch(`/SocialCases/SearchStudents?term=@ViewBag.StudentId`)
                    .then(r => r.json())
                    .then(data => { if(data.length) selectStudent(data[0].id, data[0].name, data[0].code); });
                </text>
        }
    </script>
}
