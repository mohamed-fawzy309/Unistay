@model List<UniStay.Models.CoordinationResult>
@{ ViewData["Title"] = "نتائج التنسيق"; }

<div class="card shadow-sm border-0">
    <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
        <h5 class="mb-0"><i class="bi bi-trophy"></i> نتائج التنسيق</h5>
        <div>
            <span class="me-3">المقبول: <strong>@ViewBag.TotalAccepted</strong></span>
            <span>قائمة الانتظار: <strong>@ViewBag.TotalWaitlist</strong></span>
        </div>
    </div>
    <div class="card-body">
        <div class="mb-3">
            <form method="get" class="row g-2">
                <div class="col-md-3">
                    <select name="cityId" class="form-select" onchange="this.form.submit()">
                        <option value="">كل المدن</option>
                        @foreach (var c in ViewBag.Cities as List<UniStay.Models.DormitoryCity> ?? new())
                        {
                            <option value="@c.ID" selected="@(Context.Request.Query["cityId"].ToString() == c.ID.ToString())">@c.Name</option>
                        }
                    </select>
                </div>
                <div class="col-md-9">
                    <a asp-action="ExportResultsExcel" asp-route-cityId="@Context.Request.Query["cityId"]" class="btn btn-success me-1"><i class="bi bi-file-earmark-excel"></i> Excel</a>
                    <a asp-action="ExportResultsPdf" asp-route-cityId="@Context.Request.Query["cityId"]" class="btn btn-danger"><i class="bi bi-file-earmark-pdf"></i> PDF</a>
                </div>
            </form>
        </div>

        <div class="table-responsive">
            <table class="table table-hover table-bordered align-middle">
                <thead class="table-dark">
                    <tr><th>الترتيب</th><th>الاسم</th><th>الرقم القومي</th><th>الكلية</th><th>المدينة</th><th>مسافة</th><th>درجات</th><th>مكافأة</th><th>المجموع</th><th>الحالة</th></tr>
                </thead>
                <tbody>
                    @if (!Model.Any()) { <tr><td colspan="10" class="text-center text-muted py-4">لا توجد نتائج</td></tr> }
                    @foreach (var r in Model)
                    {
                        <tr>
                            <td>@r.Rank</td>
                            <td class="fw-bold">@r.Student?.FullName</td>
                            <td>@r.Student?.NationalID</td>
                            <td>@r.Student?.Faculty</td>
                            <td>@r.DormitoryCity?.Name</td>
                            <td>@r.DistanceScore</td>
                            <td>@r.GradeScore</td>
                            <td>@r.SpecialBonus</td>
                            <td><strong>@r.TotalScore</strong></td>
                            <td><span class="badge @(r.Status == "Accepted" ? "bg-success" : r.Status == "Rejected" ? "bg-danger" : "bg-warning text-dark")">@r.Status</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
