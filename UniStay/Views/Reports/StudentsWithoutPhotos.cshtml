@model UniStay.ViewModels.Reports.StudentsWithoutPhotosViewModel
@{
    ViewData["Title"] = "الطلاب بدون صور";
    var maleCount = Model.Students.Count(s => s.Gender == "Male");
    var femaleCount = Model.Students.Count(s => s.Gender == "Female");
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="page-title">الطلاب بدون صور</h2>
    <div class="btn-group">
        <a asp-action="StudentsWithoutPhotosExportExcel" asp-route-cityId="@Model.Filter.CityID" asp-route-gender="@Model.Filter.Gender" asp-route-faculty="@Model.Filter.Faculty" class="btn btn-success"><i class="bi bi-file-earmark-excel"></i> Excel</a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">@TempData["Success"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">@TempData["Error"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
}

<div class="row g-3 mb-4">
    <div class="col-md-6">
        <div class="stat-card bg-white">
            <div class="d-flex align-items-center gap-3">
                <div class="icon bg-primary bg-opacity-10 text-primary"><i class="bi bi-person-x"></i></div>
                <div>
                    <div class="value">@Model.TotalCount</div>
                    <div class="label">إجمالي الطلاب بدون صور</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="stat-card bg-white">
            <div class="d-flex align-items-center gap-3">
                <div class="icon bg-info bg-opacity-10 text-info"><i class="bi bi-people"></i></div>
                <div>
                    <div class="value">@maleCount ذكر / @femaleCount أنثى</div>
                    <div class="label">عدد الذكور / الإناث</div>
                </div>
            </div>
        </div>
    </div>
</div>

<form method="get" class="filter-bar row g-2 mb-3">
    <div class="col-md-3">
        <label class="form-label small">المدينة</label>
        <select name="cityId" class="form-select" onchange="this.form.submit()">
            <option value="">الكل</option>
            @foreach (var c in Model.Cities)
            {
                <option value="@c.ID" selected="@(Model.Filter.CityID == c.ID)">@c.Name</option>
            }
        </select>
    </div>
    <div class="col-md-2">
        <label class="form-label small">النوع</label>
        <select name="gender" class="form-select" onchange="this.form.submit()">
            <option value="">الكل</option>
            <option value="Male" selected="@(Model.Filter.Gender == "Male")">ذكر</option>
            <option value="Female" selected="@(Model.Filter.Gender == "Female")">أنثى</option>
        </select>
    </div>
    <div class="col-md-3">
        <label class="form-label small">الكلية</label>
        <input type="text" name="faculty" class="form-control" placeholder="اسم الكلية..." value="@Model.Filter.Faculty">
    </div>
    <div class="col-md-2">
        <label class="form-label small">بحث</label>
        <input type="text" name="search" class="form-control" placeholder="اسم الطالب..." value="@Model.Filter.Search">
    </div>
    <div class="col-md-2 d-flex align-items-end">
        <a asp-action="StudentsWithoutPhotos" class="btn btn-secondary w-100">إعادة تعيين</a>
    </div>
</form>

<div class="table-responsive bg-white rounded shadow-sm animate-fade-in">
    <table class="table table-hover mb-0">
        <thead class="table-dark">
            <tr>
                <th>الاسم</th>
                <th>الرقم القومي</th>
                <th>كود الطالب</th>
                <th>النوع</th>
                <th>الكلية</th>
                <th>الهاتف</th>
                <th>المركز</th>
                <th>المدينة</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var s in Model.Students)
            {
                <tr>
                    <td class="fw-semibold">@s.FullName</td>
                    <td>@s.NationalID</td>
                    <td>@(s.StudentCode ?? "—")</td>
                    <td>@(s.Gender == "Male" ? "ذكر" : "أنثى")</td>
                    <td>@(s.Faculty ?? "—")</td>
                    <td>@(s.Phone ?? "—")</td>
                    <td>@(s.Markaz ?? "—")</td>
                    <td>@(s.City ?? "—")</td>
                </tr>
            }
            @if (!Model.Students.Any())
            {
                <tr><td colspan="8" class="text-center text-muted py-4">لا توجد بيانات</td></tr>
            }
        </tbody>
    </table>
</div>

@if (Model.TotalPages > 1)
{
    <nav class="mt-3">
        <ul class="pagination pagination-modern justify-content-center">
            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(i == Model.Page ? "active" : "")">
                    <a class="page-link" asp-action="StudentsWithoutPhotos" asp-route-page="@i" asp-route-cityId="@Model.Filter.CityID" asp-route-gender="@Model.Filter.Gender" asp-route-faculty="@Model.Filter.Faculty" asp-route-search="@Model.Filter.Search">@i</a>
                </li>
            }
        </ul>
    </nav>
}
