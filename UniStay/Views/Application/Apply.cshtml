    <script>
        // ── Flatpickr date picker
        flatpickr("#birthDate", {
            locale: "ar", dateFormat: "Y-m-d", maxDate: "today",
            onChange: function(sel, str) { calculateAge(str); }
        });

        function calculateAge(birthDateStr) {
            if (!birthDateStr) { document.getElementById('calculatedAge').value = '--'; return; }
            const b = new Date(birthDateStr);
            const t = new Date();
            let age = t.getFullYear() - b.getFullYear();
            const m = t.getMonth() - b.getMonth();
            if (m < 0 || (m === 0 && t.getDate() < b.getDate())) age--;
            document.getElementById('calculatedAge').value = age + ' سنة';
        }

        // ── Faculties
        const faculties = [
            { name: "الهندسة", hint: "شهادة الثانوية العامة شعبة علمي رياضة" },
            { name: "الطب", hint: "شهادة الثانوية العامة شعبة علمي علوم" },
            { name: "طب الأسنان", hint: "شهادة الثانوية العامة شعبة علمي علوم" },
