@model UniStay.Models.DormitoryCity
@{
    ViewData["Title"] = "تفاصيل المدينة - " + Model.Name;
}

<h2 class="mb-4">@Model.Name</h2>

<div class="row mb-4">
    <div class="col-md-3">
        <div class="card shadow-sm text-center p-3">
            <h3 class="text-primary">@ViewBag.TotalBuildings</h3>
            <p class="mb-0 text-muted">مبنى</p>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card shadow-sm text-center p-3">
            <h3 class="text-info">@ViewBag.TotalRooms</h3>
            <p class="mb-0 text-muted">غرفة</p>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card shadow-sm text-center p-3">
            <h3 class="text-success">@ViewBag.TotalBeds</h3>
            <p class="mb-0 text-muted">سرير</p>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card shadow-sm text-center p-3">
            <h3 class="text-warning">@(Convert.ToInt32(ViewBag.TotalBeds) - Convert.ToInt32(ViewBag.OccupiedBeds))</h3>
            <p class="mb-0 text-muted">سرير متاح</p>
        </div>
    </div>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-header bg-primary text-white">
        <h5 class="mb-0">بيانات المدينة</h5>
    </div>
    <div class="card-body">
        <div class="row">
            <div class="col-md-4 mb-2"><strong>النوع:</strong> @Model.CityType</div>
            <div class="col-md-4 mb-2"><strong>الموقع:</strong> @Model.Location</div>
            <div class="col-md-4 mb-2"><strong>الجامعة:</strong> @Model.University?.Name</div>
            <div class="col-md-4 mb-2"><strong>الحالة:</strong> @(Model.IsActive ? "نشط" : "غير نشط")</div>
        </div>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-header bg-success text-white">
        <h5 class="mb-0">المباني</h5>
    </div>
    <div class="card-body">
        @if (Model.CityBuildings.Any())
        {
            <div class="row">
                @foreach (var building in Model.CityBuildings)
                {
                    <div class="col-md-4 mb-3">
                        <div class="card h-100">
                            <div class="card-body">
                                <h6 class="card-title">@building.BuildingName</h6>
                                <p class="small mb-1"><strong>النوع:</strong> @building.BuildingType</p>
                                <p class="small mb-1"><strong>الأدوار:</strong> @building.FloorCount</p>
                                <p class="small mb-1"><strong>الغرف:</strong> @building.CityRooms.Count</p>
                                <p class="small mb-0"><strong>الأسرة:</strong> @building.CityRooms.Sum(r => r.BedsCount)</p>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <p class="text-muted">لا توجد مباني</p>
        }
    </div>
</div>

<div class="mt-3">
    <a asp-action="Cities" class="btn btn-secondary">رجوع</a>
</div>
