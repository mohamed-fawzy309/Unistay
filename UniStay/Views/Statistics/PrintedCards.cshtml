@model PrintedCardsStatisticsViewModel
@{ ViewData["Title"] = "إحصائية البطاقات المطبوعة"; }

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-credit-card"></i> إحصائية البطاقات المطبوعة</h2>
        <div>
            <a asp-action="ExportCardsExcel" asp-route-fromDate="@Model.FilterFromDate" asp-route-toDate="@Model.FilterToDate" class="btn btn-success btn-sm"><i class="bi bi-file-earmark-excel"></i> Excel</a>
            <a asp-action="ExportCardsPdf" asp-route-fromDate="@Model.FilterFromDate" asp-route-toDate="@Model.FilterToDate" class="btn btn-danger btn-sm"><i class="bi bi-file-earmark-pdf"></i> PDF</a>
        </div>
    </div>

    <form method="get" class="row g-2 mb-4">
        <div class="col-md-3"><input type="date" name="fromDate" class="form-control form-control-sm" value="@Model.FilterFromDate?.ToString("yyyy-MM-dd")" /></div>
        <div class="col-md-3"><input type="date" name="toDate" class="form-control form-control-sm" value="@Model.FilterToDate?.ToString("yyyy-MM-dd")" /></div>
        <div class="col-md-2"><button type="submit" class="btn btn-primary btn-sm w-100"><i class="bi bi-funnel"></i> تصفية</button></div>
    </form>

    <div class="row mb-4">
        <div class="col-md-3 mb-2"><div class="card border-primary shadow-sm"><div class="card-body text-center"><h6 class="text-muted">الإجمالي</h6><h3 class="text-primary mb-0">@Model.Total.ToString("N0")</h3></div></div></div>
        <div class="col-md-3 mb-2"><div class="card border-success shadow-sm"><div class="card-body text-center"><h6 class="text-muted">مطبوعة</h6><h3 class="text-success mb-0">@Model.Printed.ToString("N0")</h3></div></div></div>
        <div class="col-md-3 mb-2"><div class="card border-warning shadow-sm"><div class="card-body text-center"><h6 class="text-muted">معلقة</h6><h3 class="text-warning mb-0">@Model.Pending.ToString("N0")</h3></div></div></div>
        <div class="col-md-3 mb-2"><div class="card border-danger shadow-sm"><div class="card-body text-center"><h6 class="text-muted">فاشلة</h6><h3 class="text-danger mb-0">@Model.Failed.ToString("N0")</h3></div></div></div>
    </div>

    <div class="row">
        <div class="col-md-6 mb-4">
            <div class="card shadow-sm"><div class="card-header bg-light"><h6 class="mb-0">الطباعة اليومية (آخر 7 أيام)</h6></div><div class="card-body"><canvas id="chartDaily" height="220"></canvas></div></div>
        </div>
        <div class="col-md-6 mb-4">
            <div class="card shadow-sm"><div class="card-header bg-light"><h6 class="mb-0">الطباعة الشهرية</h6></div><div class="card-body"><canvas id="chartMonthly" height="220"></canvas></div></div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        new Chart(document.getElementById('chartDaily'), {
            type: 'line', data: {
                labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DailyPrinting.Select(x => x.Label))),
                datasets: [{ data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DailyPrinting.Select(x => x.Value))), borderColor: '#0d6efd', fill: true }]
            }, options: { responsive: true, plugins: { legend: { display: false } } }
        });
        new Chart(document.getElementById('chartMonthly'), {
            type: 'bar', data: {
                labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlyPrinting.Select(x => x.Label))),
                datasets: [{ data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlyPrinting.Select(x => x.Value))), backgroundColor: '#198754' }]
            }, options: { responsive: true, plugins: { legend: { display: false } } }
        });
    </script>
}
