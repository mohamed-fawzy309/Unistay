@model UniStay.ViewModels.Permissions.DataScopeIndexViewModel
@{
    ViewData["Title"] = "نطاقات البيانات";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

@section Scripts {
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script>
$(function(){

    // إظهار/إخفاء حقل القيمة حسب نوع النطاق
    $('#ScopeType').on('change', function(){
        const val = $(this).val();
        $('#cityGroup').addClass('d-none');
        $('#buildingGroup').addClass('d-none');
        $('#facultyGroup').addClass('d-none');
        $('#scopeValueHidden').val('');

        if(val === 'DormitoryCity') $('#cityGroup').removeClass('d-none');
        else if(val === 'Building')  $('#buildingGroup').removeClass('d-none');
        else if(val === 'Faculty')   $('#facultyGroup').removeClass('d-none');
    });

    // إزالة نطاق — AJAX
    $(document).on('click', '.btn-remove-scope', function(){
        if(!confirm('إزالة هذا النطاق؟')) return;
        const dsid = $(this).data('id');
        $.post('/Permissions/RemoveDataScope', {
            dataScopeId: dsid,
            userId: @Model.UserID,
            __RequestVerificationToken: $('[name=__RequestVerificationToken]').val()
        }).done(r => {
            if(r.success) location.reload();
            else toast(r.message, 'danger');
        });
    });

    function toast(msg, type='success'){
        const t=$(`<div class="toast align-items-center text-bg-${type} border-0 position-fixed bottom-0 end-0 m-3 show" style="z-index:9999">
            <div class="d-flex"><div class="toast-body">${msg}</div>
            <button class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button></div></div>`);
        $('body').append(t); setTimeout(()=>t.remove(), 3500);
    }
});
</script>
}

@Html.AntiForgeryToken()

<div class="container-fluid py-3">

    @* Header *@
    <div class="d-flex align-items-center gap-3 mb-4">
        <a asp-action="Users" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-right"></i> رجوع
        </a>
        <div>
            <h5 class="mb-0 fw-bold"><i class="bi bi-funnel me-2 text-info"></i>نطاقات البيانات</h5>
            <small class="text-muted">@Model.UserName — تحديد نطاق البيانات المسموح بالوصول إليها</small>
        </div>
    </div>

    @if (TempData["Success"] != null)
    { <div class="alert alert-success alert-dismissible fade show"><i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]<button class="btn-close" data-bs-dismiss="alert"></button></div> }
    @if (TempData["Error"] != null)
    { <div class="alert alert-danger alert-dismissible fade show"><i class="bi bi-exclamation-circle-fill me-2"></i>@TempData["Error"]<button class="btn-close" data-bs-dismiss="alert"></button></div> }

    <div class="row g-4">

        @* ══ النطاقات الحالية ══ *@
        <div class="col-lg-8">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-info text-white">
                    <i class="bi bi-shield-shaded me-2"></i>النطاقات المعيَّنة حالياً
                </div>
                <div class="card-body p-0">
                    @if (!Model.CurrentScopes.Any())
                    {
                        <div class="p-5 text-center text-muted">
                            <i class="bi bi-funnel fs-1 opacity-25"></i>
                            <p class="mt-2">لم يتم تعيين أي نطاق بعد</p>
                        </div>
                    }
                    else
                    {
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>نوع النطاق</th>
                                    <th>القيمة</th>
                                    <th class="text-center" style="width:80px">إزالة</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var scope in Model.CurrentScopes)
                                {
                                    <tr>
                                        <td>
                                            <span class="badge bg-info text-white">@scope.ScopeTypeDisplay</span>
                                        </td>
                                        <td>
                                            @if (!string.IsNullOrEmpty(scope.ScopeValue))
                                            { <code class="text-secondary">@scope.ScopeValueDisplay</code> }
                                            else
                                            { <span class="text-muted small">—</span> }
                                        </td>
                                        <td class="text-center">
                                            <button class="btn btn-sm btn-outline-danger btn-remove-scope"
                                                    data-id="@scope.DataScopeID" title="إزالة">
                                                <i class="bi bi-x-lg"></i>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>
            </div>
        </div>

        @* ══ إضافة نطاق جديد ══ *@
        <div class="col-lg-4">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-secondary text-white">
                    <i class="bi bi-plus-circle me-2"></i>إضافة نطاق جديد
                </div>
                <div class="card-body">
                    <form asp-action="DataScopes" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="UserID" value="@Model.UserID" />
                        <input type="hidden" name="ScopeValue" id="scopeValueHidden" />

                        <div class="mb-3">
                            <label class="form-label fw-semibold">نوع النطاق <span class="text-danger">*</span></label>
                            <select name="ScopeType" id="ScopeType" class="form-select" required>
                                <option value="">اختر نوعاً...</option>
                                @foreach (var st in UniStay.ViewModels.Permissions.AddDataScopeViewModel.ScopeTypes)
                                {
                                    <option value="@st.Value">@st.Text</option>
                                }
                            </select>
                        </div>

                        @* مدينة *@
                        <div class="mb-3 d-none" id="cityGroup">
                            <label class="form-label fw-semibold">المدينة</label>
                            <select class="form-select" id="citySelect"
                                    onchange="document.getElementById('scopeValueHidden').value=this.value">
                                <option value="">اختر مدينة...</option>
                                @foreach (var c in Model.AvailableCities)
                                {
                                    <option value="@c.Value">@c.Text</option>
                                }
                            </select>
                        </div>

                        @* مبنى *@
                        <div class="mb-3 d-none" id="buildingGroup">
                            <label class="form-label fw-semibold">المبنى</label>
                            <select class="form-select" id="buildingSelect"
                                    onchange="document.getElementById('scopeValueHidden').value=this.value">
                                <option value="">اختر مبنى...</option>
                                @foreach (var b in Model.AvailableBuildings)
                                {
                                    <option value="@b.Value">@b.Text</option>
                                }
                            </select>
                        </div>

                        @* كلية *@
                        <div class="mb-3 d-none" id="facultyGroup">
                            <label class="form-label fw-semibold">الكلية</label>
                            <input type="text" class="form-control" placeholder="اسم الكلية"
                                   onchange="document.getElementById('scopeValueHidden').value=this.value"
                                   oninput="document.getElementById('scopeValueHidden').value=this.value" />
                        </div>

                        <button type="submit" class="btn btn-secondary w-100">
                            <i class="bi bi-plus-lg me-1"></i>إضافة النطاق
                        </button>
                    </form>
                </div>
            </div>
        </div>

    </div>
</div>
