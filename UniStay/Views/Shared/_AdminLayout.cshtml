    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const currentPath = window.location.pathname.toLowerCase().replace(/\/+$/, '');

            // Highlight active nav link and expand parent collapse
            let activeFound = false;
            document.querySelectorAll('.sidebar .nav-link').forEach(link => {
                let href = link.getAttribute('href');
                if (!href || href === '#') return;
                href = href.toLowerCase().replace(/\/+$/, '');
                // Match exact path or controller path (without action)
                if (currentPath === href || currentPath.startsWith(href + '/')) {
                    if (href !== '/') {  // skip home
                        link.classList.add('active');
                        activeFound = true;
                        const collapse = link.closest('.collapse');
                        if (collapse) {
                            collapse.classList.add('show');
                            const trigger = document.querySelector(`[data-bs-target="#${collapse.id}"]`);
                            if (trigger) trigger.setAttribute('aria-expanded', 'true');
                        }
                    }
                }
            });

            // Remove dashboard active if another link is active
            if (activeFound) {
                document.querySelector('.sidebar a[asp-controller="Admin"][asp-action="Index"]')?.classList.remove('active');
            }

            // Sync collapse icons on toggle + set initial icon state
            document.querySelectorAll('[data-bs-toggle="collapse"]').forEach(toggle => {
                const icon = toggle.querySelector('.collapse-icon');
                if (icon) {
                    const targetId = toggle.getAttribute('data-bs-target');
                    if (targetId) {
                        const target = document.querySelector(targetId);
                        if (target && target.classList.contains('show')) {
                            icon.style.transform = 'rotate(-90deg)';
                        }
                    }
                }
                toggle.addEventListener('click', function () {
                    const icon = this.querySelector('.collapse-icon');
                    if (icon) {
                        const target = document.querySelector(this.getAttribute('data-bs-target'));
                        if (target) {
                            setTimeout(() => {
                                icon.style.transform = target.classList.contains('show') ? 'rotate(-90deg)' : '';
                            }, 100);
                        }
                    }
                });
            });

            // Fix dropdown clipping inside table-responsive (all pages)
            document.querySelectorAll('.table-responsive .dropdown-toggle[data-bs-toggle="dropdown"]').forEach(function(btn) {
                btn.addEventListener('show.bs.dropdown', function () {
                    var wrapper = this.closest('.table-responsive');
                    if (wrapper) wrapper.style.overflow = 'visible';
                });
                btn.addEventListener('hidden.bs.dropdown', function () {
                    var wrapper = this.closest('.table-responsive');
                    if (wrapper) wrapper.style.overflow = '';
                });
            });

            // Toast auto-dismiss
            var toasts = document.querySelectorAll('.toast');
            toasts.forEach(function (t) {
                var bsToast = new bootstrap.Toast(t, { delay: 5000 });
                bsToast.show();
            });
        });
    </script>

