@model StudentStatusVM
@{
    ViewData["Title"] = "بيان حالة الطالب";
}

<div class="container-fluid" dir="rtl">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="mb-0"><i class="bi bi-card-list"></i> بيان حالة الطالب</h4>
        <div>
            <a asp-action="Print" asp-route-id="@Model.StudentId" class="btn btn-secondary btn-sm" target="_blank"><i class="bi bi-printer"></i> طباعة</a>
            <a asp-action="Details" asp-route-id="@Model.StudentId" class="btn btn-outline-info btn-sm"><i class="bi bi-person-vcard"></i> بيانات أساسية</a>
            <a asp-action="Index" class="btn btn-outline-dark btn-sm"><i class="bi bi-arrow-right"></i> عودة</a>
        </div>
    </div>

    <div class="row mb-3">
        <div class="col">
            <div class="card shadow-sm bg-light">
                <div class="card-body py-2">
                    <strong>الطالب:</strong> @Model.StudentName |
                    <strong>الرقم الجامعي:</strong> @Model.StudentCode |
                    <strong>الحالة:</strong>
                    <span class="badge @(Model.IsActive ? "bg-success" : "bg-secondary")">
                        @(Model.IsActive ? "نشط" : "غير نشط")
                    </span>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3">
        <div class="col-md-3">
            <div class="card shadow-sm border-primary">
                <div class="card-body text-center">
                    <h5 class="text-primary mb-0">@Model.TotalAllocations</h5>
                    <small class="text-muted">إجمالي السكن</small>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm border-success">
                <div class="card-body text-center">
                    <h5 class="text-success mb-0">@Model.TotalPaid.ToString("N2")</h5>
                    <small class="text-muted">إجمالي المدفوعات</small>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm border-danger">
                <div class="card-body text-center">
                    <h5 class="text-danger mb-0">@Model.TotalViolations</h5>
                    <small class="text-muted">المخالفات</small>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm border-warning">
                <div class="card-body text-center">
                    <h5 class="text-warning mb-0">@Model.TotalAbsences</h5>
                    <small class="text-muted">الغياب</small>
                </div>
            </div>
        </div>
    </div>

    <ul class="nav nav-tabs mt-4" id="statusTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="alloc-tab" data-bs-toggle="tab" data-bs-target="#alloc" type="button" role="tab">السكن</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="pay-tab" data-bs-toggle="tab" data-bs-target="#pay" type="button" role="tab">المدفوعات (@Model.TotalPayments)</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="viol-tab" data-bs-toggle="tab" data-bs-target="#viol" type="button" role="tab">المخالفات (@Model.TotalViolations)</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="abs-tab" data-bs-toggle="tab" data-bs-target="#abs" type="button" role="tab">الغياب (@Model.TotalAbsences)</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="meal-tab" data-bs-toggle="tab" data-bs-target="#meal" type="button" role="tab">الوجبات (@Model.TotalMeals)</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="doc-tab" data-bs-toggle="tab" data-bs-target="#doc" type="button" role="tab">المستندات (@Model.TotalDocuments)</button>
        </li>
    </ul>

    <div class="tab-content mt-2" id="statusTabsContent">
        <div class="tab-pane fade show active" id="alloc" role="tabpanel">
            <div class="card shadow-sm">
                <div class="card-body p-0">
                    <table class="table table-sm mb-0">
                        <thead>
                            <tr><th>المبنى</th><th>الغرفة</th><th>السرير</th><th>الحالة</th><th>السنة</th><th>من</th><th>إلى</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var a in Model.Allocations)
                            {
                                <tr>
                                    <td>@a.BuildingName</td><td>@a.RoomNumber</td><td>@a.BedNumber</td>
                                    <td><span class="badge @(a.Status == "Active" ? "bg-success" : "bg-secondary")">@a.Status</span></td>
                                    <td>@a.AcademicYear</td><td>@a.StartDate?.ToString("yyyy/MM/dd")</td><td>@a.EndDate?.ToString("yyyy/MM/dd")</td>
                                </tr>
                            }
                            @if (!Model.Allocations.Any()) { <tr><td colspan="7" class="text-center text-muted">لا توجد سجلات</td></tr> }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="tab-pane fade" id="pay" role="tabpanel">
            <div class="card shadow-sm">
                <div class="card-body p-0">
                    <table class="table table-sm mb-0">
                        <thead>
                            <tr><th>المبلغ</th><th>المدفوع</th><th>الحالة</th><th>التاريخ</th><th>النوع</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var p in Model.Payments)
                            {
                                <tr>
                                    <td>@p.Amount.ToString("N2")</td>
                                    <td>@p.PaidAmount.ToString("N2")</td>
                                    <td><span class="badge @(p.Status == "Completed" ? "bg-success" : "bg-warning")">@p.Status</span></td>
                                    <td>@p.PaymentDate?.ToString("yyyy/MM/dd")</td><td>@p.PaymentType</td>
                                </tr>
                            }
                            @if (!Model.Payments.Any()) { <tr><td colspan="5" class="text-center text-muted">لا توجد سجلات</td></tr> }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="tab-pane fade" id="viol" role="tabpanel">
            <div class="card shadow-sm">
                <div class="card-body p-0">
                    <table class="table table-sm mb-0">
                        <thead>
                            <tr><th>النوع</th><th>الوصف</th><th>التاريخ</th><th>الدرجة</th><th>الحالة</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var v in Model.Violations)
                            {
                                <tr>
                                    <td>@v.ViolationType</td><td>@v.Description</td>
                                    <td>@v.ViolationDate?.ToString("yyyy/MM/dd")</td>
                                    <td>@v.Severity</td>
                                    <td>@v.Status</td>
                                </tr>
                            }
                            @if (!Model.Violations.Any()) { <tr><td colspan="5" class="text-center text-muted">لا توجد سجلات</td></tr> }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="tab-pane fade" id="abs" role="tabpanel">
            <div class="card shadow-sm">
                <div class="card-body p-0">
                    <table class="table table-sm mb-0">
                        <thead>
                            <tr><th>من</th><th>إلى</th><th>النوع</th><th>السبب</th><th>الحالة</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var a in Model.Absences)
                            {
                                <tr>
                                    <td>@a.AbsenceDate.ToString("yyyy/MM/dd")</td>
                                    <td>@a.ToDate?.ToString("yyyy/MM/dd")</td>
                                    <td>@a.AbsenceType</td>
                                    <td>@a.Reason</td>
                                    <td>@a.Status</td>
                                </tr>
                            }
                            @if (!Model.Absences.Any()) { <tr><td colspan="5" class="text-center text-muted">لا توجد سجلات</td></tr> }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="tab-pane fade" id="meal" role="tabpanel">
            <div class="card shadow-sm">
                <div class="card-body p-0">
                    <table class="table table-sm mb-0">
                        <thead>
                            <tr><th>النوع</th><th>التاريخ</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var m in Model.Meals)
                            {
                                <tr>
                                    <td>@m.MealType</td><td>@m.MealDate.ToString("yyyy/MM/dd")</td>
                                </tr>
                            }
                            @if (!Model.Meals.Any()) { <tr><td colspan="2" class="text-center text-muted">لا توجد سجلات</td></tr> }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="tab-pane fade" id="doc" role="tabpanel">
            <div class="card shadow-sm">
                <div class="card-body p-0">
                    <table class="table table-sm mb-0">
                        <thead>
                            <tr><th>النوع</th><th>تاريخ الرفع</th><th>موثق</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var d in Model.Documents)
                            {
                                <tr>
                                    <td>@d.DocumentType</td>
                                    <td>@d.UploadDate?.ToString("yyyy/MM/dd")</td>
                                    <td><span class="badge @(d.IsVerified ? "bg-success" : "bg-warning")">@(d.IsVerified ? "نعم" : "لا")</span></td>
                                </tr>
                            }
                            @if (!Model.Documents.Any()) { <tr><td colspan="3" class="text-center text-muted">لا توجد سجلات</td></tr> }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
