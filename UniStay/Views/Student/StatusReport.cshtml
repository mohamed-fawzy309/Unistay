@model UniStay.Models.Student
@{
    ViewData["Title"] = "بيان الحالة";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="mb-0" style="font-weight:800">
        <i class="bi bi-file-earmark-text me-2" style="color:var(--success)"></i> بيان الحالة
    </h4>
</div>

@if (Model == null)
{
    <div class="alert-site alert-warning">
        <i class="bi bi-exclamation-triangle me-2"></i> لم يتم العثور على بيانات الطالب.
    </div>
    return;
}

@* Student Data *@
<div class="card-site mb-4">
    <div class="card-site-header">
        <i class="bi bi-person" style="color:var(--success)"></i>
        البيانات الشخصية
    </div>
    <div class="card-site-body">
        <div class="row g-3">
            <div class="col-md-4">
                <small style="color:var(--muted);font-size:.78rem">الاسم الكامل</small>
                <div style="font-weight:700;font-size:.95rem">@Model.FullName</div>
            </div>
            <div class="col-md-4">
                <small style="color:var(--muted);font-size:.78rem">الرقم القومي</small>
                <div style="font-weight:700;font-size:.95rem;direction:ltr;text-align:right">@Model.NationalID</div>
            </div>
            <div class="col-md-4">
                <small style="color:var(--muted);font-size:.78rem">الجنس</small>
                <div style="font-weight:700;font-size:.95rem">@(Model.Gender == "Male" ? "ذكر" : "أنثى")</div>
            </div>
            <div class="col-md-4">
                <small style="color:var(--muted);font-size:.78rem">الكلية</small>
                <div style="font-weight:700;font-size:.95rem">@Model.Faculty</div>
            </div>
            <div class="col-md-4">
                <small style="color:var(--muted);font-size:.78rem">السنة الدراسية</small>
                <div style="font-weight:700;font-size:.95rem">@Model.AcademicYear</div>
            </div>
            <div class="col-md-4">
                <small style="color:var(--muted);font-size:.78rem">رقم الهاتف</small>
                <div style="font-weight:700;font-size:.95rem">@Model.Phone</div>
            </div>
            <div class="col-md-6">
                <small style="color:var(--muted);font-size:.78rem">البريد الإلكتروني</small>
                <div style="font-weight:700;font-size:.95rem">@Model.Email</div>
            </div>
            <div class="col-md-6">
                <small style="color:var(--muted);font-size:.78rem">العنوان</small>
                <div style="font-weight:700;font-size:.95rem">@Model.Governorate - @(Model.Markaz ?? "") - @Model.City - @Model.Address</div>
            </div>
        </div>
    </div>
</div>

@* Guardian Data *@
@if (Model.Guardians != null && Model.Guardians.Any())
{
    <div class="card-site mb-4">
        <div class="card-site-header">
            <i class="bi bi-people" style="color:var(--red)"></i>
            بيانات ولي الأمر
        </div>
        <div class="card-site-body">
            @foreach (var g in Model.Guardians)
            {
                <div class="row g-2 mb-3 pb-3" style="border-bottom:1px solid var(--border)">
                    <div class="col-md-3">
                        <small style="color:var(--muted);font-size:.78rem">النوع</small>
                        <div style="font-weight:700;font-size:.9rem">@(g.GuardianType == "Father" ? "الأب" : "ولي الأمر")</div>
                    </div>
                    <div class="col-md-4">
                        <small style="color:var(--muted);font-size:.78rem">الاسم</small>
                        <div style="font-weight:700;font-size:.9rem">@g.FullName</div>
                    </div>
                    <div class="col-md-3">
                        <small style="color:var(--muted);font-size:.78rem">الوظيفة</small>
                        <div style="font-weight:700;font-size:.9rem">@(g.Job ?? "—")</div>
                    </div>
                    <div class="col-md-2">
                        <small style="color:var(--muted);font-size:.78rem">متوفى؟</small>
                        <div style="font-weight:700;font-size:.9rem">@(g.IsDeceased == true ? "نعم" : "لا")</div>
                    </div>
                </div>
            }
        </div>
    </div>
}

@* Allocation Data *@
<div class="card-site mb-4">
    <div class="card-site-header">
        <i class="bi bi-house" style="color:var(--red)"></i>
        بيانات التسكين
    </div>
    <div class="card-site-body">
        @if (ViewBag.Allocation == null)
        {
            <div class="alert-site alert-info mb-0">
                <i class="bi bi-info-circle me-2"></i> لم يتم تسكينك بعد. انتظر الإخطار من إدارة المدينة الجامعية.
            </div>
        }
        else
        {
            var alloc = ViewBag.Allocation as UniStay.Models.Allocation;
            <div class="row g-3">
                <div class="col-md-4">
                    <small style="color:var(--muted);font-size:.78rem">المدينة الجامعية</small>
                    <div style="font-weight:700;font-size:.95rem">@alloc?.CityRoom?.CityBuilding?.DormitoryCity?.Name</div>
                </div>
                <div class="col-md-4">
                    <small style="color:var(--muted);font-size:.78rem">المبنى</small>
                    <div style="font-weight:700;font-size:.95rem">@alloc?.CityRoom?.CityBuilding?.BuildingName</div>
                </div>
                <div class="col-md-4">
                    <small style="color:var(--muted);font-size:.78rem">رقم الغرفة</small>
                    <div style="font-weight:700;font-size:.95rem">@alloc?.CityRoom?.RoomNumber</div>
                </div>
                <div class="col-md-4">
                    <small style="color:var(--muted);font-size:.78rem">تاريخ التسكين</small>
                    <div style="font-weight:700;font-size:.95rem">@(alloc?.AllocatedAt.HasValue == true ? alloc.AllocatedAt.Value.ToString("dd/MM/yyyy") : "—")</div>
                </div>
                <div class="col-md-4">
                    <small style="color:var(--muted);font-size:.78rem">الحالة</small>
                    <div><span class="badge" style="background:var(--success-dim);color:var(--success);border:1px solid rgba(16,185,129,.3)">@alloc?.Status</span></div>
                </div>
            </div>
        }
    </div>
</div>

@* Absence Records *@
<div class="card-site mb-4">
    <div class="card-site-header">
        <i class="bi bi-clock-history" style="color:var(--warn)"></i>
        سجل طلبات الغياب (آخر 10)
    </div>
    <div class="card-site-body p-0">
        @{
            var absencesList = ViewBag.Absences as List<UniStay.Models.Absence> ?? new();
        }
        @if (!absencesList.Any())
        {
            <div class="p-3" style="color:var(--muted);font-size:.88rem">
                <i class="bi bi-info-circle me-2"></i> لا توجد طلبات غياب مسجلة.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table mb-0" style="color:var(--text)">
                    <thead style="background:var(--black-3);color:var(--muted);font-size:.78rem">
                        <tr>
                            <th class="px-3 py-2">#</th>
                            <th class="px-3 py-2">النوع</th>
                            <th class="px-3 py-2">من</th>
                            <th class="px-3 py-2">إلى</th>
                            <th class="px-3 py-2">الحالة</th>
                            <th class="px-3 py-2">تاريخ الطلب</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var ab in absencesList)
                        {
                            var badgeColor = ab.Status switch { "Approved" => "var(--success)", "Rejected" => "#ef4444", "Pending" => "var(--warn)", _ => "var(--muted)" };
                            var badgeBg = ab.Status switch { "Approved" => "var(--success-dim)", "Rejected" => "rgba(239,68,68,.12)", "Pending" => "var(--warn-dim)", _ => "transparent" };
                            var statusText = ab.Status switch { "Approved" => "موافق عليه", "Rejected" => "مرفوض", "Pending" => "قيد المراجعة", _ => ab.Status };
                            <tr>
                                <td class="px-3 py-2" style="font-size:.85rem">@ab.ID</td>
                                <td class="px-3 py-2" style="font-size:.85rem">@ab.AbsenceType</td>
                                <td class="px-3 py-2" style="font-size:.85rem">@ab.AbsenceDate.ToString("dd/MM/yyyy")</td>
                                <td class="px-3 py-2" style="font-size:.85rem">@(ab.ToDate.HasValue ? ab.ToDate.Value.ToString("dd/MM/yyyy") : "—")</td>
                                <td class="px-3 py-2"><span class="badge" style="background:@badgeBg;color:@badgeColor;border:1px solid">@statusText</span></td>
                                <td class="px-3 py-2" style="font-size:.85rem">@(ab.CreatedAt.HasValue ? ab.CreatedAt.Value.ToString("dd/MM/yyyy") : "—")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
