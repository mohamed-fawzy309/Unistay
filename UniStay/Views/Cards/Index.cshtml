@model CardIndexViewModel
@{
    ViewData["Title"] = "قائمة طباعة البطاقات";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h5 class="page-title mb-0"><i class="bi bi-credit-card-2-front"></i> @ViewData["Title"]</h5>
    <a class="btn btn-primary btn-sm" asp-action="PrintSelection"><i class="bi bi-plus-lg"></i> إضافة للطباعة</a>
</div>

<div class="row g-2 mb-3">
    <div class="col-md-3">
        <div class="card bg-info text-white p-2 text-center">
            <h6>قيد الانتظار</h6>
            <h4>@Model.PendingCount</h4>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card bg-success text-white p-2 text-center">
            <h6>تم الطباعة</h6>
            <h4>@Model.PrintedCount</h4>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card bg-danger text-white p-2 text-center">
            <h6>فشل</h6>
            <h4>@Model.FailedCount</h4>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card bg-secondary text-white p-2 text-center">
            <h6>الإجمالي</h6>
            <h4>@Model.TotalCount</h4>
        </div>
    </div>
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-md-4">
        <input name="search" class="form-control form-control-sm" placeholder="بحث بالاسم أو الرقم القومي" value="@Model.Filter.Search" />
    </div>
    <div class="col-md-3">
        <select name="cityId" class="form-select form-select-sm">
            <option value="">كل المدن</option>
            @foreach (var c in Model.Cities)
            {
                <option value="@c.ID" selected="@(Model.Filter.CityID == c.ID)">@c.Name</option>
            }
        </select>
    </div>
    <div class="col-md-2">
        <select name="status" class="form-select form-select-sm">
            <option value="">الكل</option>
            <option value="Pending" selected="@(Model.Filter.Status == "Pending")">قيد الانتظار</option>
            <option value="Printed" selected="@(Model.Filter.Status == "Printed")">تم الطباعة</option>
            <option value="Failed" selected="@(Model.Filter.Status == "Failed")">فشل</option>
        </select>
    </div>
    <div class="col-md-2">
        <button class="btn btn-primary btn-sm w-100"><i class="bi bi-search"></i> بحث</button>
    </div>
    <div class="col-md-1">
        <a class="btn btn-outline-secondary btn-sm w-100" asp-action="Index"><i class="bi bi-x-lg"></i></a>
    </div>
</form>

<form method="post" asp-action="BatchPrint" id="batchForm">
    @Html.AntiForgeryToken()
    <div class="table-responsive">
        <table class="table table-hover table-bordered align-middle small">
            <thead class="table-dark">
                <tr>
                    <th><input type="checkbox" id="selectAll" /></th>
                    <th>الاسم</th>
                    <th>الرقم القومي</th>
                    <th>الكلية</th>
                    <th>المدينة</th>
                    <th>الحالة</th>
                    <th>تاريخ الإضافة</th>
                    <th>تاريخ الطباعة</th>
                    <th>طباعة بواسطة</th>
                    <th>إجراءات</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.QueuedItems.Any())
                {
                    <tr><td colspan="10" class="text-center text-muted">لا توجد عناصر</td></tr>
                }
                @foreach (var q in Model.QueuedItems)
                {
                    <tr>
                        <td><input type="checkbox" name="queueIds" value="@q.QueueID" class="rowCheck" /></td>
                        <td>@q.StudentName</td>
                        <td>@q.NationalID</td>
                        <td>@q.Faculty</td>
                        <td>@q.CityName</td>
                        <td>
                            @switch (q.Status)
                            {
                                case "Pending": <span class="badge bg-warning text-dark">قيد الانتظار</span> break;
                                case "Printed": <span class="badge bg-success">تم الطباعة</span> break;
                                case "Failed": <span class="badge bg-danger">فشل</span> break;
                            }
                        </td>
                        <td>@q.QueuedAt?.ToString("yyyy-MM-dd HH:mm")</td>
                        <td>@q.PrintedAt?.ToString("yyyy-MM-dd HH:mm")</td>
                        <td>@q.PrintedByName</td>
                        <td>
                            <div class="dropdown">
                                <button class="btn btn-sm btn-outline-secondary dropdown-toggle" data-bs-toggle="dropdown"></button>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" asp-action="PrintSingleFromQueue" asp-route-id="@q.QueueID"><i class="bi bi-printer"></i> طباعة</a></li>
                                    <li><a class="dropdown-item" asp-action="Preview" asp-route-studentId="@q.StudentID" target="_blank"><i class="bi bi-eye"></i> معاينة</a></li>
                                    @if (q.Status == "Pending")
                                    {
                                        <li><button class="dropdown-item text-success" onclick="markPrinted(@q.QueueID)"><i class="bi bi-check-lg"></i> تمت الطباعة</button></li>
                                        <li><button class="dropdown-item text-danger" onclick="markFailed(@q.QueueID)"><i class="bi bi-x-lg"></i> فشل</button></li>
                                    }
                                    <li><hr class="dropdown-divider" /></li>
                                    <li><button class="dropdown-item text-danger" onclick="removeFromQueue(@q.QueueID)"><i class="bi bi-trash"></i> حذف</button></li>
                                </ul>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (Model.QueuedItems.Any(q => q.Status == "Pending"))
    {
        <div class="mb-3">
            <button class="btn btn-success btn-sm" type="submit"><i class="bi bi-printer"></i> طباعة المحدد</button>
        </div>
    }
</form>

@if (Model.TotalPages > 1)
{
    <nav><ul class="pagination justify-content-center">
        @{
            var qsp = new Dictionary<string, string?>
            {
                {"search", Model.Filter.Search},
                {"cityId", Model.Filter.CityID?.ToString()},
                {"status", Model.Filter.Status}
            };
        }
        @for (int p = 1; p <= Model.TotalPages; p++)
        {
            <li class="page-item @(p == Model.Page ? "active" : "")">
                <a class="page-link" asp-all-route-data="@(new Dictionary<string, string>(qsp.Where(kv => kv.Value != null).ToDictionary(kv => kv.Key, kv => kv.Value!)) { ["page"] = p.ToString() })">@p</a>
            </li>
        }
    </ul></nav>
}

@section Scripts {
    <script>
        document.getElementById('selectAll')?.addEventListener('change', function() {
            document.querySelectorAll('.rowCheck').forEach(c => c.checked = this.checked);
        });

        function markPrinted(id) {
            if (!confirm('تأكيد طباعة البطاقة؟')) return;
            fetch('@Url.Action("MarkPrinted", "Cards")/' + id, {
                method: 'POST', headers: { 'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value }
            }).then(r => r.json()).then(d => { if (d.success) location.reload(); });
        }

        function markFailed(id) {
            if (!confirm('تأكيد فشل الطباعة؟')) return;
            fetch('@Url.Action("MarkFailed", "Cards")/' + id, {
                method: 'POST', headers: { 'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value }
            }).then(r => r.json()).then(d => { if (d.success) location.reload(); });
        }

        function removeFromQueue(id) {
            if (!confirm('تأكيد حذف العنصر؟')) return;
            fetch('@Url.Action("RemoveFromQueue", "Cards")/' + id, {
                method: 'POST', headers: { 'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value }
            }).then(r => r.json()).then(d => { if (d.success) location.reload(); });
        }
    </script>
}
