@{
    ViewData["Title"] = "ليس لديك صلاحية";
    Layout = "~/Views/Shared/_LoginLayout.cshtml";
}

<div class="row justify-content-center" style="margin-top:3rem">
    <div class="col-md-6">
        <div class="login-card">
            <div class="login-header">
                <div class="mb-3">
                    <i class="bi bi-shield-exclamation" style="font-size:3rem;color:#ef4444"></i>
                </div>
                <h4>ليس لديك صلاحية للوصول لهذه الصفحة</h4>
                <p>إذا كنت تعتقد أن هذا خطأ، يرجى التواصل مع المسؤول</p>
            </div>
            <div class="login-body text-center">
                <a href="/" class="btn btn-login mb-3">
                    <i class="bi bi-house-door me-2"></i> العودة للرئيسية
                </a>
                <div>
                    <a asp-controller="Account" asp-action="Logout" class="text-decoration-none" style="color:var(--muted)">
                        <i class="bi bi-box-arrow-left me-1"></i> تسجيل الخروج
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
