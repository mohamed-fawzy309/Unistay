@model UniStay.Models.DormitoryCity
@{
    ViewData["Title"] = "UniStay - " + Model.Name;
    Layout = null;
    int availableBeds = Convert.ToInt32(ViewBag.TotalBeds) - Convert.ToInt32(ViewBag.OccupiedBeds);
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>UniStay — @Model.Name</title>
    <link href="~/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@300;400;500;700;800;900&display=swap" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet" />
    <style>
        :root {
            --red: #e63946;
            --red-dark: #b52530;
            --red-dim: rgba(230,57,70,.15);
            --black: #080b10;
            --black-2: #0f1319;
            --black-3: #161c26;
            --black-4: #1e2736;
            --border: #1e2736;
            --text: #e8eaf0;
            --muted: #6b7a99;
        }

        *, *::before, *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            font-family: 'Tajawal',sans-serif;
            background: var(--black);
            color: var(--text);
            overflow-x: hidden;
        }

        ::-webkit-scrollbar {
            width: 5px;
        }

        ::-webkit-scrollbar-track {
            background: var(--black);
        }

        ::-webkit-scrollbar-thumb {
            background: var(--red-dark);
            border-radius: 3px;
        }

        .navbar {
            background: rgba(8,11,16,.85);
            backdrop-filter: blur(16px);
            border-bottom: 1px solid rgba(230,57,70,.12);
            padding: .9rem 0;
            position: fixed;
            top: 0;
            width: 100%;
            z-index: 1000;
            transition: all .3s;
        }

            .navbar.scrolled {
                background: rgba(8,11,16,.97);
                box-shadow: 0 4px 30px rgba(0,0,0,.5);
            }

        .navbar-brand {
            font-size: 1.5rem;
            font-weight: 900;
            background: linear-gradient(135deg,#ff6b7a,var(--red));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .nav-link {
            color: var(--muted) !important;
            font-weight: 500;
            font-size: .9rem;
            transition: color .2s;
            padding: .4rem .9rem !important;
        }

            .nav-link:hover {
                color: #fff !important;
            }

        .btn-nav-login {
            background: transparent;
            border: 1px solid var(--red);
            color: var(--red) !important;
            border-radius: 8px;
            padding: .35rem 1.1rem !important;
            font-size: .88rem;
            font-weight: 600;
            transition: all .25s;
        }

            .btn-nav-login:hover {
                background: var(--red);
                color: #fff !important;
            }

        .btn-nav-reg {
            background: var(--red);
            border: 1px solid var(--red);
            color: #fff !important;
            border-radius: 8px;
            padding: .35rem 1.1rem !important;
            font-size: .88rem;
            font-weight: 600;
            transition: all .25s;
            margin-right: .4rem;
        }

            .btn-nav-reg:hover {
                background: var(--red-dark);
            }

        /* PAGE HERO */
        .page-hero {
            padding: 9rem 0 3rem;
            position: relative;
            overflow: hidden;
            background: linear-gradient(180deg,var(--black) 0%,var(--black-2) 100%);
        }

            .page-hero::before {
                content: '';
                position: absolute;
                inset: 0;
                background-image: linear-gradient(rgba(230,57,70,.04) 1px,transparent 1px),linear-gradient(90deg,rgba(230,57,70,.04) 1px,transparent 1px);
                background-size: 55px 55px;
            }

        .orb {
            position: absolute;
            border-radius: 50%;
            filter: blur(90px);
            pointer-events: none;
        }

        .o1 {
            width: 500px;
            height: 500px;
            background: rgba(230,57,70,.07);
            top: -150px;
            left: -100px;
        }

        .o2 {
            width: 350px;
            height: 350px;
            background: rgba(10,20,50,.4);
            bottom: -50px;
            right: -80px;
        }

        .hero-inner {
            position: relative;
            z-index: 2;
        }

        .breadcrumb-row {
            display: flex;
            align-items: center;
            gap: .5rem;
            margin-bottom: 1.5rem;
            font-size: .83rem;
            color: var(--muted);
        }

            .breadcrumb-row a {
                color: var(--muted);
                text-decoration: none;
                transition: color .2s;
            }

                .breadcrumb-row a:hover {
                    color: var(--red);
                }

            .breadcrumb-row .sep {
                color: var(--border);
            }

            .breadcrumb-row .current {
                color: var(--text);
            }

        .hero-title {
            font-size: clamp(1.8rem,5vw,2.8rem);
            font-weight: 900;
            margin-bottom: .5rem;
        }

            .hero-title .red {
                background: linear-gradient(135deg,#ff6b7a,var(--red));
                -webkit-background-clip: text;
                -webkit-text-fill-color: transparent;
            }

        .hero-meta {
            display: flex;
            align-items: center;
            gap: 1rem;
            flex-wrap: wrap;
            margin-top: .75rem;
        }

        .hero-badge {
            display: inline-flex;
            align-items: center;
            gap: .4rem;
            background: var(--red-dim);
            border: 1px solid rgba(230,57,70,.2);
            color: var(--red);
            border-radius: 50px;
            padding: .25rem .8rem;
            font-size: .78rem;
            font-weight: 600;
        }

        .hero-badge-neutral {
            background: rgba(255,255,255,.05);
            border: 1px solid var(--border);
            color: var(--muted);
            border-radius: 50px;
            padding: .25rem .8rem;
            font-size: .78rem;
            font-weight: 500;
        }

        @@keyframes fadeUp {
            from {
                opacity: 0;
                transform: translateY(20px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .fade-up {
            animation: fadeUp .6s both;
        }

        .fade-up-2 {
            animation: fadeUp .6s .1s both;
        }

        .fade-up-3 {
            animation: fadeUp .6s .2s both;
        }

        /* STATS ROW */
        .stats-strip {
            background: var(--black-2);
            border-top: 1px solid var(--border);
            border-bottom: 1px solid var(--border);
            padding: 2.5rem 0;
        }

        .stat-box {
            text-align: center;
        }

        .stat-num-lg {
            font-size: 2rem;
            font-weight: 900;
            display: block;
        }

        .stat-lbl {
            color: var(--muted);
            font-size: .8rem;
            margin-top: .15rem;
        }

        .stat-red .stat-num-lg {
            background: linear-gradient(135deg,#ff6b7a,var(--red));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .stat-blue .stat-num-lg {
            color: #60a5fa;
        }

        .stat-green .stat-num-lg {
            color: #34d399;
        }

        .stat-amber .stat-num-lg {
            color: #fbbf24;
        }

        /* CONTENT */
        .content-section {
            padding: 4rem 0;
        }

        .info-card {
            background: var(--black-2);
            border: 1px solid var(--border);
            border-radius: 20px;
            overflow: hidden;
            margin-bottom: 1.5rem;
        }

        .info-card-header {
            padding: 1.1rem 1.75rem;
            display: flex;
            align-items: center;
            gap: .75rem;
            font-weight: 700;
            font-size: .95rem;
        }

            .info-card-header.blue {
                background: linear-gradient(135deg,rgba(59,130,246,.15),transparent);
                border-bottom: 1px solid rgba(59,130,246,.2);
                color: #60a5fa;
            }

            .info-card-header.green {
                background: linear-gradient(135deg,rgba(52,211,153,.12),transparent);
                border-bottom: 1px solid rgba(52,211,153,.18);
                color: #34d399;
            }

            .info-card-header .hicon {
                width: 36px;
                height: 36px;
                border-radius: 9px;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: .9rem;
            }

            .info-card-header.blue .hicon {
                background: rgba(59,130,246,.15);
            }

            .info-card-header.green .hicon {
                background: rgba(52,211,153,.12);
            }

        .info-card-body {
            padding: 1.5rem 1.75rem;
        }

        .info-row {
            display: flex;
            align-items: center;
            padding: .65rem 0;
            border-bottom: 1px solid rgba(255,255,255,.04);
            gap: 1rem;
        }

            .info-row:last-child {
                border-bottom: none;
            }

        .info-label {
            color: var(--muted);
            font-size: .85rem;
            min-width: 120px;
            flex-shrink: 0;
        }

        .info-value {
            color: var(--text);
            font-size: .88rem;
            font-weight: 600;
        }

        .status-active {
            display: inline-flex;
            align-items: center;
            gap: .4rem;
            background: rgba(52,211,153,.1);
            border: 1px solid rgba(52,211,153,.2);
            color: #34d399;
            border-radius: 6px;
            padding: .15rem .6rem;
            font-size: .78rem;
        }

        .status-inactive {
            background: rgba(239,68,68,.1);
            border: 1px solid rgba(239,68,68,.2);
            color: #f87171;
        }

        /* BUILDINGS GRID */
        .building-card {
            background: var(--black-3);
            border: 1px solid var(--border);
            border-radius: 16px;
            padding: 1.5rem;
            height: 100%;
            transition: transform .3s,border-color .3s,box-shadow .3s;
        }

            .building-card:hover {
                transform: translateY(-5px);
                border-color: rgba(230,57,70,.3);
                box-shadow: 0 16px 40px rgba(0,0,0,.4);
            }

        .building-icon {
            width: 46px;
            height: 46px;
            border-radius: 11px;
            background: var(--red-dim);
            border: 1px solid rgba(230,57,70,.2);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.1rem;
            color: var(--red);
            margin-bottom: 1rem;
        }

        .building-name {
            font-size: .95rem;
            font-weight: 800;
            margin-bottom: .35rem;
        }

        .building-type {
            display: inline-block;
            background: rgba(255,255,255,.04);
            border: 1px solid var(--border);
            color: var(--muted);
            border-radius: 6px;
            padding: .15rem .55rem;
            font-size: .73rem;
            font-weight: 500;
            margin-bottom: .9rem;
        }

        .building-stats {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: .5rem;
        }

        .b-stat {
            background: rgba(255,255,255,.03);
            border: 1px solid var(--border);
            border-radius: 8px;
            padding: .5rem .75rem;
            text-align: center;
        }

        .b-stat-num {
            font-size: 1.05rem;
            font-weight: 800;
            background: linear-gradient(135deg,#ff6b7a,var(--red));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            display: block;
        }

        .b-stat-lbl {
            color: var(--muted);
            font-size: .7rem;
            margin-top: .1rem;
        }

        /* BACK BUTTON */
        .btn-back {
            display: inline-flex;
            align-items: center;
            gap: .5rem;
            background: var(--black-2);
            border: 1px solid var(--border);
            color: var(--muted);
            border-radius: 10px;
            padding: .55rem 1.2rem;
            font-family: 'Tajawal',sans-serif;
            font-size: .88rem;
            font-weight: 600;
            text-decoration: none;
            transition: all .25s;
        }

            .btn-back:hover {
                border-color: rgba(230,57,70,.3);
                color: var(--red);
            }

        .btn-apply {
            display: inline-flex;
            align-items: center;
            gap: .5rem;
            background: linear-gradient(135deg,var(--red),var(--red-dark));
            border: none;
            color: #fff;
            border-radius: 10px;
            padding: .55rem 1.4rem;
            font-family: 'Tajawal',sans-serif;
            font-size: .88rem;
            font-weight: 700;
            text-decoration: none;
            transition: transform .2s,box-shadow .2s;
        }

            .btn-apply:hover {
                transform: translateY(-2px);
                box-shadow: 0 8px 25px rgba(230,57,70,.4);
                color: #fff;
            }

        .section-tag {
            display: inline-block;
            background: var(--red-dim);
            border: 1px solid rgba(230,57,70,.2);
            color: var(--red);
            border-radius: 50px;
            padding: .25rem .8rem;
            font-size: .75rem;
            font-weight: 600;
            letter-spacing: .08em;
            text-transform: uppercase;
            margin-bottom: .75rem;
        }

        .reveal {
            opacity: 0;
            transform: translateY(24px);
            transition: opacity .7s,transform .7s;
        }

            .reveal.visible {
                opacity: 1;
                transform: translateY(0);
            }

        footer {
            background: var(--black-2);
            border-top: 1px solid var(--border);
            padding: 2.5rem 0;
            text-align: center;
        }

        .footer-brand {
            font-size: 1.1rem;
            font-weight: 900;
            background: linear-gradient(135deg,#ff6b7a,var(--red));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            margin-bottom: .4rem;
        }

        .footer-text {
            color: var(--muted);
            font-size: .82rem;
        }
    </style>
</head>
<body>

    <!-- NAVBAR -->
    <nav class="navbar navbar-expand-lg">
        <div class="container">
            <a class="navbar-brand" href="/"><img src="~/images/Unistay_logo.png" alt="UniStay" style="height:48px;filter:drop-shadow(0 2px 8px rgba(230,57,70,.3))"></a>
            <div class="collapse navbar-collapse" id="nav">
                <ul class="navbar-nav mx-auto gap-1">
                    <li class="nav-item"><a class="nav-link" href="/Home/Announcements">الإعلانات</a></li>
                    <li class="nav-item"><a class="nav-link active" href="/Home/Cities" style="color:#fff!important">المدن الجامعية</a></li>
                    <li class="nav-item"><a class="nav-link" href="/#features">المميزات</a></li>
                    <li class="nav-item"><a class="nav-link" href="/#how">كيف يعمل</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Home/About">عن النظام</a></li>
                </ul>
                <div class="d-flex gap-2 mt-2 mt-lg-0">
                    <a href="/Home/Dates" class="nav-link btn-nav-login">مواعيد التقدم</a>
                    <a href="/Home/Accept" class="nav-link btn-nav-reg">استعلام عن القبول</a>
                </div>
            </div>
        </div>
    </nav>

    <!-- PAGE HERO -->
    <div class="page-hero">
        <div class="orb o1"></div>
        <div class="orb o2"></div>
        <div class="container">
            <div class="hero-inner">
                <div class="breadcrumb-row fade-up">
                    <a href="/"><i class="fa-solid fa-house" style="font-size:.75rem"></i> الرئيسية</a>
                    <span class="sep">›</span>
                    <a href="/Home/Cities">المدن الجامعية</a>
                    <span class="sep">›</span>
                    <span class="current">@Model.Name</span>
                </div>
                <h1 class="hero-title fade-up-2"><span class="red">@Model.Name</span></h1>
                <div class="hero-meta fade-up-3">
                    <span class="hero-badge"><i class="fa-solid fa-venus-mars"></i> @Model.CityType</span>
                    @if (!string.IsNullOrEmpty(Model.Location))
                    {
                        <span class="hero-badge-neutral"><i class="fa-solid fa-location-dot" style="color:var(--red)"></i> @Model.Location</span>
                    }
                    @if (Model.University != null)
                    {
                        <span class="hero-badge-neutral"><i class="fa-solid fa-graduation-cap" style="color:var(--red)"></i> @Model.University.Name</span>
                    }
                    <span class="hero-badge-neutral" style="@(Model.IsActive ? "color:#34d399" : "color:#f87171")">
                        <i class="fa-solid fa-circle" style="font-size:.5rem"></i>
                        @(Model.IsActive ? "نشط" : "غير نشط")
                    </span>
                </div>
            </div>
        </div>
    </div>

    <!-- STATS STRIP -->
    <div class="stats-strip">
        <div class="container">
            <div class="row g-4">
                <div class="col-6 col-md-3 reveal">
                    <div class="stat-box stat-red">
                        <span class="stat-num-lg" data-target="@ViewBag.TotalBuildings">0</span>
                        <div class="stat-lbl">مبنى</div>
                    </div>
                </div>
                <div class="col-6 col-md-3 reveal">
                    <div class="stat-box stat-blue">
                        <span class="stat-num-lg" data-target="@ViewBag.TotalRooms">0</span>
                        <div class="stat-lbl">غرفة</div>
                    </div>
                </div>
                <div class="col-6 col-md-3 reveal">
                    <div class="stat-box stat-green">
                        <span class="stat-num-lg" data-target="@ViewBag.TotalBeds">0</span>
                        <div class="stat-lbl">سرير</div>
                    </div>
                </div>
                <div class="col-6 col-md-3 reveal">
                    <div class="stat-box stat-amber">
                        <span class="stat-num-lg" data-target="@availableBeds">0</span>
                        <div class="stat-lbl">سرير متاح</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- CONTENT -->
    <section class="content-section">
        <div class="container">

            <!-- City Info -->
            <div class="row g-4 mb-4">
                <div class="col-12 reveal">
                    <div class="info-card">
                        <div class="info-card-header blue">
                            <span class="hicon"><i class="fa-solid fa-circle-info"></i></span>
                            بيانات المدينة
                        </div>
                        <div class="info-card-body">
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="info-row">
                                        <span class="info-label">النوع</span>
                                        <span class="info-value">@Model.CityType</span>
                                    </div>
                                    <div class="info-row">
                                        <span class="info-label">الموقع</span>
                                        <span class="info-value">@(Model.Location ?? "—")</span>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="info-row">
                                        <span class="info-label">الجامعة</span>
                                        <span class="info-value">@(Model.University?.Name ?? "—")</span>
                                    </div>
                                    <div class="info-row">
                                        <span class="info-label">الحالة</span>
                                        <span class="info-value">
                                            <span class="status-active @(!Model.IsActive ? "status-inactive" : "")">
                                                <i class="fa-solid fa-circle" style="font-size:.4rem"></i>
                                                @(Model.IsActive ? "نشط" : "غير نشط")
                                            </span>
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Buildings -->
            <div class="reveal">
                <div class="info-card">
                    <div class="info-card-header green">
                        <span class="hicon"><i class="fa-solid fa-building"></i></span>
                        المباني (@Model.CityBuildings.Count)
                    </div>
                    <div class="info-card-body">
                        @if (Model.CityBuildings.Any())
                        {
                            <div class="row g-3">
                                @foreach (var b in Model.CityBuildings)
                                {
                                    <div class="col-sm-6 col-lg-4">
                                        <div class="building-card">
                                            <div class="building-icon">
                                                <i class="fa-solid fa-building"></i>
                                            </div>
                                            <div class="building-name">@b.BuildingName</div>
                                            <div><span class="building-type">@b.BuildingType</span></div>
                                            <div class="building-stats">
                                                <div class="b-stat">
                                                    <span class="b-stat-num">@b.FloorCount</span>
                                                    <div class="b-stat-lbl">أدوار</div>
                                                </div>
                                                <div class="b-stat">
                                                    <span class="b-stat-num">@b.CityRooms.Count</span>
                                                    <div class="b-stat-lbl">غرف</div>
                                                </div>
                                                <div class="b-stat" style="grid-column:span 2">
                                                    <span class="b-stat-num">@b.CityRooms.Sum(r => r.BedsCount)</span>
                                                    <div class="b-stat-lbl">أسرّة</div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <p style="color:var(--muted);text-align:center;padding:2rem 0">لا توجد مباني مسجلة</p>
                        }
                    </div>
                </div>
            </div>

            <!-- Action Buttons -->
            <div class="d-flex align-items-center gap-3 mt-4 reveal">
                <a asp-action="Cities" class="btn-back">
                    <i class="fa-solid fa-arrow-right" style="font-size:.75rem"></i>
                    رجوع للمدن
                </a>
                <a href="/Application/Apply" class="btn-apply">
                    <i class="fa-solid fa-user-plus"></i>
                    تقدّم الآن
                </a>
            </div>

        </div>
    </section>

    <!-- FOOTER -->
    <footer>
        <div class="container">
            <div class="footer-brand">UniStay</div>
            <div class="footer-text"><span>نظام إدارة السكن الجامعي</span> &nbsp;·&nbsp; جميع الحقوق محفوظة &nbsp;·&nbsp; &copy; 2026</div>
        </div>
    </footer>

    <script src="/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        window.addEventListener('scroll', () => { document.querySelector('.navbar').classList.toggle('scrolled', scrollY > 40); });
        const ro = new IntersectionObserver(entries => { entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('visible'); ro.unobserve(e.target); } }); }, { threshold: .12 });
        document.querySelectorAll('.reveal').forEach((el, i) => { el.style.transitionDelay = (i % 3) * .1 + 's'; ro.observe(el); });
        const counters = document.querySelectorAll('[data-target]');
        const co = new IntersectionObserver(entries => {
            entries.forEach(e => {
                if (!e.isIntersecting) return;
                const el = e.target, end = +el.dataset.target, dur = 1500, step = 16;
                const inc = end / (dur / step); let cur = 0;
                const timer = setInterval(() => { cur = Math.min(cur + inc, end); el.textContent = Math.floor(cur).toLocaleString('ar-EG'); if (cur >= end) clearInterval(timer); }, step);
                co.unobserve(el);
            });
        }, { threshold: .5 });
        counters.forEach(c => co.observe(c));
    </script>
</body>
</html>
