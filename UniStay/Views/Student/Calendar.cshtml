@{
    ViewData["Title"] = "حجز الوجبات";
    var calendarDays = ViewBag.CalendarDays as List<CalendarDayViewModel> ?? new();
    var monthYear = ViewBag.MonthYear as string ?? "";
    var cityId = (int)ViewBag.DormitoryCityID;
    var studentName = ViewBag.StudentName as string ?? "";
    var nationalId = ViewBag.StudentNationalID as string ?? "";
    var cityName = ViewBag.CityName as string ?? "";
    var today = DateOnly.FromDateTime(DateTime.Today);
    var bookingStart = today.AddDays(1);
    var bookingEnd = today.AddDays(4);
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="page-title"><i class="bi bi-calendar-check"></i> حجز الوجبات</h2>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">@TempData["Success"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">@TempData["Error"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
}

<div class="row">
    <div class="col-md-4">
        <div class="card">
            <div class="card-header bg-primary text-white"><h5 class="mb-0">معلومات الطالب</h5></div>
            <div class="card-body">
                <h5>@studentName</h5>
                <p class="text-muted mb-1">@nationalId</p>
                <p class="text-muted">@cityName</p>

                <div class="mt-3 p-3 rounded bg-success-subtle">
                    <h5 class="text-success">الحجز متاح من @bookingStart.ToString("dd/MM") إلى @bookingEnd.ToString("dd/MM")</h5>
                </div>

                <hr />
                <div class="mt-2">
                    <p class="mb-1"><strong>سعر الوجبة:</strong> 25 ج.م</p>
                    <p class="mb-0 text-muted">وجبة واحدة يومياً</p>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-8">
        <div class="card">
            <div class="card-header bg-success text-white d-flex justify-content-between align-items-center">
                <h5 class="mb-0">اختر الأيام للحجز</h5>
                <span>@monthYear</span>
            </div>
            <div class="card-body">
                <form asp-action="BookDates" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="StudentID" value="@ViewBag.StudentID" />
                    <input type="hidden" name="DormitoryCityID" value="@cityId" />

                    <div class="calendar-grid">
                        <div class="calendar-header">
                            <span>الأحد</span><span>الاثنين</span><span>الثلاثاء</span><span>الأربعاء</span><span>الخميس</span><span>الجمعة</span><span>السبت</span>
                        </div>
                        <div class="calendar-body">
                            @foreach (var day in calendarDays)
                            {
                                <div class="calendar-day @(day.IsCurrentMonth ? "" : "other-month") @(day.IsPast ? "past" : "") @(day.IsBooked ? "booked" : "") @(day.IsBlocked ? "blocked" : "")">
                                    @if (day.IsCurrentMonth && !day.IsPast && !day.IsBlocked && day.Date >= bookingStart && day.Date <= bookingEnd)
                                    {
                                        <label class="day-label">
                                            <input type="checkbox" name="SelectedDates" value="@day.Date.ToString("yyyy-MM-dd")"
                                            class="day-checkbox" @(day.IsBooked ? "checked disabled" : "") />
                                            <span class="day-number">@day.DayNumber</span>
                                        </label>
                                    }
                                    else
                                    {
                                        <span class="day-number @(day.IsBooked ? "text-success" : day.IsBlocked ? "text-danger" : "")">
                                            @day.DayNumber
                                            @if (day.IsBooked) { <i class="bi bi-check-circle-fill text-success small"></i> }
                                            @if (day.IsBlocked && !day.IsBooked) { <i class="bi bi-x-circle-fill text-danger small"></i> }
                                        </span>
                                    }
                                </div>
                            }
                        </div>
                    </div>

                    <div class="mt-3 d-flex gap-3 align-items-center">
                        <button type="submit" class="btn btn-success btn-lg" id="bookBtn">
                            <i class="bi bi-check-circle"></i> حجز الأيام المحددة
                        </button>
                        <div class="d-flex gap-3 me-auto">
                            <span class="badge bg-success p-2"><i class="bi bi-check-circle-fill"></i> محجوز</span>
                            <span class="badge bg-danger p-2"><i class="bi bi-x-circle-fill"></i> محظور</span>
                            <span class="badge bg-secondary p-2"><i class="bi bi-square"></i> متاح</span>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .calendar-grid { direction: ltr; }
        .calendar-header {
            display: grid;
            grid-template-columns: repeat(7, 1fr);
            text-align: center;
            font-weight: bold;
            background: #f8f9fa;
            padding: 8px 0;
            border-radius: 8px 8px 0 0;
        }
        .calendar-body {
            display: grid;
            grid-template-columns: repeat(7, 1fr);
            border: 1px solid #dee2e6;
            border-top: none;
        }
        .calendar-day {
            min-height: 70px;
            display: flex;
            align-items: center;
            justify-content: center;
            border: 1px solid #eee;
            padding: 4px;
            position: relative;
        }
        .calendar-day.other-month { opacity: 0.3; }
        .calendar-day.past { background: #f5f5f5; }
        .calendar-day.booked { background: #d4edda; }
        .calendar-day.blocked { background: #f8d7da; }
        .day-label {
            display: flex;
            flex-direction: column;
            align-items: center;
            cursor: pointer;
            width: 100%;
            height: 100%;
            justify-content: center;
        }
        .day-checkbox { width: 18px; height: 18px; cursor: pointer; }
        .day-number { font-size: 14px; margin-top: 2px; display: flex; align-items: center; gap: 2px; }
        .day-checkbox:disabled + .day-number { opacity: 0.7; }
    </style>
}

@section Scripts {
    <script>
        var submitting = false;
        document.getElementById('bookBtn').addEventListener('click', function(e) {
            if (submitting) { e.preventDefault(); return; }
            var checked = document.querySelectorAll('.day-checkbox:checked:not(:disabled)');
            if (checked.length === 0) {
                e.preventDefault();
                alert('اختر يوم واحد على الأقل');
                return;
            }
            var bookedCount = document.querySelectorAll('.day-checkbox:disabled:checked').length;
            if (bookedCount + checked.length > 4) {
                e.preventDefault();
                alert('لا يمكن حجز أكثر من 4 أيام إجمالاً');
                return;
            }
            submitting = true;
            this.innerHTML = '<span class="spinner-border spinner-border-sm"></span> جاري الحجز...';
        });
    </script>
}
