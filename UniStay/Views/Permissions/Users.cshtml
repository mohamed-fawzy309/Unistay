@model UniStay.ViewModels.Permissions.UserListViewModel
@using UniStay.ViewModels.Permissions
@{
    ViewData["Title"] = "إدارة المستخدمين";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var currentUID = (int)(ViewBag.CurrentUserID ?? 0);
    var permGroups = ViewBag.PermissionGroups as List<PermissionGroupViewModel> ?? new();
}

@section Scripts {
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdn.datatables.net/1.13.7/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.datatables.net/1.13.7/js/dataTables.bootstrap5.min.js"></script>
<link rel="stylesheet" href="https://cdn.datatables.net/1.13.7/css/dataTables.bootstrap5.min.css"/>
<script>
$(function(){
    $('#usersTable').DataTable({
        language: { search:"بحث:", lengthMenu:"عرض _MENU_", info:"_START_-_END_ من _TOTAL_", paginate:{next:"التالي",previous:"السابق"}, zeroRecords:"لا توجد نتائج" },
        order:[[0,'asc']], columnDefs:[{orderable:false,targets:[4,5,7]}]
    });

    // Toggle Active
    $(document).on('change','.toggle-active',function(){
        const id=$(this).data('id'), cb=$(this);
        $.post('/Permissions/ToggleActive',{id,__RequestVerificationToken:$('[name=__RequestVerificationToken]').val()})
         .done(r=>{ if(r.success) toast(r.message,r.isActive?'success':'warning');
                    else{ cb.prop('checked',!cb.prop('checked')); toast(r.message,'danger'); } });
    });

    // Reset Password
    $(document).on('click','.btn-reset',function(){
        if(!confirm('إعادة تعيين كلمة المرور وإرسالها بالإيميل؟')) return;
        const id=$(this).data('id');
        $.post('/Permissions/ResetPassword',{id,__RequestVerificationToken:$('[name=__RequestVerificationToken]').val()})
         .done(r=>toast(r.message,r.success?'success':'danger'));
    });

    // Delete
    $(document).on('click','.btn-delete',function(){
        const id=$(this).data('id'), name=$(this).data('name');
        if(!confirm(`حذف "${name}"؟ لا يمكن التراجع.`)) return;
        $.post('/Permissions/DeleteUser',{id,__RequestVerificationToken:$('[name=__RequestVerificationToken]').val()})
         .done(r=>{ if(r.success) location.reload(); else toast(r.message,'danger'); });
    });

    // Select All per group (create modal)
    $(document).on('change','.chk-all-create',function(){
        const checked=$(this).prop('checked');
        const gid=$(this).data('group');
        $(`.perm-check-create[data-group="${gid}"]`).prop('checked',checked);
    });

    function toast(msg,type='success'){
        const t=$(`<div class="toast align-items-center text-bg-${type} border-0 position-fixed bottom-0 end-0 m-3 show" style="z-index:9999">
            <div class="d-flex"><div class="toast-body">${msg}</div>
            <button class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button></div></div>`);
        $('body').append(t); setTimeout(()=>t.remove(),3500);
    }
});
</script>
}

<div class="container-fluid py-3">

    @* بطاقات الإحصاءات *@
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card border-0 text-white h-100" style="background:linear-gradient(135deg,#1e3a5f,#2563eb)">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <div class="fs-2 fw-bold">@Model.TotalCount</div>
                        <div class="small opacity-75">إجمالي المستخدمين</div>
                    </div>
                    <i class="bi bi-people-fill fs-1 opacity-50"></i>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 text-white h-100" style="background:linear-gradient(135deg,#065f46,#10b981)">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <div class="fs-2 fw-bold">@Model.ActiveCount</div>
                        <div class="small opacity-75">حسابات نشطة</div>
                    </div>
                    <i class="bi bi-person-check-fill fs-1 opacity-50"></i>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 text-white h-100" style="background:linear-gradient(135deg,#92400e,#f59e0b)">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <div class="fs-2 fw-bold">@Model.SuperAdminCount</div>
                        <div class="small opacity-75">مشرفون رئيسيون</div>
                    </div>
                    <i class="bi bi-shield-fill-check fs-1 opacity-50"></i>
                </div>
            </div>
        </div>
    </div>

    @* Header *@
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h5 class="mb-0 fw-bold"><i class="bi bi-people me-2 text-primary"></i>إدارة المستخدمين</h5>
            <small class="text-muted">إضافة الموظفين وإدارة حساباتهم</small>
        </div>
        <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addUserModal">
            <i class="bi bi-person-plus-fill me-1"></i> إضافة موظف
        </button>
    </div>

    @* Alerts *@
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
            <button class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            <i class="bi bi-exclamation-circle-fill me-2"></i>@TempData["Error"]
            <button class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @* AntiForgery للـ AJAX *@
    @Html.AntiForgeryToken()

    @* الجدول *@
    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <table id="usersTable" class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>#</th>
                        <th>الموظف</th>
                        <th>الدور</th>
                        <th>الرقم القومي</th>
                        <th>الأدوار في المدن</th>
                        <th>الصلاحيات</th>
                        <th>آخر دخول</th>
                        <th>الحالة</th>
                        <th>الإجراءات</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var (user, i) in Model.Users.Select((u,i)=>(u,i+1)))
                    {
                        <tr>
                            <td class="text-muted">@i</td>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <div class="rounded-circle text-white d-flex align-items-center justify-content-center fw-bold"
                                         style="width:40px;height:40px;background:linear-gradient(135deg,#667eea,#764ba2);flex-shrink:0">
                                        @(user.Name.Length > 0 ? user.Name[0].ToString() : "؟")
                                    </div>
                                    <div>
                                        <div class="fw-semibold">
                                            @user.Name
                                            @if (user.IsSuperAdmin)
                                            {
                                                <span class="badge ms-1 text-white" style="background:linear-gradient(90deg,#7c3aed,#db2777);font-size:.7rem">SuperAdmin</span>
                                            }
                                        </div>
                                        <small class="text-muted">@user.Email</small>
                                        @if (user.MustChangePassword)
                                        {
                                            <br><small class="text-warning"><i class="bi bi-exclamation-triangle"></i> يجب تغيير كلمة المرور</small>
                                        }
                                    </div>
                                </div>
                            </td>
                            <td>
                                @if (user.RoleNames.Any())
                                {
                                    @foreach (var rn in user.RoleNames)
                                    {
                                        <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 me-1">@rn</span>
                                    }
                                }
                                else if (user.IsSuperAdmin)
                                {
                                    <span class="badge text-white" style="background:linear-gradient(90deg,#7c3aed,#db2777)">SuperAdmin</span>
                                }
                                else
                                {
                                    <span class="text-muted small">—</span>
                                }
                            </td>
                            <td><code class="text-secondary">@(user.NationalID ?? "—")</code></td>
                            <td>
                                @if (user.CityRoles.Any())
                                {
                                    foreach (var r in user.CityRoles)
                                    {
                                        <span class="badge bg-light text-dark border me-1 mb-1" style="font-size:.73rem">@r</span>
                                    }
                                }
                                else { <span class="text-muted small">لا يوجد</span> }
                            </td>
                            <td>
                                @if (user.IsSuperAdmin)
                                {
                                    <span class="badge text-white" style="background:#7c3aed">كل الصلاحيات</span>
                                }
                                else
                                {
                                    <span class="badge bg-light text-dark border">@user.DirectPermCount صلاحية</span>
                                }
                            </td>
                            <td>
                                @if (user.LastLoginAt.HasValue)
                                { <small>@user.LastLoginAt.Value.ToString("dd/MM/yyyy HH:mm")</small> }
                                else { <small class="text-muted">لم يسجل دخولاً</small> }
                            </td>
                            <td>
                                <div class="form-check form-switch">
                                    <input class="form-check-input toggle-active" type="checkbox"
                                           data-id="@user.ID" @(user.IsActive ? "checked" : "") style="cursor:pointer">
                                </div>
                            </td>
                            <td>
                                <div class="d-flex gap-1 flex-wrap">
                                    <a asp-action="Details" asp-route-id="@user.ID"
                                       class="btn btn-sm btn-outline-secondary" title="التفاصيل">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@user.ID"
                                       class="btn btn-sm btn-outline-success" title="تعديل">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <a asp-action="Assign" asp-route-userId="@user.ID"
                                       class="btn btn-sm btn-outline-primary" title="تعيين الصلاحيات">
                                        <i class="bi bi-shield-lock"></i>
                                    </a>
                                    <a asp-action="DataScopes" asp-route-userId="@user.ID"
                                       class="btn btn-sm btn-outline-info" title="نطاق البيانات">
                                        <i class="bi bi-funnel"></i>
                                    </a>
                                    <button class="btn btn-sm btn-outline-warning btn-reset"
                                            data-id="@user.ID" title="إعادة تعيين كلمة المرور">
                                        <i class="bi bi-key"></i>
                                    </button>
                                    @if (user.ID != currentUID)
                                    {
                                        <button class="btn btn-sm btn-outline-danger btn-delete"
                                                data-id="@user.ID" data-name="@user.Name" title="حذف">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@* Modal إضافة موظف *@
<div class="modal fade" id="addUserModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="Users" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title"><i class="bi bi-person-plus me-2"></i>إضافة موظف جديد</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">الاسم الكامل <span class="text-danger">*</span></label>
                        <input name="Name" class="form-control" placeholder="محمد أحمد علي" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">البريد الإلكتروني <span class="text-danger">*</span></label>
                        <input name="Email" type="email" class="form-control" placeholder="staff@assiut.edu.eg" required />
                        <small class="text-muted">سيُرسَل إليه بيانات الدخول</small>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">رقم الهاتف</label>
                        <input name="Phone" class="form-control" placeholder="01xxxxxxxxx" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">الرقم القومي</label>
                        <input name="NationalID" class="form-control" maxlength="14" placeholder="14 رقماً" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">الأدوار <small class="text-muted">(اختياري، متعدد)</small></label>
                        <select name="SelectedRoleIds" class="form-select" multiple size="4">
                            @foreach (var r in Model.AvailableRoles)
                            {
                                <option value="@r.Value">@r.Text</option>
                            }
                        </select>
                        <small class="text-muted">اضغط Ctrl للتحديد المتعدد. يمكن تركها فارغة واستخدام الصلاحيات المباشرة.</small>
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">المدينة (اختياري)</label>
                            <select name="DormitoryCityID" class="form-select">
                                <option value="">-- بدون مدينة --</option>
                                @foreach (var c in Model.AvailableCities)
                                {
                                    <option value="@c.Value">@c.Text</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">الدور في المدينة</label>
                            <select name="RoleInCity" class="form-select">
                                <option value="">-- بدون --</option>
                                @foreach (var ro in UserListViewModel.RoleInCityOptions)
                                {
                                    <option value="@ro">@ro</option>
                                }
                            </select>
                        </div>
                    </div>
                    <div class="form-check form-switch mb-3">
                        <input name="IsSuperAdmin" type="checkbox" class="form-check-input" id="isSuperAdmin" value="true" />
                        <input name="IsSuperAdmin" type="hidden" value="false" />
                        <label class="form-check-label text-danger fw-semibold" for="isSuperAdmin">
                            <i class="bi bi-shield-fill-exclamation me-1"></i>منح صلاحيات SuperAdmin الكاملة
                        </label>
                    </div>

                    @* ─── الصلاحيات المباشرة ─── *@
                    <div class="border rounded p-2">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="fw-semibold small"><i class="bi bi-shield-check me-1"></i>الصلاحيات المباشرة</span>
                            <a class="small text-decoration-none" data-bs-toggle="collapse" href="#createPermsCollapse">عرض/إخفاء</a>
                        </div>
                        <div class="collapse" id="createPermsCollapse">
                            @if (!permGroups.Any())
                            {
                                <div class="text-muted small p-2">لا توجد صلاحيات</div>
                            }
                            else
                            {
                                foreach (var group in permGroups)
                                {
                                    <div class="mb-2">
                                        <div class="d-flex align-items-center gap-1">
                                            <input type="checkbox" class="form-check-input chk-all-create" data-group="@group.GroupID" style="cursor:pointer">
                                            <span class="fw-semibold small">@group.GroupName</span>
                                        </div>
                                        <div class="row g-1 ps-3">
                                            @foreach (var perm in group.Permissions)
                                            {
                                                <div class="col-md-6">
                                                    <div class="form-check">
                                                        <input type="checkbox" class="form-check-input perm-check-create" name="SelectedPermissionIds" value="@perm.PermissionID" data-group="@group.GroupID" id="cp_@perm.PermissionID">
                                                        <label class="form-check-label small" for="cp_@perm.PermissionID">@perm.DisplayName</label>
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                }
                            }
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إلغاء</button>
                    <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>إنشاء الحساب</button>
                </div>
            </form>
        </div>
    </div>
</div>
