                            <span class="fw-semibold d-block">إدارة المباني</span>
                            <small class="text-muted">إضافة وتعديل المباني</small>
                        </div>
                    </a>
                   @*  <a asp-action="BuildingLayout" class="list-group-item list-group-item-action d-flex align-items-center gap-3 py-3">
                        <i class="bi bi-map fs-4" style="color:#6f42c1"></i>
                        <div><span class="fw-semibold d-block">الكروكي التفاعلي</span><small class="text-muted">عرض المباني والغرف</small></div> *@

<a asp-action="Buildings" class="list-group-item list-group-item-action d-flex align-items-center gap-3">           
    <i class="bi bi-map fs-4 text-danger"></i>
                        <span>الكروكي التفاعلي للمباني</span>

                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Latest Applications -->
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white border-bottom d-flex align-items-center justify-content-between">
                <div>
                    <i class="bi bi-clock-history text-primary me-2"></i>
                    <h5 class="mb-0 d-inline">آخر الطلبات</h5>
                </div>
                <a asp-action="AllApplications" class="btn btn-sm btn-outline-primary">عرض الكل</a>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>الطالب</th>
                                <th>الحالة</th>
                                <th>التاريخ</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.LatestApplications.Any())
                            {
                                foreach (var app in Model.LatestApplications)
                                {
                                    <tr>
                                        <td class="fw-semibold small">@app.StudentName</td>
                                        <td>
                                            <span class="badge bg-@(app.Status switch { "Pending" => "secondary", "UnderReview" => "primary", "Accepted" => "success", "Rejected" => "danger", "Allocated" => "dark", _ => "light" })">
                                                @(app.Status switch { "Pending" => "معلق", "UnderReview" => "قيد المراجعة", "Accepted" => "مقبول", "Rejected" => "مرفوض", "Allocated" => "تم التسكين", _ => app.Status })
                                            </span>
                                        </td>
                                        <td class="small text-muted">@app.CreatedAt.ToString("yyyy-MM-dd")</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr><td colspan="3" class="text-center py-3 text-muted small">لا توجد طلبات حديثة</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Recent Audit Activity -->
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white border-bottom d-flex align-items-center justify-content-between">
                <div>
                    <i class="bi bi-shield-check text-success me-2"></i>
                    <h5 class="mb-0 d-inline">آخر النشاطات</h5>
                </div>
                <a asp-action="AuditLog" class="btn btn-sm btn-outline-success">عرض الكل</a>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>المستخدم</th>
                                <th>الإجراء</th>
                                <th>الوقت</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.RecentAuditLogs.Any())
                            {
                                foreach (var log in Model.RecentAuditLogs)
                                {
                                    <tr>
                                        <td class="small fw-semibold">@log.UserDisplayName</td>
                                        <td>
                                            <span class="badge bg-@(log.ActionCategory)">
                                                @log.ActionDisplay
                                            </span>
                                        </td>
                                        <td class="small text-muted">@log.CreatedAt.ToString("HH:mm")</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr><td colspan="3" class="text-center py-3 text-muted small">لا توجد نشاطات حديثة</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
