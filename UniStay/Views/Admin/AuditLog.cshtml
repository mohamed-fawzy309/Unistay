@model List<UniStay.ViewModels.Permissions.AuditLogRowViewModel>
@{
    ViewData["Title"] = "سجل النشاطات";
    var page = ViewBag.Page as int? ?? 1;
    var totalPages = ViewBag.TotalPages as int? ?? 1;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="page-title">سجل النشاطات</h2>
    <span class="text-muted">إجمالي السجلات: @ViewBag.TotalCount</span>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show animate-fade-in">@TempData["Success"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show animate-fade-in">@TempData["Error"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
}

<div class="table-responsive">
    <table class="table table-hover table-bordered bg-white animate-fade-in">
        <thead class="table-light">
            <tr>
                <th>#</th>
                <th>المستخدم</th>
                <th>الإجراء</th>
                <th>الجدول</th>
                <th>رقم السجل</th>
                <th>القيم القديمة</th>
                <th>القيم الجديدة</th>
                <th>IP</th>
                <th>التاريخ</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Any())
            {
                int i = (page - 1) * 50 + 1;
                foreach (var item in Model)
                {
                    <tr>
                        <td>@(i++)</td>
                        <td>@item.UserDisplayName <small class="text-muted">(@item.UserType)</small></td>
                        <td><span class="badge bg-@item.ActionCategory">@item.ActionDisplay</span></td>
                        <td><code>@item.TableName</code></td>
                        <td>@item.RecordID</td>
                        <td style="max-width:200px;word-break:break-all;font-size:0.85rem">
                            @if (!string.IsNullOrEmpty(item.OldValues))
                            {
                                <pre class="mb-0"><code>@item.OldValues</code></pre>
                            }
                        </td>
                        <td style="max-width:200px;word-break:break-all;font-size:0.85rem">
                            @if (!string.IsNullOrEmpty(item.NewValues))
                            {
                                <pre class="mb-0"><code>@item.NewValues</code></pre>
                            }
                        </td>
                        <td><small>@item.IPAddress</small></td>
                        <td><small>@item.CreatedAt.ToString("yyyy-MM-dd HH:mm")</small></td>
                    </tr>
                }
            }
            else
            {
                <tr><td colspan="9" class="text-center py-4 text-muted">لا توجد نشاطات بعد</td></tr>
            }
        </tbody>
    </table>
</div>

@if (totalPages > 1)
{
    <nav>
        <ul class="pagination justify-content-center">
            <li class="page-item @(page <= 1 ? "disabled" : "")">
                <a class="page-link" asp-action="AuditLog" asp-route-page="@(page - 1)">السابق</a>
            </li>
            @for (int p = 1; p <= totalPages; p++)
            {
                <li class="page-item @(p == page ? "active" : "")">
                    <a class="page-link" asp-action="AuditLog" asp-route-page="@p">@p</a>
                </li>
            }
            <li class="page-item @(page >= totalPages ? "disabled" : "")">
                <a class="page-link" asp-action="AuditLog" asp-route-page="@(page + 1)">التالي</a>
            </li>
        </ul>
    </nav>
}
