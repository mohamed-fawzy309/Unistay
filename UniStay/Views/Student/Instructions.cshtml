@model List<UniStay.Models.HousingInstruction>
@{
    ViewData["Title"] = "إرشادات وإقرارات";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="mb-0"><i class="bi bi-info-circle text-success me-2"></i> إرشادات وإقرارات السكن</h3>
</div>

@if (Model == null || !Model.Any())
{
    <div class="alert alert-info">
        <i class="bi bi-info-circle me-2"></i>
        لا توجد إرشادات متاحة حالياً.
    </div>
}
else
{
    <div class="accordion" id="instructionsAccordion">
        @for (int i = 0; i < Model.Count; i++)
        {
            var item = Model[i];
            var collapseId = $"collapse{i}";
            var headingId = $"heading{i}";

            var iconClass = item.InstructionType switch
            {
                "Rules"       => "bi-shield-check text-danger",
                "Financial"   => "bi-cash-stack text-success",
                "Medical"     => "bi-heart-pulse text-danger",
                "Documents"   => "bi-file-earmark-text text-primary",
                "General"     => "bi-info-circle text-info",
                _             => "bi-bookmark text-secondary"
            };

            <div class="accordion-item mb-3 border shadow-sm rounded">
                <h2 class="accordion-header" id="@headingId">
                    <button class="accordion-button @(i == 0 ? "" : "collapsed") fw-bold"
                            type="button"
                            data-bs-toggle="collapse"
                            data-bs-target="#@collapseId"
                            aria-expanded="@(i == 0 ? "true" : "false")"
                            aria-controls="@collapseId">
                        <i class="bi @iconClass me-2 fs-5"></i>
                        @item.Title
                    </button>
                </h2>
                <div id="@collapseId"
                     class="accordion-collapse collapse @(i == 0 ? "show" : "")"
                     aria-labelledby="@headingId"
                     data-bs-parent="#instructionsAccordion">
                    <div class="accordion-body">
                        <p class="text-muted" style="white-space: pre-line;">@item.Content</p>

                        @if (item.HousingInstructionAttachments != null && item.HousingInstructionAttachments.Any())
                        {
                            <hr />
                            <h6 class="fw-bold"><i class="bi bi-paperclip me-1"></i> المرفقات:</h6>
                            <ul class="list-group list-group-flush">
                                @foreach (var att in item.HousingInstructionAttachments.Where(a => a.IsActive == true))
                                {
                                    <li class="list-group-item px-0">
                                        <a href="@att.FilePath" target="_blank" class="text-decoration-none">
                                            <i class="bi bi-file-earmark-arrow-down text-success me-2"></i>
                                            @att.FileName
                                        </a>
                                    </li>
                                }
                            </ul>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}
