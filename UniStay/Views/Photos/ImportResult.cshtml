@model BulkImportResultViewModel
@{
    ViewData["Title"] = "نتيجة الاستيراد";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h5 class="page-title mb-0"><i class="bi bi-clipboard-data"></i> @ViewData["Title"]</h5>
    <a class="btn btn-outline-secondary btn-sm" asp-action="Index"><i class="bi bi-arrow-right"></i> العودة</a>
</div>

<div class="row g-2 mb-3">
    <div class="col-md-3">
        <div class="card bg-primary text-white p-2 text-center">
            <h6>إجمالي الملفات</h6>
            <h4>@Model.TotalInZip</h4>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card bg-success text-white p-2 text-center">
            <h6>تم الاستيراد</h6>
            <h4>@Model.ImportedCount</h4>
        </div>
    </div>
    <div class="col-md-2">
        <div class="card bg-warning text-dark p-2 text-center">
            <h6>مكرر</h6>
            <h4>@Model.DuplicateCount</h4>
        </div>
    </div>
    <div class="col-md-2">
        <div class="card bg-danger text-white p-2 text-center">
            <h6>فشل</h6>
            <h4>@Model.FailedCount</h4>
        </div>
    </div>
    <div class="col-md-2">
        <div class="card bg-secondary text-white p-2 text-center">
            <h6>غير موجود</h6>
            <h4>@Model.MissingCount</h4>
        </div>
    </div>
</div>

<div class="table-responsive">
    <table class="table table-hover table-bordered small">
        <thead class="table-dark">
            <tr>
                <th>اسم الملف</th>
                <th>الطالب المطابق</th>
                <th>الرقم القومي</th>
                <th>الحالة</th>
                <th>ملاحظات</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var d in Model.Details)
            {
                <tr>
                    <td>@d.FileName</td>
                    <td>@d.MatchedStudent</td>
                    <td>@d.MatchedNationalID</td>
                    <td>
                        @switch (d.Status)
                        {
                            case "imported": <span class="badge bg-success">تم الاستيراد</span> break;
                            case "duplicate": <span class="badge bg-warning text-dark">مكرر</span> break;
                            case "missing": <span class="badge bg-secondary">غير موجود</span> break;
                            case "failed": <span class="badge bg-danger">فشل</span> break;
                        }
                    </td>
                    <td>@d.ErrorMessage</td>
                </tr>
            }
        </tbody>
    </table>
</div>
