@model CustomReportViewModel
@using UniStay.ViewModels.Statistics
@{
    ViewData["Title"] = "منشئ التقارير المخصصة";
    var allTypes = ReportTypeInfo.Types;
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-file-earmark-bar-graph"></i> منشئ التقارير المخصصة</h2>
    </div>

    <div class="row">
        <!-- Filters Panel -->
        <div class="col-lg-3 mb-4">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h6 class="mb-0"><i class="bi bi-sliders"></i> خيارات التقرير</h6>
                </div>
                <div class="card-body">
                    <form method="get" asp-action="CustomReport">
                        <div class="mb-3">
                            <label class="form-label small">نوع التقرير</label>
                            <select name="reportType" class="form-select" onchange="this.form.submit()">
                                @foreach (var t in allTypes)
                                {
                                    <option value="@t.Key" selected="@(Model.ReportType == t.Key)">
                                        @t.Value.DisplayName
                                    </option>
                                }
                            </select>
                        </div>

                        @if (allTypes.TryGetValue(Model.ReportType, out var def))
                        {
                            <div class="mb-3">
                                <label class="form-label small">الأعمدة المطلوبة</label>
                                <div class="border rounded p-2" style="max-height:250px;overflow-y:auto">
                                    @foreach (var col in def.AvailableColumns)
                                    {
                                        var isChecked = !Model.HasRun || Model.Columns.Contains(col.Key);
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox" name="selectedColumns" value="@col.Key" checked="@isChecked" id="col_@col.Key">
                                            <label class="form-check-label small" for="col_@col.Key">@col.Value</label>
                                        </div>
                                    }
                                </div>
                            </div>
                        }

                        <hr>
                        <h6 class="small fw-bold">التصفية</h6>

                        @if (Model.Cities.Any())
                        {
                            <div class="mb-2">
                                <label class="form-label small">المدينة</label>
                                <select name="filterCityId" class="form-select form-select-sm">
                                    <option value="">الكل</option>
                                    @foreach (var c in Model.Cities)
                                    {
                                        <option value="@c.ID" selected="@(Model.FilterCityId == c.ID)">@c.Name</option>
                                    }
                                </select>
                            </div>
                        }

                        @if (Model.AcademicYears.Any())
                        {
                            <div class="mb-2">
                                <label class="form-label small">العام الدراسي</label>
                                <select name="filterAcademicYear" class="form-select form-select-sm">
                                    <option value="">الكل</option>
                                    @foreach (var y in Model.AcademicYears)
                                    {
                                        <option value="@y" selected="@(Model.FilterAcademicYear == y)">@y</option>
                                    }
                                </select>
                            </div>
                        }

                        @if (Model.Faculties.Any())
                        {
                            <div class="mb-2">
                                <label class="form-label small">الكلية</label>
                                <select name="filterFaculty" class="form-select form-select-sm">
                                    <option value="">الكل</option>
                                    @foreach (var f in Model.Faculties)
                                    {
                                        <option value="@f" selected="@(Model.FilterFaculty == f)">@f</option>
                                    }
                                </select>
                            </div>
                        }

                        @if (Model.Governorates.Any())
                        {
                            <div class="mb-2">
                                <label class="form-label small">المحافظة</label>
                                <select name="filterGovernorate" class="form-select form-select-sm">
                                    <option value="">الكل</option>
                                    @foreach (var g in Model.Governorates)
                                    {
                                        <option value="@g" selected="@(Model.FilterGovernorate == g)">@g</option>
                                    }
                                </select>
                            </div>
                        }

                        <div class="mb-2">
                            <label class="form-label small">من تاريخ</label>
                            <input type="date" name="filterFromDate" class="form-control form-control-sm" value="@Model.FilterFromDate?.ToString("yyyy-MM-dd")">
                        </div>

                        <div class="mb-2">
                            <label class="form-label small">إلى تاريخ</label>
                            <input type="date" name="filterToDate" class="form-control form-control-sm" value="@Model.FilterToDate?.ToString("yyyy-MM-dd")">
                        </div>

                        <div class="mb-3">
                            <label class="form-label small">بحث</label>
                            <input type="text" name="searchTerm" class="form-control form-control-sm" placeholder="اسم أو كود..." value="@Model.SearchTerm">
                        </div>

                        <button type="submit" class="btn btn-primary w-100">
                            <i class="bi bi-search"></i> عرض التقرير
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <!-- Results Panel -->
        <div class="col-lg-9">
            @if (Model.HasRun)
            {
                <div class="card shadow-sm">
                    <div class="card-header bg-white d-flex justify-content-between align-items-center">
                        <h6 class="mb-0">
                            <i class="bi bi-table"></i> نتائج التقرير
                            <span class="badge bg-secondary ms-2">@Model.TotalCount.ToString("N0") سجل</span>
                        </h6>
                        <button class="btn btn-sm btn-outline-success" onclick="exportCSV()">
                            <i class="bi bi-download"></i> تصدير CSV
                        </button>
                    </div>
                    <div class="card-body p-0" style="overflow-x:auto">
                        <table class="table table-bordered table-striped table-hover mb-0" id="reportTable">
                            <thead class="table-dark">
                                <tr>
                                    <th>#</th>
                                    @foreach (var col in Model.Columns)
                                    {
                                        var displayName = allTypes.GetValueOrDefault(Model.ReportType)?.AvailableColumns.GetValueOrDefault(col) ?? col;
                                        <th>@displayName</th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @{
                                    int idx = 1;
                                    foreach (var row in Model.Rows)
                                    {
                                        <tr>
                                            <td>@(idx++)</td>
                                            @foreach (var col in Model.Columns)
                                            {
                                                <td>@(row.GetValueOrDefault(col) ?? "")</td>
                                            }
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
            else
            {
                <div class="card shadow-sm">
                    <div class="card-body text-center py-5">
                        <i class="bi bi-file-earmark-text display-1 text-muted"></i>
                        <h5 class="mt-3 text-muted">اختر نوع التقرير والأعمدة المطلوبة</h5>
                        <p class="text-muted small">استخدم لوحة الخيارات على اليسار لبناء تقرير مخصص</p>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function exportCSV() {
            const table = document.getElementById('reportTable');
            if (!table) return;
            let csv = [];
            const rows = table.querySelectorAll('tr');
            for (const row of rows) {
                const cells = row.querySelectorAll('th, td');
                const vals = Array.from(cells).map(c => '"' + c.textContent.trim().replace(/"/g, '""') + '"');
                csv.push(vals.join(','));
            }
            const blob = new Blob([csv.join('\n')], { type: 'text/csv;charset=utf-8;' });
            const link = document.createElement('a');
            link.href = URL.createObjectURL(blob);
            link.download = 'تقرير_@(Model.ReportType)_@(DateTime.Now.ToString("yyyyMMdd")).csv';
            link.click();
        }
    </script>
}
