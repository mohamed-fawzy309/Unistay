@using UniStay.ViewModels.Applications
@model OnlineReviewIndexViewModel
@{ ViewData["Title"] = "مراجعة طلبات الإنترنت"; }

<div class="card shadow-sm border-0 mb-4">
    <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
        <h5 class="mb-0"><i class="bi bi-check2-square"></i> مراجعة طلبات الإنترنت</h5>
        <a asp-action="ExportExcel" class="btn btn-sm btn-light"><i class="bi bi-file-earmark-excel"></i> تصدير</a>
    </div>
    <div class="card-body">
        <div class="row g-2 mb-3">
            <div class="col-md-3 col-6"><div class="border rounded p-2 text-center bg-light"><small class="text-muted d-block">بانتظار المراجعة</small><strong class="fs-5 text-warning">@Model.PendingReview</strong></div></div>
        </div>

        <form method="get" class="row g-2 mb-3">
            <div class="col-md-4"><input type="text" name="Search" class="form-control" placeholder="بحث بالاسم أو الرقم القومي" value="@Model.Filter.Search" /></div>
            <div class="col-md-1"><button class="btn btn-primary w-100"><i class="bi bi-search"></i></button></div>
            <div class="col-md-2"><a asp-action="Index" class="btn btn-outline-secondary w-100">إعادة تعيين</a></div>
        </form>

        <div class="table-responsive">
            <table class="table table-hover table-bordered align-middle">
                <thead class="table-dark">
                    <tr><th>#</th><th>الاسم</th><th>الرقم القومي</th><th>الكلية</th><th>الحالة</th><th>تاريخ التقديم</th><th>إجراءات</th></tr>
                </thead>
                <tbody>
                    @if (!Model.Applications.Any()) { <tr><td colspan="7" class="text-center text-muted py-4">لا توجد طلبات</td></tr> }
                    @foreach (var app in Model.Applications)
                    {
                        <tr>
                            <td>@app.ApplicationID</td>
                            <td class="fw-bold">@app.StudentName</td>
                            <td>@app.NationalID</td>
                            <td>@app.Faculty</td>
                            <td>@app.Status</td>
                            <td>@app.SubmittedAt?.ToString("yyyy/MM/dd")</td>
                            <td><a asp-action="Review" asp-route-id="@app.ApplicationID" class="btn btn-sm btn-primary"><i class="bi bi-eye"></i> مراجعة</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (Model.TotalPages > 1)
        {
            <nav><ul class="pagination justify-content-center">
                @{
                    var qs = new Dictionary<string, string?>
                    {
                        {"Search", Model.Filter.Search}
                    };
                }
                @for (int p = 1; p <= Model.TotalPages; p++)
                {
                    <li class="page-item @(p == Model.Page ? "active" : "")">
                        <a class="page-link" asp-all-route-data="@(new Dictionary<string, string>(qs.Where(kv => kv.Value != null).ToDictionary(kv => kv.Key, kv => kv.Value!)) { ["page"] = p.ToString() })">@p</a>
                    </li>
                }
            </ul></nav>
        }
    </div>
</div>
