@model ManualAllocationViewModel
@{
    ViewData["Title"] = "تسكين يدوي";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-person-plus-fill"></i> تسكين يدوي</h2>
        <a asp-action="Index" class="btn btn-secondary"><i class="bi bi-arrow-right"></i> العودة</a>
    </div>

    <div class="card">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">بيانات التسكين</h5>
        </div>
        <div class="card-body">
            <form asp-action="ManualAllocation" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

               <div class="col-md-6">

    <label class="form-label">بحث الطالب</label>

    <input type="text"
           id="studentSearch"
           class="form-control mb-2"
           placeholder="بحث بالاسم أو الرقم القومي..." />

    <select asp-for="StudentID"
            id="studentSelect"
            class="form-select"
            required>

        <option value="">-- اختر الطالب --</option>

        @foreach (var s in (IEnumerable<UniStay.ViewModels.Allocation.StudentLookupViewModel>)ViewBag.Students)
        {
            <option value="@s.ID">
                @s.FullName - @s.NationalID
            </option>
        }

    </select>

    <span asp-validation-for="StudentID" class="text-danger"></span>

</div>

                <div class="row mb-3">
                    <div class="col-md-4">
                        <label class="form-label">المدينة</label>
                        <select id="citySelect" class="form-select" onchange="loadBuildings(this.value)">
                            <option value="">-- اختر المدينة --</option>
                            @foreach (var c in (IEnumerable<UniStay.ViewModels.Allocation.CityLookupViewModel>)ViewBag.Cities)
                            {
                                <option value="@c.ID">@c.Name</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">المبنى</label>
                        <select id="buildingSelect" class="form-select" onchange="loadRooms(this.value)">
                            <option value="">-- اختر المبنى أولاً --</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">الغرفة</label>
                        <select asp-for="CityRoomID" id="roomSelect" class="form-select" required>
                            <option value="">-- اختر المبنى أولاً --</option>
                        </select>
                        <span asp-validation-for="CityRoomID" class="text-danger"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label">ملاحظات</label>
                    <textarea asp-for="Notes" class="form-control" rows="2"></textarea>
                </div>

                <button type="submit" class="btn btn-primary"><i class="bi bi-check-circle"></i> تسكين</button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function loadBuildings(cityId) {
            if (!cityId) return;
            fetch('@Url.Action("GetBuildingsByCity", "Allocation")?cityId=' + cityId)
                .then(function (r) { return r.json(); })
                .then(function (data) {
                    var sel = document.getElementById('buildingSelect');
                    sel.innerHTML = '<option value="">-- اختر المبنى --</option>';
                    data.forEach(function (b) {
                        var opt = document.createElement('option');
                        opt.value = b.id;
                        opt.textContent = b.buildingName;
                        sel.appendChild(opt);
                    });
                    var rs = document.getElementById('roomSelect');
                    rs.innerHTML = '<option value="">-- اختر المبنى أولاً --</option>';
                });
        }
        function loadRooms(buildingId) {
            if (!buildingId) return;
            fetch('@Url.Action("GetRoomsByBuilding", "Allocation")?buildingId=' + buildingId)
                .then(function (r) { return r.json(); })
                .then(function (data) {
                    var sel = document.getElementById('roomSelect');
                    sel.innerHTML = '<option value="">-- اختر الغرفة --</option>';
                    var hasRooms = false;
                    data.forEach(function (r) {
                        if (r.available > 0) {
                            hasRooms = true;
                            var opt = document.createElement('option');
                            opt.value = r.id;
                            opt.textContent = 'غرفة ' + r.roomNumber + ' - دور ' + r.floorNumber + ' (المتاح: ' + r.available + ' من ' + r.bedsCount + ')';
                            sel.appendChild(opt);
                        }
                    });
                    if (!hasRooms) {
                        var opt = document.createElement('option');
                        opt.value = '';
                        opt.disabled = true;
                        opt.textContent = 'لا توجد غرف متاحة';
                        sel.appendChild(opt);
                    }
                });
        }
    </script>
<script>

document.getElementById('studentSearch')
.addEventListener('keyup', function () {

    let filter = this.value.toLowerCase();

    let select = document.getElementById('studentSelect');

    let options = select.options;

    for (let i = 0; i < options.length; i++) {

        let txt = options[i].text.toLowerCase();

        if (txt.includes(filter)) {
            options[i].style.display = '';
        }
        else {
            options[i].style.display = 'none';
        }
    }
});

</script>
}
